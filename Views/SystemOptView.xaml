<UserControl x:Class="AgyToolbox.Views.SystemOptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="{DynamicResource BrushAlertBlueBg}" BorderBrush="{DynamicResource BrushAlertBlueBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="⚙️ 步骤二：系统优化与必要设置 (Optimization &amp; Settings)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAlertBlueText}" Margin="0,0,0,4"/>
                <TextBlock Text="系统性能调优与环境准备：提供 Windows Update 更新策略控制、BitLocker 恢复密钥检测与备份、系统休眠文件管理、局域网专用网络配置，以及文件扩展名显示和 PATH 环境变量可视化管理。"
                           FontSize="12" Foreground="{DynamicResource BrushAlertBlueText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 4 个功能横向子标签 -->
        <TabControl Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 更新与安全 (Windows 更新策略 + BitLocker 备份) -->
            <TabItem Header="🛡️ 更新与安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 板块 1: Windows 自动更新策略控制 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛑 1. Windows 自动更新策略与服务控制" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (配置组策略禁止自动下载、排除驱动更新、管理更新核心服务)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock x:Name="TxtUpdateStatus" Text="[检测更新状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshUpdateStatus_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushAlertYellowBg}" BorderBrush="{DynamicResource BrushAlertYellowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 技术说明：配置 ExcludeWPDriversInQualityUpdate 策略避免硬件驱动在质量更新中被自动替换，并管理更新服务 (wuauserv) 与系统维护任务 (WaaSMedicSvc)。" FontSize="11" Foreground="{DynamicResource BrushAlertYellowText}" TextWrapping="Wrap"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="🛑 关闭 Windows 自动更新" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                            <TextBlock Text="通过组策略禁用自动下载，排除驱动更新，并停用更新核心服务。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Button x:Name="BtnDisableUpdate" Content="关闭自动更新" Background="#EF4444" Click="BtnDisableUpdate_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🟢 恢复官方默认更新机制" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                            <TextBlock Text="清除组策略更新限制规则，重新激活系统更新服务，恢复正常接收安全补丁。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Button x:Name="BtnEnableUpdate" Content="恢复官方自动更新" Style="{DynamicResource SecondaryButton}" Click="BtnEnableUpdate_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 板块 2: Windows 更新行为精细控制 (防工作中断 & 禁用 P2P 偷跑) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 2. 更新行为微调：防工作中断自动重启 &amp; P2P 上传阻断" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (本地组策略配置，彻底解决夜间挂机被擅自重启与后台跑流量问题)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 刷新微调状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshUpdateTuning_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 防工作中断自动重启 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="有用户登录时禁止自动重启 (NoAutoRebootWithLoggedOnUsers)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtNoAutoRebootStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="补丁安装完成后，只要当前仍有用户登录，绝不擅自重启系统，保障编译任务、大型下载及未保存工作台安全。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleNoAutoReboot" Grid.Column="1" Content="切换策略" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleNoAutoReboot_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 传递优化 P2P 上传禁用 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="彻底禁用传递优化 P2P 上传分享 (DODownloadMode = 0)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtDeliveryOptStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="组策略锁定仅从 HTTP 服务器下载，彻底禁止系统在后台向局域网或互联网其他 PC 上传补丁，节省上行带宽并防止网络延迟抖动。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleDeliveryOpt" Grid.Column="1" Content="切换策略" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleDeliveryOpt_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 3: BitLocker 状态检测与恢复密钥备份 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🔐 3. BitLocker 设备加密状态检测与恢复密钥备份" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (重要安全提示：主板固件更新或 TPM 重置时需验证 48 位数字恢复密钥)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock x:Name="TxtBitLockerStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBitLocker_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 为什么建议提前备份 BitLocker 恢复密钥？" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="许多预装 Windows 11 的笔记本在初始激活后会自动开启设备加密。在后续主板 BIOS 固件更新、清除 TPM 或硬件变更后，系统启动时可能需要输入 48 位恢复密钥以解锁驱动器。提前备份密钥可避免身份验证凭据丢失导致系统分区无法读取。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="导出当前 C 盘 BitLocker 48 位数字恢复密钥" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="调用系统 manage-bde 命令查询本机驱动器保护密钥，建议妥善保存至离线安全介质。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🔑 查询并备份恢复密钥" Background="#0284C7" VerticalAlignment="Center" Click="BtnGetBitLockerKey_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 电源与存储 (休眠三档 + 保留存储 + 专用网络 + 卓越性能) -->
            <TabItem Header="⚡ 电源与存储">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 板块 1: 休眠三档精细化控制 & 快速启动 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="💾 1. 管理休眠文件 (C:\hiberfil.sys) 与快速启动" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtHiberStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshHiber_Click"/>
                                </Grid>

                                <TextBlock Text="休眠文件默认在 C 盘根目录占用与物理内存相当的空间 (16GB~64GB+)。提供三档可逆模式自由选择：" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- 三档模式选择器 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="休眠档位选择 (按需释放 16GB~64GB+ SSD 空间)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="彻底关闭释放 100% 空间；Reduced 极简档仅保留快速启动支持并缩减 50%~80% 体积；Full 为官方默认全量休眠。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🔴 彻底关闭 (省100%空间)" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" Click="BtnHiberOff_Click"/>
                                                    <Button Content="🟡 Reduced 极简模式" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" FontSize="11" Click="BtnHiberReduced_Click"/>
                                                    <Button Content="🟢 Full 全量模式" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Click="BtnHiberFull_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 快速启动单独控制 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="快速启动 (Fast Startup / HiberbootEnabled)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtFastStartupStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="关闭快速启动可使系统在关机时彻底切断电源，解决 Windows+Linux 双系统磁盘冲突及部分主板风扇常转问题。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleFastStartup" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleFastStartup_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 2: 系统保留的存储 (Reserved Storage ~7GB) 查询与释放 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📦 2. 系统“保留的存储 (Reserved Storage)”状态与空间释放 (~7GB)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtReservedStorageStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 查询状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshReservedStorage_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="释放约 7GB 系统预留缓冲空间 (fsutil storagereserve)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Windows 10/11 默认会永久占位保留约 7GB 磁盘供更新使用。通过原生 fsutil 禁用保留存储，系统在完成下一次日常维护或更新后即可释放这部分 C 盘空间。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleReservedStorage" Grid.Column="1" Content="切换保留存储" Style="{DynamicResource SecondaryButton}" Padding="10,4" VerticalAlignment="Center" Click="BtnToggleReservedStorage_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 3: 存储感知与临时文件自动清理 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🧹 3. 存储感知与临时文件自动清理 (Storage Sense)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtStorageSenseStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshStorageSense_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="自动释放磁盘空间策略 (StoragePolicy: 01)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="在驱动器空间不足时，自动清理无用的临时系统缓存、过期的回收站文件与旧下载，维持系统分区健康。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleStorageSense" Grid.Column="1" Content="切换存储感知" Style="{DynamicResource SecondaryButton}" Padding="10,4" VerticalAlignment="Center" Click="BtnToggleStorageSense_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 4: 网络与卓越性能 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：专用网络切换 -->
                            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="🌐 4. 切换当前网络为【专用网络】" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock Text="新网络默认常被识别为公用网络导致端口与 Ping 阻断。设为“专用网络”可放行局域网调试与设备互访。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="📶 设为专用网络" Background="#10B981" HorizontalAlignment="Left" Click="BtnSetPrivateNetwork_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 右侧：卓越性能模式 -->
                            <Border Grid.Column="1" Background="{DynamicResource BrushAlertPurpleBg}" BorderBrush="{DynamicResource BrushAlertPurpleBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="⚡ 4. 导入并激活【卓越性能】方案" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAlertPurpleText}" Margin="0,0,0,6"/>
                                    <TextBlock Text="解锁隐藏的卓越性能电源策略，减少硬件能耗调度延迟，保持满负荷响应。" FontSize="11" Foreground="{DynamicResource BrushAlertPurpleText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button Content="⚡ 激活卓越性能" Background="#4F46E5" HorizontalAlignment="Left" Click="BtnEnableUltimatePerf_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 体验开关与注册表调优 (文件查看 + 快捷设置 + 注册表去魅) -->
            <TabItem Header="⚙️ 体验开关与注册表调优">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 资源管理器基础设置 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📁 1. 资源管理器文件查看与导航偏好" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (开发必备：显式后缀名、显示隐藏目录、显示系统保护文件、Win+E 默认打开此电脑)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshExplorerSettings_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkShowFileExt" Content="始终显示文件扩展名" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Click="ChkShowFileExt_Click"/>
                                            <TextBlock Text="显示完整后缀名，识别脚本与配置，避免双后缀文件欺骗。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2,0,2,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkShowHiddenFiles" Content="显示隐藏文件与驱动器" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Click="ChkShowHiddenFiles_Click"/>
                                            <TextBlock Text="查看编辑 .git, .env, .vscode, AppData 等开发配置与目录。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2,0,2,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkShowSuperHidden" Content="显示受保护系统文件" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Click="ChkShowSuperHidden_Click"/>
                                            <TextBlock Text="显示 desktop.ini、bootmgr 等系统核心受保护隐藏文件。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkOpenThisPc" Content="Win+E 打开【此电脑】" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Click="ChkOpenThisPc_Click"/>
                                            <TextBlock Text="启动资源管理器时直接展示驱动器分区，而非快速访问推荐。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 系统交互体验与功能开关 (紧凑设置列表) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🎛️ 2. 系统交互体验与功能开关 (纯注册表调优，随时可逆)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="纯注册表标准策略项调优，透明且随时可逆，点击右侧按钮即可快速切换状态：" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- Win10 经典右键菜单 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📄 Win10 经典完整右键菜单" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtClassicMenuStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="恢复传统右键菜单展示全部选项，避免 Win11 默认'显示更多选项'二级折叠。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleClassicMenu" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleClassicMenu_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 桌面必备核心图标展示 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🖥️ 桌面必备核心图标一键展示 (此电脑 / 控制面板 / 用户文件 / 网络)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtDesktopIconsStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="新机开荒必备：在桌面直接显示【此电脑】、【控制面板】、【用户文件】与【网络】，无需繁琐的主题设置。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleDesktopIcons" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleDesktopIcons_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 关闭必英网络搜索 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔍 关闭开始菜单必应联机 Web 搜索" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtBingStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="禁用任务栏搜索向远程联网检索，专注于本地应用与文档的高速索引。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleBing" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleBing_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 禁用遥测 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🛡️ 限制系统可选诊断数据与个性化推荐" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtTelemetryStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="关闭可选遥测数据上报与基于使用习惯的系统界面推广建议。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleTelemetry" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleTelemetry_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 禁用按 5 次 Shift 粘滞键弹窗 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⌨️ 禁用连续按 5 次 Shift 弹出粘滞键提示" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtStickyStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="关闭连续多次按 Shift 键时触发辅助功能粘滞键确认窗口的快捷方式。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleSticky" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleSticky_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 开启 Win+V 剪贴板历史记录 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📋 开启 Win+V 系统原生剪贴板历史记录" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtClipboardStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="支持暂存多条复制文本与图片，按下 Win+V 可随时查看历史并直接粘贴。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleClipboard" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleClipboard_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 开启开发者模式与长路径 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💻 开启开发者模式 &amp; 解除 260 字符长路径限制" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtDevModeStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="支持免提权创建符号链接，并开启 LongPathsEnabled 解决项目路径超长报错。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleDevMode" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleDevMode_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- UAC 安全桌面弹窗控制 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🛡️ UAC 提权安全桌面暗屏 (PromptOnSecureDesktop)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtUacDesktopStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="开启时弹窗全屏变暗锁定（防UI伪造）；关闭后在普通桌面弹出，解决部分显卡黑屏卡顿或远程桌面闪退。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleUacDesktop" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleUacDesktop_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 任务栏搜索栏显示模式 -->
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔍 任务栏搜索展示形态 (SearchboxTaskbarMode)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtSearchboxModeStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="自由切换任务栏搜索形态：完全隐藏以释放任务栏空间、仅显示紧凑放大镜图标、或展开完整搜索框。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="隐藏" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnSearchModeHide_Click"/>
                                                    <Button Content="仅图标" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnSearchModeIcon_Click"/>
                                                    <Button Content="搜索框" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="11" Click="BtnSearchModeBox_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 重启资源管理器 -->
                                        <Border Padding="12,8" Background="{DynamicResource BrushCardBgAlt}" CornerRadius="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="🔄 平滑重启 Windows 资源管理器 (explorer.exe)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="修改上述右键菜单或任务栏策略后，点击立即刷新桌面与任务栏，使新配置即刻生效。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="重启 Explorer" Background="#0284C7" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnRestartExplorer_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: PATH 环境变量管理 -->
            <TabItem Header="🔤 PATH 环境变量">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部标题与作用域选择 -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="🛠️ PATH 环境变量列表与失效路径检测" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                <TextBlock Text=" (支持调整前后优先级、高亮幽灵死路径、快速清理无效条目)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <RadioButton x:Name="RbUserPath" Content="当前用户 (User)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="RbPathScope_Checked"/>
                                <RadioButton x:Name="RbSysPath" Content="系统全局 (System)" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RbPathScope_Checked"/>
                                <Button Content="⚡ 重新扫描" Style="{DynamicResource SecondaryButton}" Click="BtnReloadPath_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 操作工具条 -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="🗑️ 清除所有失效路径" Background="#EF4444" Margin="0,0,8,4" Click="BtnRemoveDeadPaths_Click"/>
                        <Button Content="⬆️ 上移" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathUp_Click"/>
                        <Button Content="⬇️ 下移" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathDown_Click"/>
                        <Button Content="➕ 新增路径" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnAddPath_Click"/>
                        <Button Content="❌ 删除选中项" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnDeleteSelectedPath_Click"/>
                        <Button Content="💾 保存并广播变更" Background="#10B981" Margin="0,0,0,4" Click="BtnSavePath_Click"/>
                    </WrapPanel>

                    <!-- DataGrid 表格 -->
                    <DataGrid Grid.Row="2" x:Name="GridPathEntries" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260"
                              Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushTableBorder}" RowHeight="32" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物理路径 (Path)" Binding="{Binding Path}" Width="*"/>
                            <DataGridTemplateColumn Header="状态检测" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExistsText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 5: 原生开发 CPU 与磁盘 I/O 调优 -->
            <TabItem Header="⚡ 原生开发 CPU/IO 调优">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 板块 1: Windows Defender 编译降噪与白名单注入 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 1. Windows Defender 实时监控降噪与极客开发白名单" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (解决高频读写编译中间文件被 MsMpEng.exe 锁定卡顿问题)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshDevIoStatus_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushAlertYellowBg}" BorderBrush="{DynamicResource BrushAlertYellowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 技术解析：编译大型项目（C++、Rust、.NET、Go、Node 等）会短时间内生成数以万计的 .obj、.pdb、.tmp、.dll 文件。Defender 的筛选器驱动会拦截每一次 CreateFile/WriteFile 进行特征分析，是编译缓慢的头号元凶。您可选择直接关闭实时防护，或一键将开发目录与编译器进程注入排除白名单。" FontSize="11" Foreground="{DynamicResource BrushAlertYellowText}" TextWrapping="Wrap"/>
                                </Border>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 1.1 Defender 实时监控 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Defender 实时文件扫描防护 (Real-time Monitoring)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtDefenderRealtimeStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="关闭实时监控可彻底消除 MsMpEng.exe 对文件 I/O 的阻塞拦截，编译速度翻倍。（注：Windows 篡改防护若开启可能会在重启后提示还原）" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleDefenderRealtime" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleDefenderRealtime_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 1.2 SmartScreen 筛选器 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="SmartScreen 筛选器 (SmartScreen Filter)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtSmartScreenStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="关闭后避免运行自编译命令行可执行文件或从 GitHub / winget 下载工具链时频繁弹出未知发布者拦截弹窗。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleSmartScreen" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleSmartScreen_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 1.3 极客白名单一键注入 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="🚀 极客开发白名单一键注入 (兼顾日常安全与极速编译)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAlertGreenText}"/>
                                                    <TextBlock Text="自动将常用开发目录 (C:\02Programmer, C:\Dev, D:\Dev 等) 及 cl.exe, csc.exe, dotnet.exe, rustc.exe, cargo.exe, go.exe, gcc.exe, ninja.exe, msbuild.exe 等 12 种主流编译器进程一键加入 Defender 豁免清单。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="⚡ 一键注入白名单" Background="#10B981" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnInjectDevExclusions_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 2: Windows Search 索引服务与 Windows.edb 释放 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 2. Windows Search (WSearch) 索引服务停用与数据库清理" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (切断后台持续遍历代码树，释放占用庞大的 Windows.edb)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🗑️ 清理 Windows.edb" Background="#EF4444" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnCleanWindowsEdb_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="Windows Search 系统级索引服务 (WSearch)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtWSearchStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Text="程序员通常使用 Everything、ripgrep (rg) 或 IDE 自身索引。系统自带的 WSearch 会盲目遍历庞大的源码与 node_modules，常年占满后台 CPU 和 SSD 读写。禁用后配合上方清理可释放数 GB 到几十 GB 空间。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleWSearch" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleWSearch_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 3: SysMain 内存预载与空闲自动维护 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚙️ 3. SysMain (Superfetch) 内存预载与空闲自动维护任务" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="关闭高速 NVMe SSD 上无谓的内存页面预载换入换出，并防止无人操作挂机编译时 CPU 被突然抢占：" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- SysMain -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="SysMain 内存预加载服务 (原 Superfetch)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtSysMainStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="针对机械硬盘时代设计的预载机制。在现代高速 NVMe SSD 开发机上已无提速价值，反而频繁压缩内存占用 CPU。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleSysMain" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleSysMain_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 空闲自动维护 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="系统空闲自动维护 (Idle Maintenance)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtIdleMaintenanceStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="当键鼠无操作时，系统会自动唤起磁盘碎片整理、系统评估与预编译任务。关闭可保障离开工位时编译/下载挂机不受干扰。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleIdleMaintenance" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleIdleMaintenance_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 4: HVCI 内存完整性 (基于虚拟化的安全性) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 4. HVCI 内存完整性与基于虚拟化的安全隔离 (Hypervisor Code Integrity)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (消除底层内核安全隔离对高性能原生开发的 5%~15% 性能损耗)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="HVCI 内核代码完整性虚拟化隔离" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtHvciStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Text="开启时 Windows 会将内核隔离在底层微型虚拟机中运行。关闭可消除对 CPU 分支预测和高频系统调用的性能折损，使原生 C/C++、游戏和高并发程序跑满裸机潜能。(切换后需重启电脑生效)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleHvci" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleHvci_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 5: NTFS 底层文件系统吞吐调优 (8.3 短文件名 / 访问时间戳 / 缓存扩充) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📁 5. NTFS 底层文件系统吞吐调优 (8.3 短文件名 / 访问时间戳 / 缓存池)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (大幅加速海量工程小文件读写与 node_modules 目录生成)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 5.1 NTFS 8.3 短文件名 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="禁用 NTFS 8.3 短文件名生成 (NtfsDisable8dot3NameCreation)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtNtfs8dot3Status" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="全局关闭 DOS 时代 8.3 短文件名计算。在单目录包含万级小文件（如 node_modules、git objects、C++ 中间产物）时消除碰撞散列开销，解压与创建提速 15%~30%。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleNtfs8dot3" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleNtfs8dot3_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 5.2 最后访问时间戳 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="禁用 NTFS 最后访问时间戳更新 (NtfsDisableLastAccessUpdate)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtNtfsLastAccessStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="关闭后读文件不再向 SSD 反写最后访问时间戳元数据，彻底消除读操作引起的磁盘写入放大，保护 SSD 寿命并提升读吞吐。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleNtfsLastAccess" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleNtfsLastAccess_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 5.3 内存主缓存池 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="扩充 NTFS 元数据主内存缓存池 (NtfsMemoryUsage=2)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtNtfsMemoryStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="指示 NT 缓存管理器为 NTFS 元数据（MFT 记录与目录结构）分配更大的物理内存缓存池，大幅提升高频磁盘 I/O 命中率。(需重启生效)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleNtfsMemory" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleNtfsMemory_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 6: 内存管理、CPU 调度与 Localhost 网络栈 (Memory / CPU / TCP / WER) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 6. 内存管理、CPU 调度与 Localhost 网络栈 (Memory / CPU / TCP / WER)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (大内存机器去压缩、后台编译平权不降权、网络端口 30s 极速回收)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 6.1 内存压缩 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="禁用 Windows 内存压缩 (Disable-MMAgent -MemoryCompression)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtMemoryCompressionStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="适用于 32GB+ 充裕内存开发机。杜绝 CPU 核心实时压缩页面，消除重编译时多核被内核 StoreManager 抢占的微顿挫。(需重启生效)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleMemoryCompression" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleMemoryCompression_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 6.2 CPU 编译平权配额 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="CPU 编译平权长配额调度 (Win32PrioritySeparation=0x28)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtWin32PriorityStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="优化 NT 线程调度器时间片。当切到浏览器看文档时，后台的 MSBuild、Cargo、Ninja 编译工具链不受前台失焦降权克扣，全核满血持续输出。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleWin32Priority" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleWin32Priority_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 6.3 Localhost TCP 端口调优 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Localhost 高频网络栈调优 (TcpTimedWaitDelay 30s &amp; 端口池 65534)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtTcpPortReuseStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="将 TIME_WAIT 端口回收缩短为 30 秒，动态端口池扩至 65534。彻底消除本地微服务调用、接口压测或 Vite/Webpack HMR 频繁重连导致的 10055 端口耗尽。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleTcpPortReuse" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleTcpPortReuse_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 6.4 WER 错误报告拦截 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Windows 错误报告与 Watson 遥测拦截 (WER Disabled)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtWerStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="开发调试发生 Access Violation / 段错误时，屏蔽 WerFault.exe 挂起进程写几百兆 Dump 上传微软，秒级直接交由 VS/WinDbg 调试器接管。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleWer" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleWer_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 7: 系统响应与内核不分页注册表极致调优 (Registry Supercharge) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ 7. 系统响应与内核不分页注册表极致调优 (Registry Supercharge)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" (卡死超时缩短、安全关机策略、菜单展开零延迟 0ms、内核常驻物理内存)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 7.1 挂起超时 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="未响应快速判定与安全关机等待 (HungAppTimeout 1s &amp; WaitToKill 2s)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtHungAppStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="将未响应判定从 5 秒缩至 1 秒，关机服务超时从 20 秒缩至 2 秒。严格保持 AutoEndTasks=0 安全基线，关机遇未保存源码仍会弹窗询问，杜绝后台静默强杀。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleHungApp" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleHungApp_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 7.2 关机静默强杀 (高危选项) -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️ 关机/注销静默强杀未响应任务 (AutoEndTasks = 1)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAlertRedText}"/>
                                                        <TextBlock x:Name="TxtAutoEndTasksStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="【高危慎用】关机时不弹窗询问直接结束未响应进程。若 IDE/编辑器有未保存源码或断点挂起，将被直接强杀导致数据丢失！日常开发强烈建议保持【关闭】。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleAutoEndTasks" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleAutoEndTasks_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 7.3 菜单零延迟 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="菜单悬停弹出零迟滞 (MenuShowDelay = 0ms)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtMenuShowDelayStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="将系统默认的 400 毫秒菜单悬停动画等待直接抹平为 0 毫秒，所有右键菜单与级联子菜单即点即现，极度跟手流畅。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleMenuShowDelay" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleMenuShowDelay_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 7.4 内核常驻内存 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="内核执行体与驱动常驻物理内存 (DisablePagingExecutive=1)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtPagingExecutiveStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="强制 Windows 内核与驱动程序 100% 驻留高速物理内存，绝不换出至磁盘页面文件，彻底杜绝系统级 DPC 延迟与驱动调度卡顿。(需重启生效)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnTogglePagingExecutive" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnTogglePagingExecutive_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 7.5 Windows Update 登录态免强制重启 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Windows Update 登录态免强制重启 (NoAutoRebootWithLoggedOnUsers)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtAutoRebootStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="只要当前有用户登录（如后台挂机编译、模型训练、IDE 工程开启），Windows Update 绝不强制自动重启破坏现场。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleAutoReboot" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleAutoReboot_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 7.6 GameDVR 与后台录屏开销禁用 -->
                                        <Border Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="GameDVR 与后台屏幕捕获彻底禁用 (GameDVR_Enabled &amp; AppCapture)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtGameDvrStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="剥离 Windows 图形层 Direct3D/Vulkan 挂钩与常驻录屏进程，消除原生图形/游戏开发与 GPU 运算时的掉帧与显存占用。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleGameDvr" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="BtnToggleGameDvr_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
