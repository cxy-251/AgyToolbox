<UserControl x:Class="AgyToolbox.Views.SystemOptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💡 新电脑必配：杜绝自动更新打扰、防显卡驱动翻车、解锁硬件极限" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="新安装的 Windows 常常频繁弹出系统更新重启提示，甚至静默用老旧公版驱动替换用户的显卡驱动导致玩游戏黑屏。此外，Windows 默认隐藏扩展名容易中伪装病毒，默认开启快速访问主页充斥推广。在此模块中，你可以一键锁定自动更新、开启开荒三件套、激活隐藏的卓越性能模式，并享受经典的 Win10 完整右键菜单！"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块一：Windows 自动更新彻底关闭 / 恢复 (Windows Update) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛑 Windows 自动更新彻底关闭与锁定" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (组策略锁死、防自动更新显卡驱动黑屏、禁用 WaaSMedic 唤醒看门狗)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtUpdateStatus" Text="[检测更新状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshUpdateStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 为什么系统设置里“暂停更新 7 天”没用？以及硬核禁用原理：" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,0,4"/>
                            <TextBlock Text="1. 微软设置面板仅支持暂停最长 5 周，到期后必定强制唤醒后台下载并强推重启更新。" FontSize="11" Foreground="#78350F"/>
                            <TextBlock Text="2. 防显卡驱动翻车：Windows Update 经常静默用老旧公版驱动覆盖用户的最新显卡驱动，导致玩游戏黑屏、掉帧。本工具自动注入 ExcludeWPDriversInQualityUpdate=1 策略彻底拦截驱动覆盖！" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                            <TextBlock Text="3. 防半夜偷偷复活：仅禁用 wuauserv 服务没用，系统后台内置的 WaaSMedicSvc (更新医生看门狗) 会在凌晨自动重开更新服务。本工具将更新服务与看门狗一并禁用，并在组策略锁死 NoAutoUpdate。" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 彻底关闭更新 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🛑 彻底关闭 Windows 自动更新" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock Text="组策略锁定禁止下载 + 拦截驱动自动覆盖 + 禁用更新服务与 WaaSMedic 唤醒医生。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnDisableUpdate" Content="立即彻底关闭自动更新" Background="#EF4444" Click="BtnDisableUpdate_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 恢复官方默认更新 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🟢 恢复官方默认更新机制" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                <TextBlock Text="清除组策略更新限制规则，重新激活系统更新服务，恢复正常接收安全补丁。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnEnableUpdate" Content="恢复官方自动更新" Style="{DynamicResource SecondaryButton}" Click="BtnEnableUpdate_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块二：资源管理器开荒三件套 & 卓越性能模式 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📁 资源管理器开荒三件套 &amp; ⚡ 卓越性能模式" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (程序员与新机必配，安全防毒 + 极致硬件睿频)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 刷新设置状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshExplorerSettings_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 扩展名显示 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkShowFileExt" Content="始终显示文件扩展名" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkShowFileExt_Click"/>
                                <TextBlock Text="必须开启！防范 简历.pdf.exe 等钓鱼可执行文件病毒，方便快速辨析各类源码与配置文件。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 隐藏文件显示 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkShowHiddenFiles" Content="显示隐藏文件与驱动器" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkShowHiddenFiles_Click"/>
                                <TextBlock Text="方便开发者直接查看与编辑 .git, .env, .vscode, AppData 等工程和用户配置目录。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 打开此电脑 -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkOpenThisPc" Content="Win+E 默认打开【此电脑】" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkOpenThisPc_Click"/>
                                <TextBlock Text="告别 Windows 默认充满云同步推荐与最近历史记录的“快速访问主页”，直达硬盘盘符。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 卓越性能电源模式 -->
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⚡ 解锁 Windows 隐藏的【卓越性能模式】电源方案 (Ultimate Performance)" FontWeight="Bold" FontSize="13" Foreground="#4338CA"/>
                                <TextBlock Text="微软官方专为高端工作站研发的极致电源方案，解除处理器睿频限制与磁盘节能等待，榨干 CPU 极限性能。" FontSize="11" Foreground="#6366F1" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="⚡ 激活卓越性能" Background="#4F46E5" VerticalAlignment="Center" Click="BtnEnableUltimatePerf_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 板块三：Windows 11 常用去魅与体验优化 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎛️ Windows 11/10 体验去魅与实用优化 (安全透明可逆)" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="每个选项仅精准调整对应注册表开关，绝不破坏系统核心组件或 Windows Update，随时可一键恢复。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 优化项 1: Win10 经典右键完整菜单 -->
                        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 Win10 经典完整右键菜单" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtClassicMenuStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="还原右键直接展示全部功能选项，免去 Win11 每次点开都需要点击‘显示更多选项’的繁琐折叠。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleClassicMenu" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleClassicMenu_Click"/>
                            </Grid>
                        </Border>

                        <!-- 优化项 2: 关闭必应网络搜索广告 -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 关闭开始菜单/任务栏必应在线搜索与热搜广告" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtBingStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="禁用搜索时向必应服务器发包请求网络热搜与商业广告，纯粹保留本地应用和文件搜索，秒级响应。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleBing" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleBing_Click"/>
                            </Grid>
                        </Border>

                        <!-- 优化项 3: 禁用诊断数据遥测与个性化建议 -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ 禁用系统个性化遥测与广告追踪" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtTelemetryStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="关闭微软诊断数据跟踪与基于使用习惯的锁屏/设置广告推送，保护隐私并节省后台资源。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleTelemetry" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleTelemetry_Click"/>
                            </Grid>
                        </Border>

                        <!-- 优化项 4: 禁用连按5次Shift粘滞键弹窗 -->
                        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌨️ 禁用连续按 5 次 Shift 触发粘滞键烦人弹窗" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtStickyStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="玩游戏或打字急按 Shift 时经常意外弹出刺耳蜂鸣和‘是否启用粘滞键’确认框，新机必关。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleSticky" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleSticky_Click"/>
                            </Grid>
                        </Border>

                        <!-- 优化项 5: 开启 Win+V 原生剪贴板历史记录 -->
                        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 开启 Win+V 系统原生剪贴板历史记录" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtClipboardStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="多条文本/图片连续复制再也不怕覆盖！按下 Win+V 随时回溯历史并置顶常用代码片段。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleClipboard" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleClipboard_Click"/>
                            </Grid>
                        </Border>

                        <!-- 优化项 6: 开启开发者模式与解除 260 字符长路径限制 -->
                        <Border Grid.Row="5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💻 开启开发者模式 &amp; 解除 260 字符长路径限制" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtDevModeStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="解决深度嵌套项目 (如 node_modules、git clone 仓库) 因文件名超长报错，并允许本地未签名脚本自由测试。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleDevMode" Grid.Column="1" Content="切换状态" VerticalAlignment="Center" Click="BtnToggleDevMode_Click"/>
                            </Grid>
                        </Border>

                        <!-- 重启资源管理器 -->
                        <Border Grid.Row="6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔄 一键平滑重启 Windows 资源管理器 (explorer.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="修改上述右键菜单或搜索策略后，点击此处立即重启任务栏与资源管理器，使新配置即刻生效。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="立即重启 Explorer" Background="#0284C7" VerticalAlignment="Center" Click="BtnRestartExplorer_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块四：PATH 环境变量深度体检与幽灵死路径清理 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛠️ PATH 环境变量管理 &amp; 幽灵死路径检测" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (从上到下决定程序调用优先级，标红代表目录已丢失)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <RadioButton x:Name="RbUserPath" Content="当前用户" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="RbPathScope_Checked"/>
                            <RadioButton x:Name="RbSysPath" Content="系统全局" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RbPathScope_Checked"/>
                            <Button Content="⚡ 重新扫描" Style="{DynamicResource SecondaryButton}" Click="BtnReloadPath_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作工具条 -->
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="🗑️ 一键清除所有已失效死路径" Background="#EF4444" Margin="0,0,8,4" Click="BtnRemoveDeadPaths_Click"/>
                        <Button Content="⬆️ 上移 (提高优先级)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathUp_Click"/>
                        <Button Content="⬇️ 下移 (降低优先级)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathDown_Click"/>
                        <Button Content="➕ 新增路径" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnAddPath_Click"/>
                        <Button Content="❌ 删除选中项" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnDeleteSelectedPath_Click"/>
                        <Button Content="💾 保存修改并向系统广播生效" Background="#10B981" Margin="0,0,0,4" Click="BtnSavePath_Click"/>
                    </WrapPanel>

                    <!-- DataGrid 展示路径 -->
                    <DataGrid x:Name="GridPathEntries" AutoGenerateColumns="False" IsReadOnly="True" Height="220"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="30" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物理路径 (Path)" Binding="{Binding Path}" Width="*"/>
                            <DataGridTemplateColumn Header="状态检测" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExistsText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

