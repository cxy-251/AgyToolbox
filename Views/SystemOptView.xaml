<UserControl x:Class="AgyToolbox.Views.SystemOptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1800" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚙️ 步骤二：系统优化与必要设置 (Optimization &amp; Settings)" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="杜绝频繁打扰、消除隐形地雷、释放硬件极限。锁定自动更新防显卡驱动黑屏、排查 BitLocker 恢复密钥防止变砖、关停休眠文件立省 32G C 盘空间、切换专用网络打通局域网，并配置开发者必备的扩展名与 PATH 环境！"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块 1: Windows 自动更新彻底关闭 / 恢复 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛑 1. Windows 自动更新彻底关闭与锁定" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (组策略锁死、防自动更新显卡驱动黑屏、禁用 WaaSMedic 唤醒看门狗)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtUpdateStatus" Text="[检测更新状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshUpdateStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="💡 原理提示：系统注入 ExcludeWPDriversInQualityUpdate=1 策略彻底拦截微软公版显卡驱动自动覆盖，联合封杀 wuauserv 更新服务与凌晨自动复活的 WaaSMedicSvc 更新看门狗。" FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🛑 彻底关闭 Windows 自动更新" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock Text="组策略锁定禁止下载 + 拦截驱动自动覆盖 + 禁用更新服务与看门狗。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnDisableUpdate" Content="立即彻底关闭自动更新" Background="#EF4444" Click="BtnDisableUpdate_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🟢 恢复官方默认更新机制" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                <TextBlock Text="清除组策略更新限制规则，重新激活系统更新服务，恢复正常接收安全补丁。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnEnableUpdate" Content="恢复官方自动更新" Style="{DynamicResource SecondaryButton}" Click="BtnEnableUpdate_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 2: BitLocker 自动加密避坑与密匙防丢体检 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🔐 2. BitLocker 自动加密避坑与恢复密钥备份" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (新机最大隐形炸弹：主板重置或蓝屏后要求输入 48 位密匙)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtBitLockerStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBitLocker_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="⚠️ 为什么这是新机最大隐形地雷？" FontWeight="Bold" FontSize="12" Foreground="#B91C1C" Margin="0,0,0,4"/>
                            <TextBlock Text="很多 Win11 品牌笔记本出厂联网后，系统在后台静默开启了 BitLocker 设备加密，用户毫无感知。一旦未来更新主板 BIOS、硬件变更或蓝屏修复，开机将强制锁定并要求输入 48 位数字恢复密钥！若没有备份，全盘数据将彻底报废！" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="导出当前 C 盘 BitLocker 48 位数字恢复密钥" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                            <TextBlock Text="调用系统底层 manage-bde 提取本机存储保护密匙，请务必将其拍照或保存在手机备忘录中！" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔑 查询并备份恢复密钥" Background="#0284C7" VerticalAlignment="Center" Click="BtnGetBitLockerKey_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 3: C 盘空间拯救 (关停休眠) & 专用网络切换 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：关停休眠 -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 3.1 关停休眠文件 (C:\hiberfil.sys)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock x:Name="TxtHiberStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Windows 默认在 C 盘占用与物理内存同等大小 (16G~32GB+) 的 SSD 空间保存休眠缓存。台式机或长期插电办公的笔记本建议关停，瞬间释放几十 G！" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button x:Name="BtnToggleHiber" Content="关停休眠 (立省 32G)" Style="{DynamicResource SecondaryButton}" Click="BtnToggleHiber_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：专用网络切换 -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🌐 3.2 一键将当前网络切换为【专用网络】" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                            <TextBlock Text="Windows 连上新 Wi-Fi 默认设为“公用网络”，防火墙强行拦截局域网互通与 Ping，导致局域网快传或开发接口不通。点击一键设为专用网络解除封锁！" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Content="📶 设为专用网络 (打通局域网)" Background="#10B981" Click="BtnSetPrivateNetwork_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 板块 4: 资源管理器开荒三件套 & 卓越性能模式 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📁 4. 资源管理器开荒三件套 &amp; ⚡ 卓越性能模式" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (程序员安全防毒 + 极致硬件睿频)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshExplorerSettings_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkShowFileExt" Content="始终显示文件扩展名" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkShowFileExt_Click"/>
                                <TextBlock Text="必须开启！防范 简历.pdf.exe 等伪装钓鱼病毒，方便识别源码与配置文件。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkShowHiddenFiles" Content="显示隐藏文件与驱动器" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkShowHiddenFiles_Click"/>
                                <TextBlock Text="方便开发者直接查看与编辑 .git, .env, .vscode, AppData 等工程目录。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkOpenThisPc" Content="Win+E 默认打开【此电脑】" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Click="ChkOpenThisPc_Click"/>
                                <TextBlock Text="告别 Windows 默认充满云同步推荐与最近历史痕迹的“快速访问主页”。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⚡ 解锁 Windows 隐藏的【卓越性能模式】电源方案 (Ultimate Performance)" FontWeight="Bold" FontSize="13" Foreground="#4338CA"/>
                                <TextBlock Text="解除处理器睿频限制与硬件节能延迟，彻底释放高端工作站极限性能。" FontSize="11" Foreground="#6366F1" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="⚡ 激活卓越性能" Background="#4F46E5" VerticalAlignment="Center" Click="BtnEnableUltimatePerf_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 板块 5: Windows 11/10 体验去魅与实用优化 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎛️ 5. Windows 11/10 体验去魅与安全开关" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="精准调整注册表底层开关，透明安全可逆，随时可恢复默认配置：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Win10 经典右键菜单 -->
                        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 Win10 经典完整右键菜单" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtClassicMenuStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="还原右键直接展示全部选项，免去 Win11 每次都要点击‘显示更多选项’的繁琐折叠。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleClassicMenu" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleClassicMenu_Click"/>
                            </Grid>
                        </Border>

                        <!-- 关闭必应网络搜索 -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 关闭开始菜单/任务栏必应网络搜索与热搜广告" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtBingStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="禁用搜索时向必应服务器发包，纯粹保留本地应用和文件毫秒级响应。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleBing" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleBing_Click"/>
                            </Grid>
                        </Border>

                        <!-- 禁用遥测 -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ 禁用系统个性化遥测与广告追踪" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtTelemetryStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="关闭微软诊断数据跟踪与基于使用习惯的锁屏/设置广告推送，保护隐私节省资源。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleTelemetry" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleTelemetry_Click"/>
                            </Grid>
                        </Border>

                        <!-- 禁用按 5 次 Shift 粘滞键弹窗 -->
                        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌨️ 禁用连续按 5 次 Shift 触发粘滞键烦人弹窗" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtStickyStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="打字急按或玩游戏时意外弹出刺耳蜂鸣和‘是否启用粘滞键’确认框，新机必关。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleSticky" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleSticky_Click"/>
                            </Grid>
                        </Border>

                        <!-- 开启 Win+V 剪贴板历史记录 -->
                        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 开启 Win+V 系统原生剪贴板历史记录" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtClipboardStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="多条文本/图片连续复制再不怕覆盖，按下 Win+V 随时回溯历史并置顶常用代码。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleClipboard" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleClipboard_Click"/>
                            </Grid>
                        </Border>

                        <!-- 开启开发者模式与长路径 -->
                        <Border Grid.Row="5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💻 开启开发者模式 &amp; 解除 260 字符长路径限制" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtDevModeStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="解决深度嵌套项目 (如 node_modules 或 git clone) 报 Filename too long 错误。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleDevMode" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnToggleDevMode_Click"/>
                            </Grid>
                        </Border>

                        <!-- 重启资源管理器 -->
                        <Border Grid.Row="6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔄 一键平滑重启 Windows 资源管理器 (explorer.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="修改上述右键菜单或策略后，点击立即重启任务栏与资源管理器，使新配置即刻生效。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="立即重启 Explorer" Background="#0284C7" VerticalAlignment="Center" Click="BtnRestartExplorer_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 6: PATH 环境变量深度管理与幽灵死路径检测 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛠️ 6. PATH 环境变量管理 &amp; 幽灵死路径检测" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (从上到下决定命令优先级，标红代表物理目录已丢失)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <RadioButton x:Name="RbUserPath" Content="当前用户" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="RbPathScope_Checked"/>
                            <RadioButton x:Name="RbSysPath" Content="系统全局" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RbPathScope_Checked"/>
                            <Button Content="⚡ 重新扫描" Style="{DynamicResource SecondaryButton}" Click="BtnReloadPath_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作工具条 -->
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="🗑️ 一键清除所有失效死路径" Background="#EF4444" Margin="0,0,8,4" Click="BtnRemoveDeadPaths_Click"/>
                        <Button Content="⬆️ 上移 (提优先级)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathUp_Click"/>
                        <Button Content="⬇️ 下移 (降优先级)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnMovePathDown_Click"/>
                        <Button Content="➕ 新增路径" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnAddPath_Click"/>
                        <Button Content="❌ 删除选中项" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,4" Click="BtnDeleteSelectedPath_Click"/>
                        <Button Content="💾 保存并向系统广播生效" Background="#10B981" Margin="0,0,0,4" Click="BtnSavePath_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="GridPathEntries" AutoGenerateColumns="False" IsReadOnly="True" Height="200"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="30" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物理路径 (Path)" Binding="{Binding Path}" Width="*"/>
                            <DataGridTemplateColumn Header="状态检测" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExistsText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
