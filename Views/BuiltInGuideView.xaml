            <!-- Tab 4: 网络协议栈与路由诊断 -->
            <TabItem Header="🌐 网络栈与路由">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="网络协议栈状态检测、路由跃点追踪、DNS 解析反查与多网卡分流：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 4.1 ipconfig 与 netsh 核心操作 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="1. 网络适配器配置 (ipconfig)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【全参数规范与断网急救组合】&#x0a;• /all：完整输出物理 MAC、IPv4/IPv6、DHCP 租约与 DNS 地址。&#x0a;• /flushdns：清空本地解析器缓存。&#x0a;• /release &amp; /renew：重新向路由器申请获取 IP。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBox Text="ipconfig /release &amp;&amp; ipconfig /renew &amp;&amp; ipconfig /flushdns" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                        <Button Content="📋 断网急救三连" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                Click="BtnCopyCmd_Click" Tag="ipconfig /release &amp;&amp; ipconfig /renew &amp;&amp; ipconfig /flushdns"/>
                                    </Grid>
                                    <Button Content="刷新 DNS 缓存" Style="{DynamicResource SecondaryButton}" Click="BtnFlushDns_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="2. 协议栈复位 (netsh)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【技术机制】&#x0a;• winsock reset：清除代理工具残留的 LSP 分层服务提供者。&#x0a;• int ip reset：重置 TCP/IP 协议栈至初始状态。&#x0a;• 编辑 Hosts：以管理员权限编辑域名静态映射文件。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="重置协议栈" Background="#EF4444" Margin="0,0,3,0" Click="BtnResetWinsock_Click"/>
                                        <Button Grid.Column="1" Content="编辑 Hosts 文件" Style="{DynamicResource SecondaryButton}" Margin="3,0,0,0" Click="BtnEditHosts_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 4.2 链路测试选型矩阵 ping vs tracert vs pathping -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="3. 链路连通性与丢包诊断选型矩阵 (ping vs tracert vs pathping)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【技术选型与参数说明】&#x0a;• ping -f -l 1472 target：探测链路 MTU 极限大小（设置不分片 DF 标志）。&#x0a;• tracert -d target：-d 参数跳过反向 DNS PTR 解析，可将跟踪耗时从数分钟压缩至数秒。&#x0a;• pathping -q 50 -n target：综合统计沿途每个路由器节点的丢包百分比，一眼看清是内网交换机、城域网还是机房在丢包。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📋 ping (测 MTU 1472)" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"
                                            Click="BtnCopyCmd_Click" Tag="ping -f -l 1472 1.1.1.1"/>
                                    <Button Grid.Column="1" Content="📋 tracert -d (高速跳点)" Style="{DynamicResource SecondaryButton}" Margin="2,0,2,0"
                                            Click="BtnCopyCmd_Click" Tag="tracert -d github.com"/>
                                    <Button Grid.Column="2" Content="📋 pathping (丢包率分析)" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                            Click="BtnCopyCmd_Click" Tag="pathping -q 50 -n github.com"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4.3 域名解析与双网卡路由分流实战 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="4. 域名解析排查 (nslookup) 与双网卡静态分流 (route)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【排错与分流实例】&#x0a;• 查 IPv6 AAAA 记录：nslookup -querytype=AAAA github.com&#x0a;• 查权威邮件交换 MX 记录：nslookup -querytype=MX qq.com&#x0a;• 双网卡静态分流：route add 10.0.0.0 mask 255.0.0.0 10.15.2.1 -p（将 10.x.x.x 内网流量强制定向至内网网关，外网流量走主默认网关，彻底避免断网）。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📋 查 IPv6 记录 (-type=AAAA)" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"
                                            Click="BtnCopyCmd_Click" Tag="nslookup -querytype=AAAA github.com 223.5.5.5"/>
                                    <Button Grid.Column="1" Content="📋 查邮件 MX 记录 (-type=MX)" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                            Click="BtnCopyCmd_Click" Tag="nslookup -querytype=MX qq.com 223.5.5.5"/>
                                </Grid>
                                <Grid>
                                    <TextBox Text="route add 10.0.0.0 mask 255.0.0.0 10.15.2.1 -p" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                    <Button Content="📋 复制双网卡分流命令" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCmd_Click" Tag="route add 10.0.0.0 mask 255.0.0.0 10.15.2.1 -p"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4.4 WiFi 配置管理与密码提取 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
