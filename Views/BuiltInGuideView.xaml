                                    <Button Grid.Column="1" Content="生成睡眠待机报告" Style="{DynamicResource SecondaryButton}" Margin="2,0,2,0" Click="BtnSleepStudy_Click"/>
                                    <Button Grid.Column="2" Content="查唤醒源与休眠阻止项" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnLastWake_Click"/>
                                </Grid>

                                <!-- 实操命令行清单 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ 高频电源实战命令速查：" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="powercfg -h off" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 关闭休眠释放 C 盘等同 RAM 大小空间 (-h off)" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="powercfg -h off"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
