                        <TextBlock Text="死锁句柄检索、内存分配拓扑、磁盘 I/O 响应时间瓶颈与性能基准线：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 5.1 资源监视器深度解析手册 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
