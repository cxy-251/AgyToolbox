                                            Click="BtnCopyCmd_Click" Tag="netsh wlan export profile folder=C:\ key=clear"/>
                                    <Button Grid.Column="1" Content="📋 查看周围 WiFi 频段与信道拥堵" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                            Click="BtnCopyCmd_Click" Tag="netsh wlan show networks mode=bssid"/>
