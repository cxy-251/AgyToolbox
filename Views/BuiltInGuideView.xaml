<UserControl x:Class="AgyToolbox.Views.BuiltInGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💡 新电脑上手必知：Windows 原生自带的顶尖排错与运维神技指南" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="买到新电脑后无需安装任何臃肿的第三方安全卫士或驱动大师！Windows 原生系统内核内置了功能极其强大的专业级硬件诊断、稳定性分析、文件占用解除、网络排查与高级控制台。掌握它们，排错提效数倍。"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="本指南详细拆解底层原理、日常场景与排错步骤，并支持一键免敲指令直接唤起！"
                               FontSize="12" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 模块一：Windows 系统级内置排错神器 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🛠️ 一、系统内核级排错与诊断神器 (点击直达 + 底层原理解密)" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,12"/>

                    <!-- 1. 可靠性历史 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="📉 1. 可靠性历史监视器 (perfmon /rel) — 闪退与蓝屏死机破案神探" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】聚合系统事件日志 (Event Viewer) 中应用程序崩溃、Windows 蓝屏代码 (BugCheck) 与硬件故障时间线，生成 1~10 分的稳定性折线图。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】某款游戏打不开弹窗报错、软件莫名闪退。点开红叉日期 -> 点击“查看技术详细信息”，即可精准抓出具体导致崩溃的故障模块路径 (如 ntdll.dll 或 nvlddmkm.sys)，从此告别盲目重装系统！" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开可靠性图表" Style="{DynamicResource SecondaryButton}" Click="BtnReliability_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 2. 深度资源监视器 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="📊 2. 深度资源监视器 (resmon.exe) — 文件占用秒解除 &amp; 内核句柄过滤" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】基于 Windows ETW 内核追踪，提供比常规任务管理器细致 100 倍的实时句柄 (Handle)、模块 DLL 与网络 TCP 吞吐数据。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】删除文件夹报错‘文件正在被另一程序占用无法删除’时，点击【CPU】标签 -> 在【关联的句柄】输入文件夹名 -> 即可定位占用它的后台进程，右键即可结束进程秒解除占用！" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动 ResMon" Style="{DynamicResource SecondaryButton}" Click="BtnResmon_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 3. 笔记本官方电池报告 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🔋 3. 官方笔记本电池健康与损耗体检 (powercfg /batteryreport)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】直接与笔记本主板 ACPI 电池微控制器通信，读取出厂设计容量 (Design Capacity) 与当前完全充电容量 (Full Charge Capacity)。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】新机/二手笔记本验机防翻车，一键生成微软官方权威 HTML 报告并在浏览器打开，无需安装鲁大师即可核实电池循环次数与健康衰减。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="生成电池报告" Click="BtnBatteryReport_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 4. 免权限编辑 Hosts -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="📝 4. 免权限极速编辑 Hosts 文件 (notepad.exe runas drivers/etc/hosts)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】以 UAC 提升管理员权限调用记事本。新手直接用记事本打开受系统保护的 hosts 时，保存必弹‘拒绝访问’或另存为 .txt。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】为 GitHub 加速指定静态 IP、本地前后端开发将域名指向 127.0.0.1，点击后直接编辑并按 Ctrl+S 即可瞬间保存生效。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="编辑 Hosts" Style="{DynamicResource SecondaryButton}" Click="BtnEditHosts_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 5. 刷新 DNS 解析缓存 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🌐 5. 一键清空本地 DNS 污染缓存 (ipconfig /flushdns)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】强制清空系统 Dnscache 驻留内存中的域名与 IP 映射表，避免系统继续使用旧的过时/被劫持解析记录。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】修改 Hosts 后立即生效；换了代理或 Wi-Fi 节点后遇到“微信能发消息但网页无法加载”一键修复。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新 DNS 缓存" Style="{DynamicResource SecondaryButton}" Click="BtnFlushDns_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 6. 上帝模式 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🧙 6. 上帝模式全能控制台 (GodMode.{ED7BA470-8E54-465E-825C-99712043E01C})" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】Windows 外壳虚拟命名空间 GUID 特性，将注册表内分散在各个角落的 200+ 项系统底层控制设置平铺聚合为扁平列表。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】Windows 11 新版设置层级繁琐找东西费劲时，打开它直接通过右上角搜索框一步找出任意经典控制面板设置。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开上帝模式" Style="{DynamicResource SecondaryButton}" Click="BtnGodMode_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 7. 问题步骤记录器 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="📸 7. 问题步骤自动截图与操作记录器 (psr.exe)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】微软内置的诊断工具，后台监听鼠标动作，每点击一次自动在目标控件加绿框高亮截图，并生成带说明的流程报告。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】给父母长辈制作软件教程、或者向开发者或 IT 支持提交 Bug 复现步骤，无需手动一张张截图打字。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动 PSR" Style="{DynamicResource SecondaryButton}" Click="BtnPsr_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 8. 微软官方恶意软件查杀 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🛡️ 8. 微软官方恶意软件急救查杀 (mrt.exe)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】Windows 补丁日定期更新的特种恶意程序查杀引擎，纯绿色运行，查杀完即退出，零常驻后台开销。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】怀疑电脑中了恶性木马或勒索病毒、或者插入了外来 U 盘需要快速进行离线深度急救体检。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动 MRT" Style="{DynamicResource SecondaryButton}" Click="BtnMrt_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 9. 硬件与显卡 DirectX 诊断 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="🕹️ 9. DirectX 显卡驱动与硬件底层体检 (dxdiag.exe)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】直接同 WDDM 显卡驱动内核通信，读取最真实的显存大小、Direct3D 特性级别与声卡 WHQL 签名。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="【实战场景】验机核实显卡型号防止买到假显卡、检查高刷新率与 HDR 是否成功开启、排查游戏缺少 DirectX 运行库问题。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动 DXDiag" Style="{DynamicResource SecondaryButton}" Click="BtnDxDiag_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 10. WiFi 密码明文导出 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="📶 10. 本机已存 WiFi 密码一键提取 (netsh wlan show profile key=clear)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock Text="【底层原理】调用 Windows WLAN 原生网络配置服务，直接导出已连接过的网络安全密钥明文，完全不需要第三方密码查看工具。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="【实战场景】新买的手机/平板连接家里或公司 WiFi 忘了密码，点一下直接在下方表格显示并可复制。" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="立即提取 WiFi 密码" Click="BtnGetWifi_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid x:Name="GridWifi" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#F8FAFC" BorderBrush="#E2E8F0" MaxHeight="180" Visibility="Collapsed"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WiFi 名称 (SSID)" Binding="{Binding Ssid}" Width="260"/>
                                    <DataGridTextColumn Header="明文密码" Binding="{Binding Password}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 模块二：Windows 经典运行框 (Win+R) 指令宝典 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚡ 二、Windows 经典运行框 (Win+R) 快捷管理指令宝典" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="按下 Win+R 键，输入以下系统命令即可秒开对应的底层管理控制台，免去在新版设置里层层翻找。点击右侧按钮可直接一键启动！"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <!-- devmgmt.msc -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="devmgmt.msc (设备管理器)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock Text="排查驱动黄色感叹号、显卡/声卡/蓝牙/网卡硬件 ID、禁用设备。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnRunCmd_Click" Tag="devmgmt.msc"/>
                                </Grid>
                            </Border>

                            <!-- diskmgmt.msc -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="diskmgmt.msc (磁盘管理)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock Text="新硬盘分区、格式化、修改盘符、压缩卷与扩展 C 盘空间。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnRunCmd_Click" Tag="diskmgmt.msc"/>
                                </Grid>
                            </Border>

                            <!-- services.msc -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="services.msc (系统服务)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock Text="控制后台服务的启动类型 (自动/手动/禁用)，重启卡死的服务。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnRunCmd_Click" Tag="services.msc"/>
                                </Grid>
                            </Border>

                            <!-- sysdm.cpl -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="sysdm.cpl (经典系统属性)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock Text="直达高级系统设置、虚拟内存页面文件、系统还原与计算机名。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnRunCmd_Click" Tag="sysdm.cpl"/>
                                </Grid>
                            </Border>

                            <!-- gpedit.msc -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="gpedit.msc (本地组策略编辑器)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock Text="深度定制系统行为、登录策略、网络与安全规则 (限专业版/企业版)。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BtnRunCmd_Click" Tag="gpedit.msc"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 右列 -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <!-- ncpa.cpl -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
