                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="4. ClearType 文本调谐 (cttune.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【使用场景】解决外接高分屏或特定面板代码字体发虚、边缘呈现红蓝彩色杂边的问题，校准子像素亚像素渲染平滑度。"
