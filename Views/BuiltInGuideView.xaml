                                <StackPanel>
                                    <TextBlock Text="1. 系统信息 (msinfo32.exe) — 硬件与固件拓扑" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读重点】&#x0a;• BIOS 模式：显示 UEFI 或 传统 (Legacy)。现代安全功能必需 UEFI。&#x0a;• 安全启动状态：Secure Boot 开启状态。&#x0a;• PCR7 绑定：BitLocker 启动完整性是否由 TPM 2.0 自动接管。&#x0a;• 基于虚拟化的安全性 (VBS / HVCI)：显示正在运行代表内核隔离已生效。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBox Text="msinfo32 /report C:\sys_report.txt" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                        <Button Content="📋 导出文本报告" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                Click="BtnCopyCmd_Click" Tag="msinfo32 /report C:\sys_report.txt"/>
                                    </Grid>
                                    <Button Content="打开系统信息 (msinfo32)" Style="{DynamicResource SecondaryButton}" Click="BtnMsInfo32_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 3.2 dxdiag -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="2. DirectX 诊断 (dxdiag.exe) — 图形与驱动模型" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读重点】&#x0a;• 驱动程序模型：WDDM 3.0 / 3.1 / 3.2 等版本。&#x0a;• 功能级别 (Feature Levels)：显卡物理支持的 Direct3D 特性集（如 12_2, 12_1）。游戏报不支持 DX12 时由此字段决定，装软件无法伪造。&#x0a;• WHQL 签名：显卡驱动是否通过微软认证，未签名驱动常为闪退根源。&#x0a;• 显存分配：检查 Dedicated VRAM 与 Shared Memory。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开 DirectX 诊断 (dxdiag)" Style="{DynamicResource SecondaryButton}" Click="BtnDxDiag_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3.3 powercfg 全参数诊断与丰富实操 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="3. 电源与待机能耗诊断全参数规范 (powercfg)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【报告与排查指令选型】&#x0a;• powercfg /batteryreport：生成出厂设计容量与完全充电容量比对 HTML 报告，精准核验电池循环次数与健康损耗。&#x0a;• powercfg /sleepstudy：生成 Modern Standby 待机耗电报告，诊断笔记本合盖放背包异常发烫、异常掉电的后台元凶。&#x0a;• powercfg -lastwake 与 /requests：秒查上一次究竟是谁唤醒了系统，以及当前阻止系统进入休眠的活动设备与流。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
