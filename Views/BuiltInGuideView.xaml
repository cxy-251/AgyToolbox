<UserControl x:Class="AgyToolbox.Views.BuiltInGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:builtin="clr-namespace:AgyToolbox.Views.BuiltIn"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100">

    <Grid Background="{DynamicResource BrushWindowBg}">
        <Grid.RowDefinitions>
            <!-- 顶部标题与故障检索栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 主内容展示区 (TabControl 或 检索结果) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部功能头与搜索过滤栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题与说明 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📖 步骤三：Windows 内置工具工程排错手册与系统管理体系" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="收录 30+ 核心原生诊断工具与控制台。各工具模块独立封装，提供参数代价分析、GUI 巡检指南、现代替代方案与 AQS 检索实战。"
                                   FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="8 大工程维度 · 零第三方依赖" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- 全局故障症状与工具搜索条 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TbSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12"
                                     VerticalAlignment="Center" TextChanged="TbSearch_TextChanged"
                                     ToolTip="输入故障症状或工具名，如：文件被占、蓝屏、端口探测、睡眠发热、恢复环境、WinRE、哈希、双网卡分流、冷重启、TRIM、坏道..."/>
                            <TextBlock Grid.Column="1" x:Name="TbSearchPlaceholder" Text="输入故障症状、指令或工具名 (如: 端口探测, 蓝屏, 句柄占用, 睡眠发热, 恢复环境, 哈希, 双网卡分流, 清零...)"
                                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Visibility="Collapsed"
                                    Background="Transparent" Foreground="{DynamicResource BrushTextMuted}" BorderThickness="0" Padding="4,0" Cursor="Hand" Click="BtnClearSearch_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 主内容区：未搜索时显示 TabControl，搜索时切换为检索结果列表 -->
        <Grid Grid.Row="1">

            <!-- 1. 常规模式：8 大模块横向标签页 -->
            <TabControl x:Name="MainTabControl" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0"
                        ItemContainerStyle="{DynamicResource SubTabItemStyle}">

                <!-- Tab 1: 崩溃与内核急救 -->
                <TabItem Header="💥 崩溃与内核急救">
                    <builtin:CrashRescueSection />
                </TabItem>

                <!-- Tab 2: 存储与文件系统 -->
                <TabItem Header="💾 存储与文件系统">
                    <builtin:StorageDiskSection />
                </TabItem>

                <!-- Tab 3: 硬件拓扑与电源 -->
                <TabItem Header="🔋 硬件拓扑与电源">
                    <builtin:HardwarePowerSection />
                </TabItem>

                <!-- Tab 4: 网络栈与路由 -->
                <TabItem Header="🌐 网络栈与路由">
                    <builtin:NetworkStackSection />
                </TabItem>

                <!-- Tab 5: 资源与性能巡检 -->
                <TabItem Header="🩺 资源与性能巡检">
                    <builtin:PerfTraceSection />
                </TabItem>

                <!-- Tab 6: 安全策略与权限 -->
                <TabItem Header="🛡️ 安全策略与权限">
                    <builtin:SecurityAuthSection />
                </TabItem>

                <!-- Tab 7: 引导恢复与配置 -->
                <TabItem Header="⚙️ 引导恢复与系统配置">
                    <builtin:BootRecoverySection />
                </TabItem>

                <!-- Tab 8: 检索语法与控制台 -->
                <TabItem Header="🧰 检索语法与管理控制台">
                    <builtin:ConsoleAqsSection />
                </TabItem>

            </TabControl>

            <!-- 2. 搜索过滤模式：动态匹配卡片列表 -->
            <Border x:Name="PanelSearchResults" Background="{DynamicResource BrushWindowBg}" Visibility="Collapsed" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="🎯 匹配到的故障场景与诊断方案：" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtResultCount" Text="(0 项)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,0,0,0"/>
                        </WrapPanel>

                        <!-- 动态渲染的匹配项列表 -->
                        <ItemsControl x:Name="ListSearchResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <WrapPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <Border Background="{DynamicResource BrushSidebarItemSelected}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource BrushSidebarItemSelectedText}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Symptom}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Border Background="{DynamicResource BrushCodeBg}" BorderBrush="{DynamicResource BrushCodeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding CommandOrAction}" FontFamily="Consolas" FontSize="10" Foreground="#0284C7"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                                        Tag="{Binding CommandOrAction}" Click="BtnCopySearchResult_Click"/>
                                                <Button Content="前往模块" FontSize="11" Padding="8,3"
                                                        Tag="{Binding TargetTabIndex}" Click="BtnGoToTab_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>
