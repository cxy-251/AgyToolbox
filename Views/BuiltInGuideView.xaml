            <!-- Tab 5: 系统资源与性能监控 -->
            <TabItem Header="🩺 资源与性能监控">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="死锁句柄检索、内存分配拓扑、磁盘 I/O 响应时间瓶颈与性能基准线：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 5.1 资源监视器深度解析手册 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="1. 资源监视器 (resmon.exe) — 4 大选项卡深度判读手册" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面指标与排查决策】&#x0a;• 【CPU】选项卡 -> 关联的句柄 (Associated Handles)：搜索被占用文件名，立即定位锁定该文件的进程并强杀，解决文件无法删除移动问题。&#x0a;• 【内存 (Memory)】选项卡 -> 彩条分布：重点关注【为硬件保留的内存】若高达数 GB，通常为双通道插槽松动、氧化或 BIOS 预分配 iGPU 过大；【备用 (Standby)】为随时可释放的系统缓存。&#x0a;• 【磁盘 (Disk)】选项卡 -> 响应时间 (Response Time)：持续高于 50~100ms 代表磁盘存在 I/O 拥塞或物理老化；活动时间持续 100% 为存储瓶颈。&#x0a;• 【网络 (Network)】选项卡：查看各进程 TCP 握手状态与重传丢失。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动资源监视器" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnResmon_Click"/>
                            </Grid>
                        </Border>

                        <!-- 5.2 性能监视器与基准线 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="2. 性能监视器 (perfmon.msc) — 计数器与系统基准线" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【核心计数器基准线规范】&#x0a;• Processor(_Total)\% Processor Time：持续高于 80% 代表 CPU 计算瓶颈。&#x0a;• Memory\Available MBytes：可用物理内存。低于 500MB 时系统将频繁触发页面文件分页置换，造成明显顿挫。&#x0a;• PhysicalDisk(_Total)\Current Disk Queue Length：磁盘队列长度。持续超过磁盘主轴物理数量的 2 倍即代表 I/O 阻塞。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开性能监视器" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnPerfMon_Click"/>
                            </Grid>
                        </Border>

                        <!-- 5.3 事件查看器与排查实战 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="3. 事件查看器 (eventvwr.msc) — 内核关键日志筛选节点" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【关键排查日志节点】&#x0a;• Windows 日志 -> 系统：筛选 Event ID 41 (Kernel-Power 异常断电/强行关机重启)、Event ID 1001 (BugCheck 蓝屏 Dump 转储)、Event ID 7 (磁盘坏道 Bad Block)。&#x0a;• Windows 日志 -> 应用程序：排查软件崩溃与 .NET 运行时异常。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开事件查看器" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnEventVwr_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 6: 安全策略与权限管理 -->
            <TabItem Header="🛡️ 安全策略与权限">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="恶意软件脱机查杀、本地组策略、特权账户提权与根证书信任审查：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 6.1 MRT 恶意软件删除工具 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="1. 微软恶意软件删除工具 (mrt.exe) — 官方独立脱机查杀引擎" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【机制与用途】微软随每月 Windows 累积更新定期推送的独立安全扫描程序。专注于查杀活跃流行的特洛伊木马、蠕虫后门与挖矿程序，适合在怀疑系统被注入时进行干净脱机排查。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动 MRT 查杀工具" Background="#0284C7" VerticalAlignment="Center" Click="BtnMrt_Click"/>
                            </Grid>
                        </Border>

                        <!-- 6.2 本地安全策略与用户组 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="2. 本地安全策略 (secpol.msc)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【核心配置策略项】&#x0a;• 账户策略 -> 密码策略：设定密码复杂度与历史记录保留。&#x0a;• 账户锁定策略：设定阈值锁定，防范暴力破解登录。&#x0a;• 本地策略 -> 用户权限分配：配置作为服务登录与提权权限。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开本地安全策略" Style="{DynamicResource SecondaryButton}" Click="BtnSecPol_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="3. 本地用户和组 (lusrmgr.msc)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【管理与提权控制】&#x0a;• 本地账户管理：激活内置 Administrator 特权账户、强制重置密码。&#x0a;• 用户组归属：审查 Administrators 组成员，清除未授权提权的残留账户。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开用户和组管理" Style="{DynamicResource SecondaryButton}" Click="BtnLusrMgr_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 6.3 证书管理器与 DCOM 配置 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="4. 证书管理器 (certmgr.msc)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【安全审查指南】&#x0a;• 检查【受信任的根证书颁发机构】，排查抓包调试工具（如 Fiddler、Charles）残留的自签名根证书与可疑证书链。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开证书管理器" Style="{DynamicResource SecondaryButton}" Click="BtnCertMgr_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="5. 组件服务 (dcomcnfg.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【DCOM 权限排查】&#x0a;• 管理分布式 COM 访问与身份验证级别，解决 Windows 日志中高频出现的 DistributedCOM 10016 拒绝访问报错。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开组件服务" Style="{DynamicResource SecondaryButton}" Click="BtnDcomCnfg_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 7: 系统管理控制台与 AQS 高级查询语法 -->
            <TabItem Header="🧰 管理控制台与检索">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="步骤复现工具、原生远程协助、核心 MMC 管理控制台与 AQS 检索语法全景示范：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 7.1 步骤记录器与远程协助 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="1. 步骤记录器 (psr.exe - Steps Recorder)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【机制与用途】排障复现利器。每次点击操作自动截取当前屏幕，在点击坐标添加绿色高亮框并附带按键动作说明，导出为单文件 HTML 格式技术排错报告。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="启动步骤记录器" Style="{DynamicResource SecondaryButton}" Click="BtnStepsRecorder_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="2. 原生远程协助 (msra.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【机制与用途】Windows 内置安全远程屏幕共享与控制协议，无需安装第三方远控软件，通过邀请文件或连接密码建立受保护的远程桌面通道。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="启动远程协助" Style="{DynamicResource SecondaryButton}" Click="BtnRemoteAssist_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 7.2 核心系统管理控制台速查矩阵 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="3. 核心管理控制台 (MMC &amp; CPL) 快捷启动矩阵" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="devmgmt.msc (设备管理器)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="devmgmt.msc"/>
                                    <Button Content="diskmgmt.msc (磁盘管理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="diskmgmt.msc"/>
                                    <Button Content="services.msc (系统服务)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="services.msc"/>
                                    <Button Content="ncpa.cpl (网络连接适配器)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="ncpa.cpl"/>
                                    <Button Content="sysdm.cpl (系统属性与变量)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="sysdm.cpl"/>
                                    <Button Content="gpedit.msc (本地组策略)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="gpedit.msc"/>
                                    <Button Content="compmgmt.msc (计算机综合管理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="compmgmt.msc"/>
                                    <Button Content="cleanmgr.exe (系统磁盘清理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="cleanmgr.exe"/>
                                    <Button Content="GodMode (全局设置集合面板)" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,6" Click="BtnGodMode_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 7.3 AQS 搜索语法全景示范矩阵 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="4. 文件资源管理器高级查询语法 (AQS, Advanced Query Syntax) 全景示范" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="直接在 Windows 资源管理器右上角搜索框中输入以下结构化表达式，支持多维度复合秒级过滤：" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                                <!-- 维度 1: 文件分类与类型 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="📂 维度一：文件类型 (kind / type)" FontWeight="Bold" FontSize="11" Foreground="#0284C7" Margin="0,0,0,4"/>
                                        <TextBlock Text="• kind:docs (全部文档: docx, xlsx, ppt, pdf, txt)&#x0a;• kind:pictures (图像) | kind:videos (视频) | kind:music (音频) | kind:folders (仅文件夹)&#x0a;• type:=.zip (精准限定压缩包文件类型)"
                                                   FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBox Text="kind:docs" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 复制 kind:docs" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="kind:docs"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 维度 2: 文件大小区间 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="💾 维度二：文件大小区间 (size)" FontWeight="Bold" FontSize="11" Foreground="#0284C7" Margin="0,0,0,4"/>
                                        <TextBlock Text="• size:>1GB (超大文件排查) | size:100MB..500MB (区间范围检索)&#x0a;• size:empty (0 字节空文件清理) | size:tiny (0~16KB 极小文件) | size:gigantic (&gt;4GB 超大镜像)"
                                                   FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="size:&gt;1GB" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜大于 1GB 文件" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="size:&gt;1GB"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="size:100MB..500MB" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜区间 100M~500M" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="size:100MB..500MB"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 维度 3: 修改日期与时间 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="📅 维度三：修改日期与时间 (datemodified / datecreated)" FontWeight="Bold" FontSize="11" Foreground="#0284C7" Margin="0,0,0,4"/>
                                        <TextBlock Text="• datemodified:today (今天) | datemodified:yesterday (昨天) | datemodified:this week (本周)&#x0a;• datemodified:last month (上月) | datemodified:2024-01-01..2024-06-30 (指定日期范围)"
                                                   FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="datemodified:today" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜今天修改的文件" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="datemodified:today"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="datemodified:2024-01-01..2024-06-30" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜区间修改时间" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="datemodified:2024-01-01..2024-06-30"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 维度 4: 文件名、扩展名与正文内容全文检索 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🔍 维度四：文件名、扩展名与正文全文检索 (name / ext / content)" FontWeight="Bold" FontSize="11" Foreground="#0284C7" Margin="0,0,0,4"/>
                                        <TextBlock Text="• name:~=&quot;backup&quot; (文件名包含 backup) | name:app* (以 app 开头)&#x0a;• ext:.log OR ext:.dmp (同时匹配多种特定扩展名)&#x0a;• content:&quot;connection timeout&quot; (检索文件内部正文包含特定关键词)"
                                                   FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="ext:.log OR ext:.dmp" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜 log 与 dmp" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="ext:.log OR ext:.dmp"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="content:&quot;connection timeout&quot;" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 搜正文含关键词" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="content:&quot;connection timeout&quot;"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 维度 5: 逻辑运算与实战组合拳 -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="⚡ 维度五：排错与磁盘瘦身经典组合拳示范 (实战推荐)" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                        
                                        <TextBlock Text="1. 排查 C 盘大于 1GB 的非 Windows 系统文件 (排除系统盘误删风险)：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                        <Grid Margin="0,2,0,4">
                                            <TextBox Text="size:>1GB -path:C:\Windows" IsReadOnly="True" Background="White" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 复制" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="size:>1GB -path:C:\Windows"/>
                                        </Grid>

                                        <TextBlock Text="2. 检索最近 3 天内产生的崩溃转储 Dump 或报错日志：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                        <Grid Margin="0,2,0,4">
                                            <TextBox Text="(ext:.dmp OR ext:.log) datemodified:last 3 days" IsReadOnly="True" Background="White" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 复制" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="(ext:.dmp OR ext:.log) datemodified:last 3 days"/>
                                        </Grid>

                                        <TextBlock Text="3. 精准查找包含特定内网 IP 或端口的 JSON / 配置文件：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                        <Grid Margin="0,2,0,4">
                                            <TextBox Text="ext:.json content:&quot;127.0.0.1&quot;" IsReadOnly="True" Background="White" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 复制" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="ext:.json content:&quot;127.0.0.1&quot;"/>
                                        </Grid>

                                        <TextBlock Text="4. 排查并清理磁盘中的 0 字节空文件 (排除文件夹)：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                        <Grid Margin="0,2,0,0">
                                            <TextBox Text="size:empty -kind:folders" IsReadOnly="True" Background="White" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 复制" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopySnippet_Click" Tag="size:empty -kind:folders"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
