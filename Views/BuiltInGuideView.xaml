                                                    Click="BtnCopyCmd_Click" Tag="powercfg /devicequery wake_armed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="powercfg /energy /output &quot;C:\energy_report.html&quot;" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 生成 60 秒系统能效评估报告 (/energy)" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="powercfg /energy /output &quot;C:\energy_report.html&quot;"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="⚡ 一键导入【卓越性能】电源方案" HorizontalAlignment="Right" Background="#7C3AED" Padding="6,2" FontSize="10"
                                                    Click="BtnEnableUltimateScheme_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 3.4 显示器校准与 ClearType 文本调谐 -->
                        <Grid>
