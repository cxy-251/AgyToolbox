<UserControl x:Class="AgyToolbox.Views.BuiltInGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📖 步骤三：Windows 内置系统工具与诊断修复指南 (Built-in Diagnostics &amp; System Tools)" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                <TextBlock Text="本指南严格遵循系统工程分析标准，摒弃盲目试错。针对 CLI 命令行工具，提供全参数行为对比与执行代价分析；针对 GUI 管理控制台，提供精准的界面字段判读规范与排查决策依据。"
                           FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 7 个系统工程专业子标签 -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 系统崩溃与内核转储诊断 -->
            <TabItem Header="💥 崩溃与内核转储">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="针对应用程序闪退、图形驱动重置、系统冻结及蓝屏 (BSOD) 的标准排查与组件修复链路：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 1.1 可靠性监视器 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="1. 可靠性监视器 (perfmon.exe /rel) — 崩溃溯源与模块定位" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读】重点查看时间轴下方的【关键事件 (Critical Events)】红叉标记。双击崩溃条目展开【技术详细信息】：&#x0a;• 故障模块 (Faulting module name)：直接指认崩溃所在的 .dll 或 .sys 驱动（如 nvlddmkm.sys、ntdll.dll）。&#x0a;• 异常代码 (Exception code)：如 0xc0000005 代表内存访问越界/空指针，0xc0000374 代表堆内存损坏。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="【判读依据】无需安装 WinDbg 即可快速区分是第三方软件缺陷、显卡驱动故障还是物理 RAM 错误。" FontSize="10" Foreground="#2563EB" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开可靠性监视器" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnReliability_Click"/>
                            </Grid>
                        </Border>

                        <!-- 1.2 Windows 内存诊断工具 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="2. Windows 内存诊断 (mdsched.exe) — 脱机底层 RAM 硬件测试" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【机制与流程】一键安排在下次重启时直接进入 UEFI/BIOS 底层独立环境进行多轮算法跑圈：&#x0a;• 测试模式 (按 F1 切换)：基本 (Basic, 快速)、标准 (Standard, 默认包含 LRAND 与 Stride6)、扩展 (Extended, 针对隐蔽位翻转)。&#x0a;• 结果查看路径：重启登入系统后，在事件查看器 (eventvwr.msc) -> Windows 日志 -> 系统 中筛选来源 MemoryDiagnostics-Results (Event ID 1101)。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="【排查场景】系统无故蓝屏且代码频繁随机变动（如 MEMORY_MANAGEMENT）时，排查是否由于 RAM 接触不良、金手指氧化或物理损坏引起。" FontSize="10" Foreground="#0284C7" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动内存诊断计划" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnMemoryDiag_Click"/>
                            </Grid>
                        </Border>

                        <!-- 1.3 驱动程序验证程序管理器 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="3. 驱动程序验证程序 (verifier.exe) — 内核驱动压力压力测试" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【技术机制】针对 DRIVER_IRQL_NOT_LESS_OR_EQUAL 等蓝屏元凶难以定位时，对选定的第三方内核驱动（外设、声卡、杀毒驱动）施加极端的特殊内存池和 IRQL 校验，逼出潜伏的野指针并生成转储 Dump。&#x0a;⚠️ 【应急防护规范】若开启后导致开机反复蓝屏，请按 F8 进入安全模式，打开终端执行 verifier /reset 即可彻底清除所有验证规则。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动驱动验证管理器" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnDriverVerifier_Click"/>
                            </Grid>
                        </Border>

                        <!-- 1.4 SFC 与 DISM 参数全景 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="4. 系统核心文件与组件库映像修复流水线 (SFC &amp; DISM)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBlock Text="【参数对比与执行逻辑】标准修复链推荐先 SFC 后 DISM：&#x0a;• sfc /scannow：扫描并修复受损受保护核心文件，从本地 WinSxS 提取官方签名副本恢复。&#x0a;• sfc /verifyonly：只读完整性扫描，仅输出差异报告，不修改任何磁盘文件。&#x0a;• DISM /Online /Cleanup-Image /ScanHealth：深度检测本地组件存储的结构性损坏（耗时 5~10 分钟）。&#x0a;• DISM /Online /Cleanup-Image /RestoreHealth：联机与 Windows Update 通信，下载完好组件替换受损源。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="运行 SFC 扫描修复" Background="#0284C7" Margin="0,0,4,0" Click="BtnRunSfc_Click"/>
                                    <Button Grid.Column="1" Content="运行 DISM 联机修复" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnRunDism_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 存储系统与文件系统维护 -->
            <TabItem Header="💾 存储与文件系统">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="文件系统元数据校验、坏扇区抢救、底层 TRIM 状态与组件存储管理：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 2.1 chkdsk 参数全景表 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="1. 磁盘检查与元数据修复 (chkdsk) — 全参数规范与代价分析" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <Button Content="运行只读联机预检 (C: /scan)" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right"
                                            Click="BtnChkdskScan_Click"/>
                                </Grid>
                                <TextBlock Text="【参数用法与代价矩阵】&#x0a;• chkdsk C: /scan：【联机只读预检】首选推荐！系统正常运行时秒级跑完，不独占锁盘、无需重启，仅报告错误状态。&#x0a;• chkdsk C: /f：【修复文件系统】修复 MFT 与目录索引逻辑错误。必须独占卷；系统盘会安排在下次重启时脱机执行（耗时约 2~10 分钟）。&#x0a;• chkdsk C: /r：【物理坏道扫描】包含 /f 所有逻辑，外加物理扇区逐一读取与数据抢救。执行代价极高（大容量磁盘耗时数小时，对 I/O 产生重载）。&#x0a;• chkdsk D: /f /x：【强制卸载并修复】针对非系统数据盘，强制关闭打开的文件句柄 (Handle) 并立即修复。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📋 复制 /f 修复命令" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"
                                            Click="BtnCopyCmd_Click" Tag="chkdsk C: /f"/>
                                    <Button Grid.Column="1" Content="📋 复制 /r 坏道扫描" Style="{DynamicResource SecondaryButton}" Margin="2,0,2,0"
                                            Click="BtnCopyCmd_Click" Tag="chkdsk C: /r"/>
                                    <Button Grid.Column="2" Content="📋 复制 /f /x 卸载修复" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                            Click="BtnCopyCmd_Click" Tag="chkdsk D: /f /x"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2.2 fsutil 文件系统行为与 TRIM -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="2. 文件系统底层行为与 SSD TRIM 状态 (fsutil)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【关键指令与判据】&#x0a;• fsutil behavior query DisableDeleteNotify：检查 SSD TRIM 状态。返回 0 代表 TRIM 已正常启用；返回 1 代表已禁用（会导致 SSD 垃圾回收失效、写入降速并加速磨损）。&#x0a;• fsutil dirty query C:：检查卷是否被内核标记为“脏卷 (Dirty Bit)”。若标记为脏卷，系统将在下次启动时强制运行自检。&#x0a;• fsutil volumeinfo C:：获取文件系统高级特性支持（CoW、对象 ID、配额、精简配置支持等）。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📋 查 TRIM 状态" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"
                                            Click="BtnCopyCmd_Click" Tag="fsutil behavior query DisableDeleteNotify"/>
                                    <Button Grid.Column="1" Content="📋 查 Dirty 脏卷标记" Style="{DynamicResource SecondaryButton}" Margin="2,0,2,0"
                                            Click="BtnCopyCmd_Click" Tag="fsutil dirty query C:"/>
                                    <Button Grid.Column="2" Content="📋 查卷特性 (volumeinfo)" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                            Click="BtnCopyCmd_Click" Tag="fsutil volumeinfo C:"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2.3 磁盘管理与驱动器优化 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- diskmgmt.msc -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="3. 磁盘管理 (diskmgmt.msc)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读】&#x0a;• 分区样式 (Partition Style)：磁盘属性 -> 卷 -> GUID 分区表 (GPT) vs 主启动记录 (MBR)。GPT 支持 UEFI 引导与 2TB+ 卷。&#x0a;• 异常状态：RAW 分区代表文件系统结构受损未挂载，需 chkdsk 抢救；EFI 系统分区为引导必需，切勿强行抹除。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开磁盘管理" Style="{DynamicResource SecondaryButton}" Click="BtnRunCmd_Click" Tag="diskmgmt.msc"/>
                                </StackPanel>
                            </Border>

                            <!-- dfrgui.exe -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="4. 驱动器优化与 TRIM (dfrgui.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【技术机制】&#x0a;• 对固态硬盘 (SSD)：发送原生 TRIM 指令回收擦除块，保持最佳写入性能。&#x0a;• 对机械硬盘 (HDD)：合并碎片文件，降低磁头物理寻道延迟。&#x0a;• 建议状态：保持每周计划自动优化开启即可。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开驱动器优化" Style="{DynamicResource SecondaryButton}" Click="BtnDiskDefrag_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.4 WinSxS 组件库清理 -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="5. WinSxS 组件库清理与重基准化 (DISM /ResetBase)" FontWeight="Bold" FontSize="13" Foreground="#B45309"/>
                                    <TextBlock Text="【技术后果与不可逆警告】调用 /StartComponentCleanup /ResetBase 彻底清除已被新更新替代的陈旧补丁备份，释放数 GB 存储空间。&#x0a;⚠️ 注意：执行后将永久无法回滚或卸载当前已安装的历史系统更新！"
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="清理组件库" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnRunWinSxSCleanup_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 硬件拓扑与电源管理诊断 -->
            <TabItem Header="🔋 硬件拓扑与电源">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="底层固件拓扑、DirectX 硬件功能级别与 Modern Standby 待机能耗分析：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 3.1 msinfo32 -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="1. 系统信息 (msinfo32.exe) — 硬件与固件全景拓扑" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读重点】&#x0a;• BIOS 模式 (BIOS Mode)：显示 UEFI 或 传统 (Legacy)。现代安全功能必需 UEFI。&#x0a;• 安全启动状态 (Secure Boot State)：Win11 升级与各类反作弊运行的前置要求。&#x0a;• PCR7 绑定 (PCR7 Binding)：BitLocker 启动完整性是否由 TPM 2.0 自动绑定接管。&#x0a;• 基于虚拟化的安全性 (VBS / HVCI)：显示正在运行代表内核隔离已生效。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开系统信息 (msinfo32)" Style="{DynamicResource SecondaryButton}" Click="BtnMsInfo32_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 3.2 dxdiag -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="2. DirectX 诊断 (dxdiag.exe) — 图形与驱动模型" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读重点】&#x0a;• 驱动程序模型 (Driver Model)：WDDM 3.0 / 3.1 / 3.2 等版本。&#x0a;• 功能级别 (Feature Levels)：显卡物理硬件支持的 Direct3D 特性集（如 12_2, 12_1）。游戏报不支持 DX12 时由此字段决定，装软件无法伪造。&#x0a;• WHQL 签名 (WHQL Logo'd)：检查显卡驱动是否通过微软认证，未签名驱动常为闪退根源。&#x0a;• 显存分配：检查 Dedicated VRAM 与 Shared Memory。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开 DirectX 诊断 (dxdiag)" Style="{DynamicResource SecondaryButton}" Click="BtnDxDiag_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3.3 powercfg 全参数诊断 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="3. 电源与待机能耗诊断全参数规范 (powercfg)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【报告与排查指令选型】&#x0a;• powercfg /batteryreport：生成出厂设计容量与完全充电容量比对 HTML 报告，精准核验电池循环次数与健康损耗。&#x0a;• powercfg /sleepstudy：生成 Modern Standby 待机耗电报告，诊断笔记本合盖放背包异常发烫、异常掉电的后台元凶。&#x0a;• powercfg -lastwake 与 /requests：秒查上一次究竟是谁唤醒了系统，以及当前阻止系统进入休眠的活动设备与流。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="生成电池健康报告" Background="#10B981" Margin="0,0,4,0" Click="BtnBatteryReport_Click"/>
                                    <Button Grid.Column="1" Content="生成睡眠待机报告" Style="{DynamicResource SecondaryButton}" Margin="2,0,2,0" Click="BtnSleepStudy_Click"/>
                                    <Button Grid.Column="2" Content="查唤醒源与休眠阻止项" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnLastWake_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📋 复制 60秒能效体检 (/energy)" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"
