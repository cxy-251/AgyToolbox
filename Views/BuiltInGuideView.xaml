<UserControl x:Class="AgyToolbox.Views.BuiltInGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📖 步骤三：Windows 内置系统工具与诊断修复指南 (Built-in Diagnostics &amp; System Tools)" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                <TextBlock Text="本指南严格遵循系统工程分析标准。针对 CLI 命令行工具，提供全参数用法对比、执行代价与丰富的实战场景实例；针对 GUI 管理控制台，提供精准的界面字段判读规范、底层依赖与排查决策依据。"
                           FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 7 个系统工程专业子标签 -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 系统崩溃与内核转储诊断 -->
            <TabItem Header="💥 崩溃与内核转储">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="针对应用程序闪退、图形驱动重置、系统冻结及蓝屏 (BSOD) 的标准排查与组件修复链路：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 1.1 可靠性监视器 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1. 可靠性监视器 (perfmon.exe /rel) — 崩溃溯源与模块定位" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="打开可靠性监视器" Style="{DynamicResource SecondaryButton}" Click="BtnReliability_Click"/>
                                </Grid>
                                <TextBlock Text="【界面判读重点】&#x0a;• 关键事件 (Critical Events, 红叉标记)：定位应用程序故障与 Windows 系统故障。&#x0a;• 技术详细信息：双击具体故障条目，提取 Faulting module name 与 Exception code。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="💡 高频典型异常代码 (Exception Code) 快速对照实战：" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 0xc0000005 (STATUS_ACCESS_VIOLATION)：内存访问违规（最常见空指针引用或野指针越界）。&#x0a;• 0xc0000374 (STATUS_HEAP_CORRUPTION)：进程堆内存损坏，常见于 C++ 运行时缓冲区溢出或野指针释放。&#x0a;• 0xc00000fd (STATUS_STACK_OVERFLOW)：栈内存溢出，多见于递归死循环。&#x0a;• 故障模块为 nvlddmkm.sys / amdkmdag.sys：确定为显卡驱动崩溃；ntdll.dll / clr.dll：系统底层库或 .NET 运行时异常。"
                                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 1.2 Windows 内存诊断工具 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2. Windows 内存诊断 (mdsched.exe) — 脱机底层 RAM 硬件测试" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="启动内存诊断计划" Style="{DynamicResource SecondaryButton}" Click="BtnMemoryDiag_Click"/>
                                </Grid>
                                <TextBlock Text="【运行流程与测试模式】一键安排在下次重启时直接进入 UEFI/BIOS 底层独立环境进行多轮算法跑圈：&#x0a;• 测试模式 (按 F1 切换)：基本 (Basic, 快速)、标准 (Standard, 默认推荐，包含 LRAND 与 Stride6)、扩展 (Extended, 针对高负载隐蔽位翻转 Bit Flips)。&#x0a;• 结果查看路径：重启登入系统后，在事件查看器 (eventvwr.msc) -> Windows 日志 -> 系统 中筛选来源 MemoryDiagnostics-Results (Event ID 1101)。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="【实战排查场景】系统无故蓝屏且每次崩溃报错代码随机变动（如 MEMORY_MANAGEMENT, KMODE_EXCEPTION_NOT_HANDLED）时，用于排除物理 RAM 坏块、金手指接触不良或时序不稳定。" FontSize="10" Foreground="#0284C7"/>
                            </StackPanel>
                        </Border>

                        <!-- 1.3 驱动程序验证程序管理器 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="3. 驱动程序验证程序 (verifier.exe) — 内核驱动压力测试" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="启动驱动验证管理器" Style="{DynamicResource SecondaryButton}" Click="BtnDriverVerifier_Click"/>
                                </Grid>
                                <TextBlock Text="【技术机制】针对 DRIVER_IRQL_NOT_LESS_OR_EQUAL 等疑难蓝屏，对选定的第三方内核驱动（外设、声卡、网卡、杀毒过滤驱动）施加极端的特殊内存池和强制 IRQL 校验，逼出潜伏的野指针并生成转储 Dump。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ 常用命令行指令与应急恢复：" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="verifier /querysettings" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 查验证状态" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="verifier /querysettings"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="verifier /reset" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 彻底重置清除" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="verifier /reset"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="⚠️ 【应急防护规范】若开启驱动验证后导致开机反复蓝屏循环，在开机时按 F8 进入 Windows 安全模式，打开命令行执行 verifier /reset 即可彻底清除所有验证规则正常进系统。"
                                           FontSize="10" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 1.4 SFC 与 DISM 在线/脱机全参数规范 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="4. 系统核心文件与组件库映像修复流水线 (SFC &amp; DISM)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBlock Text="【参数对比与执行逻辑】标准修复链推荐先 SFC 后 DISM：&#x0a;• sfc /scannow：扫描并修复受损系统核心文件，从本地 WinSxS 提取官方签名副本恢复。&#x0a;• sfc /verifyonly：只读完整性扫描，仅输出差异报告，不修改任何磁盘文件。&#x0a;• DISM /Online /Cleanup-Image /ScanHealth：深度扫描本地组件存储结构损坏（耗时 5~10 分钟）。&#x0a;• DISM /Online /Cleanup-Image /RestoreHealth：联机与 Windows Update 通信，下载完好组件替换受损源。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="运行 SFC 扫描修复" Background="#0284C7" Margin="0,0,4,0" Click="BtnRunSfc_Click"/>
                                    <Button Grid.Column="1" Content="运行 DISM 联机修复" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnRunDism_Click"/>
                                </Grid>

                                <!-- 脱机急救实例 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="🚨 无法正常开机时的 WinRE PE 命令行脱机急救指令 (Offline Recovery)：" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,4"/>
                                        <TextBlock Text="当 Windows 无法启动进桌面，在 Windows RE 恢复环境命令提示符下指定脱机目录修复：" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="sfc /scannow /offbootdir=C:\ /offwindir=C:\Windows" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 脱机 SFC" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="sfc /scannow /offbootdir=C:\ /offwindir=C:\Windows"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="dism /image:C:\ /cleanup-image /restorehealth /source:WIM:D:\sources\install.wim:1" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 脱机 DISM" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="dism /image:C:\ /cleanup-image /restorehealth /source:WIM:D:\sources\install.wim:1"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 存储系统与文件系统维护 -->
            <TabItem Header="💾 存储与文件系统">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="文件系统元数据校验、坏扇区抢救、底层 TRIM 状态与组件存储管理：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- 2.1 chkdsk 参数全景与丰富实战 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1. 磁盘检查与元数据修复 (chkdsk) — 全参数规范与代价分析" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="运行只读联机预检 (C: /scan)" Style="{DynamicResource SecondaryButton}" Click="BtnChkdskScan_Click"/>
                                </Grid>
                                <TextBlock Text="【参数矩阵与代价说明】&#x0a;• chkdsk C: /scan：【联机只读预检】首选推荐！系统正常运行时秒级跑完，不独占锁盘、无需重启，仅生成错误检测报告。&#x0a;• chkdsk C: /f：【修复文件系统】修复 MFT 与目录索引错误。必须独占卷；系统盘会安排在下次重启时脱机执行（耗时约 2~10 分钟）。&#x0a;• chkdsk C: /r：【物理坏道扫描】包含 /f 所有逻辑，外加物理扇区逐一读取与数据抢救。执行代价极高（大容量磁盘耗时数小时，对 I/O 产生重载）。&#x0a;• chkdsk D: /f /x：【强制卸载并修复】针对外接 U 盘或非系统数据盘，强制断开所有打开的文件句柄 (Handle) 并立即修复。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ 典型实战场景命令速查：" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="chkdsk C: /scan /perf" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 性能加速预检 (/perf)" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="chkdsk C: /scan /perf"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="chkdsk D: /f /x" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 强制卸载数据盘修复 (/f /x)" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="chkdsk D: /f /x"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="chkdsk D: /r" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 机械硬盘坏道数据抢救 (/r)" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="chkdsk D: /r"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2.2 fsutil 文件系统行为与 TRIM -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="2. 文件系统底层行为与 SSD TRIM 状态 (fsutil)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="【关键指令与判据】&#x0a;• fsutil behavior query DisableDeleteNotify：检查 SSD TRIM 状态。返回 0 代表已正常启用；返回 1 代表已禁用（会导致 SSD 垃圾回收失效、写入降速并加速磨损）。&#x0a;• fsutil dirty query C:：检查卷是否被内核标记为“脏卷 (Dirty Bit)”。若标记为脏卷，系统将在下次启动时强制运行自检。&#x0a;• fsutil volumeinfo C:：获取文件系统高级特性支持（CoW、对象 ID、配额、精简配置支持等）。"
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ 常用实战维护指令：" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="fsutil behavior set DisableDeleteNotify 0" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 强制开启 SSD TRIM" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="fsutil behavior set DisableDeleteNotify 0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="fsutil dirty set C:" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 标记下次开机强制自检" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="fsutil dirty set C:"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Text="fsutil file createnew test_1g.dat 1073741824" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                            <Button Content="📋 秒级生成 1GB 测试占位文件" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                    Click="BtnCopyCmd_Click" Tag="fsutil file createnew test_1g.dat 1073741824"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2.3 磁盘管理与驱动器优化 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- diskmgmt.msc -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="3. 磁盘管理 (diskmgmt.msc)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【界面判读】&#x0a;• 分区样式 (Partition Style)：磁盘属性 -> 卷 -> GUID 分区表 (GPT) vs 主启动记录 (MBR)。GPT 支持 UEFI 引导与 2TB+ 卷。&#x0a;• 异常状态：RAW 分区代表文件系统结构受损未挂载，需抢救；EFI 系统分区为引导必需，切勿强行抹除。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开磁盘管理" Style="{DynamicResource SecondaryButton}" Click="BtnRunCmd_Click" Tag="diskmgmt.msc"/>
                                </StackPanel>
                            </Border>

                            <!-- dfrgui.exe -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="4. 驱动器优化与 TRIM (dfrgui.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【技术机制】&#x0a;• 对固态硬盘 (SSD)：发送原生 TRIM 指令回收擦除块，保持最佳写入性能。&#x0a;• 对机械硬盘 (HDD)：合并碎片文件，降低磁头物理寻道延迟。&#x0a;• 建议状态：保持每周计划自动优化开启即可。"
                                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Button Content="打开驱动器优化" Style="{DynamicResource SecondaryButton}" Click="BtnDiskDefrag_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.4 WinSxS 组件库清理 -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="5. WinSxS 组件库清理与重基准化 (DISM /ResetBase)" FontWeight="Bold" FontSize="13" Foreground="#B45309"/>
                                    <TextBlock Text="【技术后果与不可逆警告】调用 /StartComponentCleanup /ResetBase 彻底清除已被新更新替代的陈旧补丁备份，释放数 GB 存储空间。&#x0a;⚠️ 注意：执行后将永久无法回滚或卸载当前已安装的历史系统更新！"
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="清理组件库" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnRunWinSxSCleanup_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
