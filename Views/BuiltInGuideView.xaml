<UserControl x:Class="AgyToolbox.Views.BuiltInGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1800" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📖 步骤三：系统自带工具使用指南 (场景化排错链路)" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="拒绝泛泛而谈的名词罗列！真正的专家级维护应当围绕【故障排查链路 (Workflow)】展开：从闪退蓝屏破案、内核完整性修复，到断网协议栈复位、WinSxS 补丁瘦身，一整套标准实战救命指南与一键直达！"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 场景 1: 卡顿假死、崩溃闪退与系统受损修复链路 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💥 场景一：卡顿假死、闪退蓝屏与内核文件受损修复链路" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="遇到软件打不开、游戏频繁报错、莫名死机时，按照以下标准排查流水线逐级执行：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 1.1 可靠性历史 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 1: 可靠性历史监视器 (perfmon /rel) — 精准抓出报错模块" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【排查指引】点击崩溃发生日期的红叉 -> 点击‘查看技术详细信息’，直查具体故障模块路径 (如 ntdll.dll、nvlddmkm.sys 显卡驱动)，破除报错盲区！" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开可靠性图表" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnReliability_Click"/>
                        </Grid>
                    </Border>

                    <!-- 1.2 sfc /scannow -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 2: 系统核心文件完整性扫描与自动修复 (sfc /scannow)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【修复原理】基于 Windows 官方签名哈希比对所有系统关键 DLL/SYS 文件，一旦发现受损或被流氓篡改，自动从备份提取纯净版本替换修复。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="运行 SFC 扫描修复" Background="#0284C7" VerticalAlignment="Center" Click="BtnRunSfc_Click"/>
                        </Grid>
                    </Border>

                    <!-- 1.3 DISM 在线组件库修复 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 3: DISM 在线组件库深度修复 (DISM /Online /RestoreHealth)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【修复原理】若 SFC 提示无法修复损坏，说明本地备份组件库本身受损。DISM 直接与微软官方更新服务器通信，拉取最新纯净镜像修复组件库基底。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="运行 DISM 深度修复" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnRunDism_Click"/>
                        </Grid>
                    </Border>

                    <!-- 1.4 深度资源监视器解除文件占用 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 4: 深度资源监视器 (resmon.exe) — 文件占用秒查 &amp; 内核句柄强杀" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【实战技巧】删除文件提示‘被另一程序打开’时，打开 ResMon -> 切换到【CPU】标签 -> 在【关联的句柄】输入文件名 -> 秒搜占用它的后台进程并强制结束！" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动 ResMon" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnResmon_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 场景 2: 网络断网、DNS 污染与协议栈急救链路 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 场景二：断网急救、DNS 污染与网络协议栈复位链路" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="遇到“微信能发但网页打不开”、关掉代理后无法上网、或连上 Wi-Fi 报无 Internet 时执行：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 2.1 刷新 DNS 缓存 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 1: 刷新本地 DNS 域名解析缓存 (ipconfig /flushdns)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【底层原理】清空本地内存中的过期/被污染解析映射表，使新 Hosts 配置或新 DNS 立即生效。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新 DNS 缓存" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnFlushDns_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2.2 重置 Winsock 与 IP 协议栈 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 2: 网络协议栈终极复位 (netsh winsock reset + int ip reset)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【终极救命】解决代理软件崩溃导致 LSP 劫持残留、无论换什么 Wi-Fi 都断网的顽疾，将 Windows 网络底层栈还原为出厂状态。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="终极重置协议栈" Background="#EF4444" VerticalAlignment="Center" Click="BtnResetWinsock_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2.3 免权限编辑 Hosts -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="步骤 3: 管理员免权限极速编辑 Hosts 配置文件" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="【使用场景】为 GitHub 加速指定静态 IP、将测试域名映射到 127.0.0.1，保存免弹拒绝访问或另存为 txt。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="编辑 Hosts" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnEditHosts_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2.4 WiFi 密码提取 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="步骤 4: 本机已存 WiFi 密码明文一键提取" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="【原理】调用 netsh wlan show profile key=clear，新手机平板连 Wi-Fi 忘记密码直接查。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="立即提取 WiFi 密码" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnGetWifi_Click"/>
                            </Grid>
                            <DataGrid x:Name="GridWifi" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#F8FAFC" BorderBrush="#E2E8F0" MaxHeight="140" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WiFi 名称 (SSID)" Binding="{Binding Ssid}" Width="240"/>
                                    <DataGridTextColumn Header="明文密码" Binding="{Binding Password}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 场景 3: 磁盘空间瘦身与硬件底层健康 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔋 场景三：磁盘空间瘦身与硬件底层健康透视" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="新机验机、电池健康度查验、以及彻底清除系统盘过期更新备份：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <!-- WinSxS 瘦身 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="WinSxS 冗余补丁终极瘦身" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="调用 DISM /ResetBase 彻底抹除过期补丁备份，释放数 G 到十几 G C 盘空间。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="组件库瘦身" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnRunWinSxSCleanup_Click"/>
                                </Grid>
                            </Border>

                            <!-- 官方电池报告 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="笔记本电池健康 HTML 报告" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="通过 powercfg /batteryreport 读取出厂设计容量与当前充放电损耗。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="生成电池报告" Background="#10B981" VerticalAlignment="Center" Click="BtnBatteryReport_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 右侧 -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <!-- DirectX 诊断 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="DirectX 显卡驱动诊断 (dxdiag)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="直读显存大小、Direct3D 特性级别与声卡 WHQL 签名，验机防假显卡。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="启动 DXDiag" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnDxDiag_Click"/>
                                </Grid>
                            </Border>

                            <!-- 上帝模式 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="上帝模式控制台 (GodMode)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="将系统底层 200+ 控制项平铺聚合，右上角直接秒搜任意控制面板老功能。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开上帝模式" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Click="BtnGodMode_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 场景 4: 运行框 (Win+R) 指令宝典与 AQS 高级搜索语法 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="⚡ 场景四：经典运行框 (Win+R) 指令宝典与 AQS 高级搜索语法" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="告别新版设置繁琐跳转，熟练掌握 Win+R 常用 msc/cpl 指令与资源管理器原生 AQS 秒搜语法：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 运行命令快速按钮组 -->
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="devmgmt.msc (设备管理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="devmgmt.msc"/>
                        <Button Content="diskmgmt.msc (磁盘管理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="diskmgmt.msc"/>
                        <Button Content="services.msc (系统服务)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="services.msc"/>
                        <Button Content="ncpa.cpl (网络适配器)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="ncpa.cpl"/>
                        <Button Content="sysdm.cpl (系统属性)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="sysdm.cpl"/>
                        <Button Content="gpedit.msc (组策略)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="gpedit.msc"/>
                        <Button Content="compmgmt.msc (计算机管理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,6" Click="BtnRunCmd_Click" Tag="compmgmt.msc"/>
                        <Button Content="cleanmgr (磁盘清理)" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,6" Click="BtnRunCmd_Click" Tag="cleanmgr"/>
                    </WrapPanel>

                    <!-- AQS 语法卡片 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="🔍 资源管理器 AQS 原生高级搜索语法示范 (在资源管理器搜索框直接粘贴)：" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="类型:图片 大小:>10MB 修改日期:上周" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                <Button Grid.Column="1" Content="📋 复制复合示例" Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0" Click="BtnCopySnippet_Click" Tag="类型:图片 大小:>10MB 修改日期:上周"/>
                            </Grid>
                            <TextBlock Text="• 按大小搜大文件: 大小:>500MB 或 size:>1GB&#x0a;• 按时间精确搜: 修改日期:今天 或 修改日期:2024/01/01..2024/06/30&#x0a;• 按扩展名精准搜: ext:.log 或 ext:.pdf" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
