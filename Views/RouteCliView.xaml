<UserControl x:Class="AgyToolbox.Views.RouteCliView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 第一部分：网络路由跳数与连通性实时诊断 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 网络路由跳数追踪与链路诊断 (Route &amp; Trace)" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="排查网络在哪个路由器节点中断、为什么高延迟、以及局域网物理设备发现。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 控制区 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标主机 / IP：" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtRouteHost" Grid.Column="1" Text="1.1.1.1" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"/>
                        
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="⚡ tracert -d (极速路由跳数)" Margin="0,0,8,4" Click="BtnTracertFast_Click"/>
                            <Button Content="📊 pathping (深度丢包诊断)" Margin="0,0,8,4" Click="BtnPathping_Click"/>
                            <Button Content="🗺️ route print (本机路由表)" Margin="0,0,8,4" Click="BtnRoutePrint_Click"/>
                            <Button Content="🔎 arp -a (局域网设备映射)" Margin="0,0,8,4" Click="BtnArp_Click"/>
                            <Button x:Name="BtnStopDiag" Content="⏹️ 停止" Background="#EF4444" Margin="0,0,8,4" Click="BtnStopDiag_Click" IsEnabled="False"/>
                            <Button Content="🧹 清空输出" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,4" Click="BtnClearDiagLog_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- 实时黑色控制台输出框 -->
                    <TextBox x:Name="TxtDiagConsole" Height="200" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas, Courier New" FontSize="12"
                             Padding="10" TextWrapping="Wrap"
                             Text="[网络诊断控制台已就绪] 请输入目标主机（如 1.1.1.1、baidu.com、github.com），并点击上方诊断命令开始执行...&#x0a;"/>

                    <!-- 路由原理解密卡片 -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 路由跳数（Hop）技术机制说明：" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="• TTL 机制：tracert 发送 IP 数据报文，生存时间（TTL）从 1 开始递增。第一跳路由器将 TTL 减为 0 后丢弃报文并返回 ICMP 超时通知，源主机由此获取该跳路由器的 IP 地址；依次类推探测出整条传输链路。" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                            <TextBlock Text="• -d 参数说明：默认情况下 tracert 会尝试对中间各跳 IP 执行反向 DNS 解析。添加 -d 参数（禁止将地址解析为路由器主机名）可显著加快跳数追踪速度。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="• 关于【* * * 请求超时】：部分骨干网与边界防火墙为了安全性禁用回显 ICMP 超时包，若最终目标跳数连通，通常不影响实际链路数据通信。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 第二部分：Windows 自带高频内置命令行工具速查 (Native CLI Tools) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🛠️ Windows 原生高频内置命令行工具速查" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="Windows 现代版本内置了完善的原生命令行实用工具，涵盖归档解压、网络请求、权限管理与文件校验等常见场景。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 工具条目列表 -->
                    <StackPanel>

                        <!-- 1. 原生解压缩 tar -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📦 1. 原生归档解压工具 (tar.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="Windows 10 1803+ 内置 bsdtar 工具，可在命令行直接提取或创建 .zip、.tar.gz 等格式的归档文件。" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBox Text="tar -xf file.zip -C ./output_folder" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 复制" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnCopyCli_Click" Tag="tar -xf file.zip -C ./output_folder"/>
                            </Grid>
                        </Border>

                        <!-- 2. 原生 curl 测试接口与下载 -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌐 2. 原生 HTTP 请求与接口测速 (curl.exe)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="⚠️ 重要避坑：Windows PowerShell 5.1 默认将 'curl' 映射为 'Invoke-WebRequest' 的别名！若要使用标准的 Unix curl 语法与参数，务必在命令行输入 curl.exe。" FontSize="11" Foreground="#B45309" Margin="0,2,0,4"/>
                                    <TextBox Text="curl.exe -I https://github.com" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 复制" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnCopyCli_Click" Tag="curl.exe -I https://github.com"/>
                            </Grid>
                        </Border>

                        <!-- 3. 原生 OpenSSH 客户端与免密登录 -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔑 3. 原生 OpenSSH 直连 Linux 服务器 (ssh / scp)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="系统内置 OpenSSH Client，无需安装 PuTTY 或 XShell；支持使用 ssh-keygen 生成 Ed25519 高安全密钥。" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBox Text="ssh root@192.168.1.100 -p 22" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 复制" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnCopyCli_Click" Tag="ssh root@192.168.1.100 -p 22"/>
                            </Grid>
                        </Border>

                        <!-- 4. 重启一键直达 BIOS/UEFI -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚡ 4. 免狂按按键、一步重启进入 BIOS 固件 (shutdown /r /fw)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="开机速度太快往往来不及狂按 Del 或 F2。以管理员身份在终端执行此命令，电脑自动重启直达主板 BIOS。" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBox Text="shutdown /r /fw /t 0" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 复制" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnCopyCli_Click" Tag="shutdown /r /fw /t 0"/>
                            </Grid>
                        </Border>

                        <!-- 5. 端口占用排查与定位 netstat -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔍 5. 端口占用快速定位与强制终止 (netstat + taskkill)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="查询目标端口对应 PID，再用 taskkill /f /pid 强制结束占用进程，彻底释放端口。" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                    <TextBox Text="netstat -ano | findstr :8080" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 复制" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnCopyCli_Click" Tag="netstat -ano | findstr :8080"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 第三部分：Windows 原生系统诊断、进程死锁与性能监控矩阵 (Native Diagnostic & Performance Matrix) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🩺 Windows 原生系统诊断、进程死锁排查与性能监控矩阵" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="系统级自带排错工具，无需安装任何第三方软件即可快速诊断文件句柄死锁、端口冲突、网络连通性与程序崩溃根因：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：句柄锁定排查与性能监控 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">

                            <!-- 资源监视器 resmon -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔒 资源监视器 (resmon) · 搜索文件死锁句柄" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <Button Grid.Column="1" Content="🚀 打开 resmon" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                Click="BtnLaunchTool_Click" Tag="resmon.exe"/>
                                    </Grid>
                                    <TextBlock Text="【典型场景】编译报错 'Cannot access file... locked by another process' 或删除文件夹提示被另一程序占用。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="【排错链路】&#x0a;1. 启动 resmon.exe -> 切换至【CPU】选项卡。&#x0a;2. 展开【关联的句柄】面板 -> 在搜索框输入被锁定的文件名或目录名。&#x0a;3. 界面会立刻列出具体持有该文件句柄的进程名称与 PID -> 右键即可结束进程释放锁定！"
                                               FontSize="11" Foreground="#0284C7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 性能监视器 perfmon -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📊 性能监视器 (perfmon) · 深度瓶颈剖析" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <Button Grid.Column="1" Content="🚀 打开 perfmon" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                Click="BtnLaunchTool_Click" Tag="perfmon.exe"/>
                                    </Grid>
                                    <TextBlock Text="【典型场景】排查磁盘 IOPS 饱和、内核硬件中断 (DPC/ISR)、分页文件争抢或多线程死锁瓶颈。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="【排错链路】支持自定义添加计数器（如 PhysicalDisk\% Disk Time、Avg. Disk Queue Length），实时监控硬件极限与系统吞吐。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- 右侧：端口连通性探测与崩溃事件查看 -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">

                            <!-- Test-NetConnection 原生 TCP 端口探测 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📡 Test-NetConnection · 原生 TCP 端口测试 (免 telnet)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                    <TextBlock Text="【典型场景】测试数据库 3306/5432、Redis 6379 或 Web 443 端口是否在远程服务器开放且连通。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="在 PowerShell 中直接运行（无需安装第三方 telnet 或 nc 工具）：" FontSize="10" Foreground="#64748B" Margin="0,2,0,2"/>
                                    <Grid Margin="0,2,0,6">
                                        <TextBox Text="Test-NetConnection -ComputerName github.com -Port 443" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                        <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                Click="BtnCopyCli_Click" Tag="Test-NetConnection -ComputerName github.com -Port 443"/>
                                    </Grid>
                                    <TextBlock Text="简写命令：tnc 192.168.1.1 -p 8080 -TraceRoute (自动探测连通性并跟踪路由跳数)" FontSize="10" Foreground="#059669"/>
                                </StackPanel>
                            </Border>

                            <!-- 事件查看器 eventvwr.msc WER 崩溃追踪 -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="💥 事件查看器 (eventvwr) · 程序闪退崩溃分析" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                        <Button Grid.Column="1" Content="🚀 打开 eventvwr" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                Click="BtnLaunchTool_Click" Tag="eventvwr.msc"/>
                                    </Grid>
                                    <TextBlock Text="【典型场景】程序或服务静默闪退、无弹窗报错，需要定位具体抛出异常的代码位置或崩溃模块。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="【排错链路】&#x0a;1. 启动 eventvwr.msc -> 导航至【Windows 日志】->【应用程序】。&#x0a;2. 筛选日志级别为【错误 (Error)】。&#x0a;3. 查看事件来源为 '.NET Runtime' 或 'Application Error' 的条目，即可提取未捕获的 Exception 类型、Faulting module 与异常调用堆栈。"
                                               FontSize="11" Foreground="#7C3AED" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 第四部分：Windows 搜索 AQS 高级语法与正则规律速查 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔍 Windows 资源管理器 AQS 搜索语法 &amp; 正则真相" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="Windows 资源管理器搜索框原生支持 AQS (Advanced Query Syntax) 高级查询语法，告别大海捞针。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：类型与大小 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="📁 类型与扩展名筛选" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="• 类型:文件夹 或 kind:folder" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                    <TextBlock Text="• 类型:图片 或 kind:pic (自动含 jpg/png/gif 等)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 类型:视频 或 kind:video / kind:music" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• ext:.log 或 ext:.txt (精确按后缀匹配)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="⚖️ 大小与区间筛选" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="• 大小:>500MB 或 size:>1GB" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                    <TextBlock Text="• 大小:空 (0 KB 占位文件)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 大小:巨大 (>128 MB) / 大小:小 (10-100 KB)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 大小:100MB..500MB (区间匹配)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧：时间、内容与正则真相 -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="📅 时间与内容匹配" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="• 修改日期:今天 或 datemodified:today" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                    <TextBlock Text="• 修改日期:2026/01/01..2026/03/01 (精确时间段)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 内容:&quot;error 10054&quot; (全文检索文件内文本)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 逻辑运算: kind:doc AND size:>10MB NOT 名称:test" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="⚠️ 关于“正则表达式 (Regex)”的真实真相" FontWeight="Bold" FontSize="13" Foreground="#B91C1C"/>
                                    <TextBlock Text="Windows 资源管理器默认【不支持】POSIX/PCRE 正则表达式（仅支持 * 和 ? 通配符）。" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                    <TextBlock Text="若要使用纯正正则（如 ^test_\d+\.log$），建议使用 Everything 工具输入 regex: 前缀，或在 PowerShell 中执行 Get-ChildItem -Recurse | Where-Object { $_.Name -match '正则' }。" FontSize="11" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 第五部分：CMD vs PowerShell 经典神级指令速查对比 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="💻 CMD vs PowerShell 必会神级指令对照" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="核心差异：CMD 输出是无格式的纯字符流 (String)；PowerShell 传递的是带有属性与方法的 .NET 强类型对象 (Object)。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CMD 神技 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="⬛ 传统 CMD 经典黑客神技" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="1. 查程序在哪 (类似 which):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="where python" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="where python"/>
                                </Grid>

                                <TextBlock Text="2. Windows 最强多线程断点镜像复制 (秒杀 copy):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="robocopy C:\Src D:\Dst /E /MT:16 /R:1 /W:1" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="robocopy C:\Src D:\Dst /E /MT:16 /R:1 /W:1"/>
                                </Grid>

                                <TextBlock Text="3. 将任何命令输出直接注入系统剪贴板:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="ipconfig /all | clip" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="ipconfig /all | clip"/>
                                </Grid>

                                <TextBlock Text="4. 强制强杀进程 (按映像名或 PID):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="taskkill /f /im node.exe" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="taskkill /f /im node.exe"/>
                                </Grid>

                                <TextBlock Text="5. 切换控制台 UTF-8 编码 (防乱码):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,0">
                                    <TextBox Text="chcp 65001" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="chcp 65001"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PowerShell 神技 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🟦 现代 PowerShell 对象级生产力神技" FontWeight="Bold" FontSize="13" Foreground="#0284C7" Margin="0,0,0,8"/>

                                <TextBlock Text="1. 原生测试远程 TCP 端口通不通 (替代 telnet):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="Test-NetConnection github.com -Port 443" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="Test-NetConnection github.com -Port 443"/>
                                </Grid>

                                <TextBlock Text="2. 对象管道筛选 (找出前 5 个最吃内存的进程):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="Get-Process | Sort-Object WorkingSet64 -Desc | Select -First 5" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="Get-Process | Sort-Object WorkingSet64 -Desc | Select -First 5"/>
                                </Grid>

                                <TextBlock Text="3. 查看并格式化拆分环境变量 PATH:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="$env:PATH -split ';'" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="$env:PATH -split ';'"/>
                                </Grid>

                                <TextBlock Text="4. 计算文件 SHA256 哈希值 (防篡改校验):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,6">
                                    <TextBox Text="Get-FileHash ./target.iso -Algorithm SHA256" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="Get-FileHash ./target.iso -Algorithm SHA256"/>
                                </Grid>

                                <TextBlock Text="5. 现代网络一键执行脚本 (安全安装环境):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <Grid Margin="0,2,0,0">
                                    <TextBox Text="irm https://get.scoop.sh | iex" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                            Click="BtnCopyCli_Click" Tag="irm https://get.scoop.sh | iex"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
