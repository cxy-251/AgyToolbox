<UserControl x:Class="AgyToolbox.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1600" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🧹 步骤一：新机开荒与预装管理 (Debloat &amp; 应用精简)" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="系统初始化与预装组件管理：提供 Windows 预装 UWP 应用管理、品牌厂商预装附带软件排查、关闭系统后台静默推荐安装策略，以及浏览器和 OneDrive 的管理选项。推荐使用 Windows 原生包管理器 winget 维护应用。"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块 1: 预装 UWP 应用管理与卸载 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📋 1. Windows 预装应用查看与按需卸载" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (提供官方用途说明、卸载影响评估与替代方案建议)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="⚡ 重新扫描预装状态" Style="{DynamicResource SecondaryButton}" Click="BtnScanUwp_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridUwpApps" AutoGenerateColumns="False" IsReadOnly="True" Height="280"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="40" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="150"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="75"/>
                            <DataGridTextColumn Header="官方用途说明" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="卸载影响分析" Binding="{Binding DebloatAdvice}" Width="2*"/>
                            <DataGridTextColumn Header="开源/轻量替代建议" Binding="{Binding OpenSourceAlternative}" Width="2*"/>
                            <DataGridTemplateColumn Header="安装状态" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 卸载" Style="{DynamicResource SecondaryButton}" Height="26" Padding="6,0"
                                                IsEnabled="{Binding IsInstalled}" Click="BtnUninstallSingleUwp_Click"
                                                Tag="{Binding PackagePrefix}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 2: OEM 品牌厂商预装管理软件排查 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ 2. OEM 品牌厂商预装管理软件排查与建议" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (分析后台常驻服务与系统资源开销，提供轻量替代选项)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 扫描预装软件" Style="{DynamicResource SecondaryButton}" Click="BtnScanOem_Click"/>
                    </Grid>

                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 常见厂商预装软件特性与处理说明：" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBlock Text="• 麦咖啡 (McAfee)：品牌机预装试用版包含多项实时监控服务。若常规卸载后遇到网络过滤组件残留，建议使用其官方专用的 MCPR (McAfee Consumer Product Removal) 工具清理。" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                            <TextBlock Text="• 华硕奥创中心 (Armoury Crate)：集成了较多驱动守护进程与灯效服务。若仅需调节基础性能模式与背光，社区常使用轻量开源工具 G-Helper 作为低开销的替代选择。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridOemApps" AutoGenerateColumns="False" IsReadOnly="True" Height="170"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="36" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="所属品牌" Binding="{Binding Vendor}" Width="80"/>
                            <DataGridTextColumn Header="软件特性与资源开销" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="维护建议与开源替代方案" Binding="{Binding DebloatAdvice}" Width="2*"/>
                            <DataGridTemplateColumn Header="当前状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 3: Windows 11 后台静默安装推广应用策略 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 3. Windows 11 后台静默安装推广应用策略管理" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock x:Name="TxtSilentAppStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="新系统接入网络后，系统默认会通过内容交付管理器在后台静默安装预设的推荐应用，并在开始菜单展示建议。关闭 SilentInstalledAppsEnabled 策略可阻止此类自动下载行为。"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnToggleSilentApps" Grid.Column="1" Content="切换策略状态" VerticalAlignment="Center" Click="BtnToggleSilentApps_Click"/>
                </Grid>
            </Border>

            <!-- 板块 4: 浏览器管理：Edge 卸载与 Chrome 安装 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🌐 4. 浏览器管理：卸载 Edge 与安装 Google Chrome" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (保留 WebView2 运行时，保障第三方桌面客户端正常运行)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtBrowserStatus" Text="[检测浏览器状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBrowserStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="💡 技术说明：卸载操作仅移除 Edge 浏览器主体外壳，严格保留底层的 WebView2 运行时（确保基于 WebView2 的第三方应用正常工作），并配置策略防止后续版本更新自动重新部署。" FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卸载 Edge -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🗑️ 卸载 Microsoft Edge 浏览器主体" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock Text="调用官方静默卸载命令，移除应用外壳与快捷方式，并配置策略阻止自动重新安装。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnUninstallEdge" Content="立即卸载 Edge 浏览器" Background="#EF4444" Click="BtnUninstallEdge_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 安装 Chrome & 设为默认 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🚀 安装 Google Chrome 官方纯净版" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                <TextBlock Text="通过 winget 直接从 Google 官方源拉取安装包，执行静默安装。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnInstallChrome" Grid.Column="0" Content="winget 安装 Chrome" Background="#10B981" Margin="0,0,4,0" Click="BtnInstallChrome_Click"/>
                                    <Button Grid.Column="1" Content="设为默认浏览器" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnSetDefaultBrowser_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 5: 微软 OneDrive 卸载与导航栏图标管理 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="☁️ 5. 微软 OneDrive 卸载与资源管理器导航栏清理" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (恢复本地文档与桌面目录结构，移除导航窗格常驻图标)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtOneDriveStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshOneDriveStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="卸载 OneDrive 并清理资源管理器图标" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                            <TextBlock Text="执行系统自带卸载程序，并清理注册表中资源管理器侧边栏的同步目录图标。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnUninstallOneDrive" Grid.Column="1" Content="🗑️ 卸载 OneDrive 并清理侧边栏" Background="#EF4444" Click="BtnUninstallOneDrive_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 6: 开机自启动项 (Startup Items) 管理 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🚀 6. 开机自启动项管理" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (审查注册表 Run 启动项，管理常驻后台进程)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 刷新启动项" Style="{DynamicResource SecondaryButton}" Click="BtnReloadStartup_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridStartupItems" AutoGenerateColumns="False" IsReadOnly="True" Height="150"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="32" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="自启程序名称" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" Width="130"/>
                            <DataGridTextColumn Header="执行命令行与路径" Binding="{Binding Command}" Width="*"/>
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 移除" Style="{DynamicResource SecondaryButton}" Height="24" Padding="6,0"
                                                Click="BtnDeleteStartupItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 7: 官方包管理器 winget 使用指南与技术说明 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="📦 7. Windows 官方包管理器 winget 实操指南与技术说明" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="winget 是 Windows 原生软件包管理器，直接从各软件官方源或认证清单拉取纯净安装包。在管理软件更新时，了解其底层机制有助于更稳定地维护系统环境。"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 技术说明与使用建议卡片 -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 关于批量更新命令【winget upgrade --all】的技术机制与注意事项：" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <TextBlock Text="• 适用场景：适用于全新装机或测试环境快速部署最新软件。在已配置复杂开发依赖（如特定版本 Python/Node/JDK）的生产环境中，建议进行受控更新。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="• 版本检测机制：若搭配【--include-unknown】参数，winget 会将本地注册表中未规范记录版本号的应用一律视作需要更新，可能导致部分软件在每次执行时重复下载安装。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="• 交互式提权说明：Windows 软件安装包格式多样（exe/msi 等），部分安装程序即便带有静默参数仍需弹出用户账户控制 (UAC) 确认窗口。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="• 推荐工作流：建议先使用【winget upgrade】查看候选清单，使用【winget pin】锁定需要保留固定版本的生产力软件，再对通用工具进行单包更新。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 正确实战指令推荐 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="✅ 步骤 1：仅查看可更新列表 (安全，仅检测不改动系统):" FontWeight="Bold" FontSize="12" Foreground="#166534"/>
                                <TextBox Text="winget upgrade" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 复制查列表命令" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetCheck_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="🔒 步骤 2：使用 pin 锁定核心依赖 (防止 Python/JDK 被意外升挂):" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBox Text="winget pin add --id Python.Python.3.10" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 复制锁定命令" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetPin_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="🎯 步骤 3：针对性单包更新 (推荐做法，明确受控):" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBox Text="winget upgrade --id 7zip.7zip" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 复制单包更新" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetUpgradeSingle_Click"/>
                    </Grid>

                    <TextBlock Text="常用纯净软件一键安装命令卡片 (点击一键复制)：" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <!-- VSCode -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visual Studio Code" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Microsoft.VisualStudioCode" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Microsoft.VisualStudioCode"/>
                                </Grid>
                            </Border>

                            <!-- Git -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Git 版本控制" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Git.Git" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
