                            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="🔒 步骤 2：使用 pin 锁定核心依赖 (防止特定版本被意外升级):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBox Text="winget pin add --id Python.Python.3.10" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="📋 锁版本" Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetPin_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="🎯 步骤 3：针对性单包更新 (推荐做法，明确受控):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBox Text="winget upgrade --id 7zip.7zip" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="📋 单包更新" Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetUpgradeSingle_Click"/>
                        </Grid>

                        <TextBlock Text="常用纯净开发与办公软件一键安装命令 (点击 📋 复制)：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Visual Studio Code" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install Microsoft.VisualStudioCode" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Microsoft.VisualStudioCode"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Git 版本控制" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install Git.Git" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Git.Git"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Google Chrome 浏览器" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install Google.Chrome" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Google.Chrome"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="7-Zip 开源极简解压" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install 7zip.7zip" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install 7zip.7zip"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Node.js LTS 运行环境" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install OpenJS.NodeJS.LTS" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install OpenJS.NodeJS.LTS"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="微信 PC 官方纯净版" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="winget install Tencent.WeChat" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Tencent.WeChat"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: 卸载残留与注册表清理 -->
            <TabItem Header="🧽 卸载残留注册表清理">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部说明卡片 -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="🧽 软件卸载残留注册表深度扫描与安全清理" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <TextBlock Text=" (穿透扫描无效卸载条目、失效自启动项、死链打开方式、MuiCache 运行缓存)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="全面检测因非规范卸载留下的幽灵应用、已删程序自启残留、无效扩展名右键关联等。支持预览勾选并安全删除，绝不触碰系统受保护根项。"
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="BtnScanResiduals" Content="🔍 深度扫描残留" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Click="BtnScanResiduals_Click"/>
                                <Button x:Name="BtnCleanResiduals" Content="🗑️ 清理选中残留" Background="#EF4444" Click="BtnCleanResiduals_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 操作与统计工具条 -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtResidualsSummary" Grid.Column="0" Text="💡 点击右上角【🔍 深度扫描残留】开始分析系统注册表中的死链与残留信息..." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="☑️ 全选" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,2" FontSize="11" Click="BtnSelectAllResiduals_Click"/>
                                <Button Content="⬜ 反选" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11" Click="BtnInvertSelectResiduals_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid 表格 -->
                    <DataGrid Grid.Row="2" x:Name="GridResiduals" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushTableBorder}" RowHeight="36" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="残留类别" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名称 / 标识" Binding="{Binding DisplayName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="注册表路径" Binding="{Binding FullKeyPath}" Width="250" IsReadOnly="True"/>
                            <DataGridTextColumn Header="失效判定原因" Binding="{Binding Reason}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
