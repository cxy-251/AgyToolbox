<UserControl x:Class="AgyToolbox.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1600" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🧹 步骤一：新机开荒与预装精简 (Debloat &amp; 开源替代)" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="买到新电脑第一件事：全盘去魅与卸载臃肿组件。透视微软全家桶 UWP、品牌商 OEM 毒瘤后台（如麦咖啡、奥创中心）、锁死后台静默推广下载，并剥离 Edge 与 OneDrive。软件安装首选原生 winget，纯净无广告！"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块 1: 预装 UWP 全家桶透视与一键卸载 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📋 1. Windows 预装全家桶透视与一键卸载" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (清晰解释官方用途、为什么卸载、以及开源优质替代品)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="⚡ 重新扫描预装状态" Style="{DynamicResource SecondaryButton}" Click="BtnScanUwp_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridUwpApps" AutoGenerateColumns="False" IsReadOnly="True" Height="280"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="40" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="150"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="75"/>
                            <DataGridTextColumn Header="它是干什么的 (官方用途)" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="为什么卸载 (影响分析)" Binding="{Binding DebloatAdvice}" Width="2*"/>
                            <DataGridTextColumn Header="开源/轻量优质替代方案" Binding="{Binding OpenSourceAlternative}" Width="2*"/>
                            <DataGridTemplateColumn Header="安装状态" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 卸载" Style="{DynamicResource SecondaryButton}" Height="26" Padding="6,0"
                                                IsEnabled="{Binding IsInstalled}" Click="BtnUninstallSingleUwp_Click"
                                                Tag="{Binding PackagePrefix}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 2: OEM 品牌厂商预装全家桶与麦咖啡 (McAfee) 避坑排查 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ 2. OEM 品牌机毒瘤预装与麦咖啡 (McAfee) 深度避坑" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (新电脑开机卡顿元凶，常驻 20+ 无用服务)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 扫描 OEM 毒瘤" Style="{DynamicResource SecondaryButton}" Click="BtnScanOem_Click"/>
                    </Grid>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚠️ 新机特别预警：关于麦咖啡 (McAfee) 和华硕奥创中心 (Armoury Crate) 的巨大坑点：" FontWeight="Bold" FontSize="12" Foreground="#B91C1C" Margin="0,0,0,4"/>
                            <TextBlock Text="• 麦咖啡全家桶：试用到期后天天弹窗恐吓。普通控制面板卸载常残留驱动，导致频繁断网！若已中招，建议使用官方 MCPR (McAfee Consumer Product Removal Tool) 深度清扫干净。" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap"/>
                            <TextBlock Text="• 华硕奥创中心：常驻数十个后台守护服务，占用上 GB 内存且偶发导致显卡掉驱动。华硕天选/ROG 极客强烈推荐使用开源极简的【G-Helper】直接完美平替，内存立省 95%！" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridOemApps" AutoGenerateColumns="False" IsReadOnly="True" Height="170"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="36" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="所属品牌" Binding="{Binding Vendor}" Width="80"/>
                            <DataGridTextColumn Header="后台毒瘤危害" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="极客清理与开源平替建议" Binding="{Binding DebloatAdvice}" Width="2*"/>
                            <DataGridTemplateColumn Header="当前状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 3: 锁死 Win11 后台暗度陈仓静默安装策略 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 3. 锁死 Win11 后台暗度陈仓静默安装策略 (防偷偷下载 TikTok/Spotify)" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock x:Name="TxtSilentAppStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="新机连网后，微软会在后台静默推送下载预设的商业合作应用，并在锁屏和开始菜单展示商业推广推荐。一键关闭 SilentInstalledAppsEnabled 策略，将静默流氓行为锁死在摇篮中！"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnToggleSilentApps" Grid.Column="1" Content="切换锁死状态" VerticalAlignment="Center" Click="BtnToggleSilentApps_Click"/>
                </Grid>
            </Border>

            <!-- 板块 4: 浏览器大换血：彻底卸载 Edge & 替换为纯净 Chrome -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🌐 4. 浏览器大换血：彻底卸载 Edge 并替换为 Chrome" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (专业保留 WebView2 运行时，防第三方桌面软件崩溃)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtBrowserStatus" Text="[检测浏览器状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBrowserStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="💡 避坑原则：本工具仅卸载 Edge 浏览器外壳，严格保留底层 WebView2 共享库（防止微信、网易云等软件直接白屏崩溃），并自动写入 DoNotUpdateToEdgeWithChromium 策略阻止 Windows Update 下周偷偷重装！" FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卸载 Edge -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🗑️ 彻底卸载 Microsoft Edge" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock Text="调用官方静默卸载器，清除桌面图标与启动项，策略锁定防复活。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnUninstallEdge" Content="立即卸载 Edge 浏览器" Background="#EF4444" Click="BtnUninstallEdge_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 安装 Chrome & 设为默认 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🚀 替换为 Google Chrome 官方纯净版" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                <TextBlock Text="通过 winget 直接从 Google 官方源拉取安装包，静默无捆绑安全安装。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnInstallChrome" Grid.Column="0" Content="winget 安装 Chrome" Background="#10B981" Margin="0,0,4,0" Click="BtnInstallChrome_Click"/>
                                    <Button Grid.Column="1" Content="设为默认浏览器" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnSetDefaultBrowser_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 5: 微软 OneDrive 深度卸载与去盘符绑定 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="☁️ 5. 微软 OneDrive 深度卸载与导航栏图标清除" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (解除桌面/文档强制云端绑架，抹除资源管理器幽灵蓝云)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtOneDriveStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshOneDriveStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="彻底移除 OneDrive 云盘程序" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                            <TextBlock Text="执行系统原生卸载并完全清理残留注册表项与侧边栏常驻图标，避免桌面变成 C:\Users\xxx\OneDrive\Desktop 引发各种开发编译报错。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnUninstallOneDrive" Grid.Column="1" Content="🗑️ 一键彻底卸载 OneDrive 并清侧边栏" Background="#EF4444" Click="BtnUninstallOneDrive_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 6: 开机自启动项 (Startup Items) 深度透视与管理 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🚀 6. 开机自启动项深度透视与一键清理" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (扫描注册表 Run 启动项，缩短开机时间从 40s 到 10s)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="🔄 刷新启动项" Style="{DynamicResource SecondaryButton}" Click="BtnReloadStartup_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridStartupItems" AutoGenerateColumns="False" IsReadOnly="True" Height="150"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="32" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="自启程序名称" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" Width="130"/>
                            <DataGridTextColumn Header="执行命令行与路径" Binding="{Binding Command}" Width="*"/>
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 删自启" Style="{DynamicResource SecondaryButton}" Height="24" Padding="6,0"
                                                Click="BtnDeleteStartupItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 板块 7: 官方原生包管理器 winget 使用指南 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="📦 7. 极简主义必知：Windows 官方原生包管理器 winget 使用指南" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="告别百度搜索去各种‘软件下载站’下载全家桶流氓软件！Windows 官方自带 winget，一行命令直接从源站拉取纯净安装包静默安装。"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="🌟 一行命令全盘静默更新所有软件 (极客最爱):" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBox Text="winget upgrade --all --include-unknown" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 复制更新命令" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetUpgrade_Click"/>
                    </Grid>

                    <TextBlock Text="常用纯净软件一键安装命令卡片 (点击一键复制)：" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,8,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <!-- VSCode -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visual Studio Code" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Microsoft.VisualStudioCode" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Microsoft.VisualStudioCode"/>
                                </Grid>
                            </Border>

                            <!-- Git -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Git 版本控制" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Git.Git" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Git.Git"/>
                                </Grid>
                            </Border>

                            <!-- Chrome -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Google Chrome 浏览器" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Google.Chrome" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Google.Chrome"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 右侧列 -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <!-- 7-Zip -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="7-Zip 开源极简解压" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install 7zip.7zip" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install 7zip.7zip"/>
                                </Grid>
                            </Border>

                            <!-- Node.js LTS -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Node.js LTS 运行环境" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install OpenJS.NodeJS.LTS" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install OpenJS.NodeJS.LTS"/>
                                </Grid>
                            </Border>

                            <!-- WeChat -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="微信 PC 官方纯净版" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Tencent.WeChat" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
