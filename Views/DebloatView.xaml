<UserControl x:Class="AgyToolbox.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💡 新电脑到手第一件事：去魅精简与告别臃肿" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="很多刚买的新电脑自带了大量微软全家桶 UWP 应用（如人脉、天气、小娜、Xbox 录屏、资讯新闻等）。它们常驻后台自启、静默拉取推送、消耗内存。本模块帮助你透视每一个预装软件到底有什么用，按需一键干净移除！"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="结合现代极客理念：软件安装首选官方原生包管理器 winget，干净无捆绑、不弹窗、不写死垃圾，甚至连臃肿的应用商店都可以放心精简掉！"
                               FontSize="12" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 预装应用列表 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📋 Windows 常见预装软件透视与一键卸载" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (清晰解释用途与卸载影响，彻底清理当前及新用户模板)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="⚡ 重新扫描预装状态" Style="{DynamicResource SecondaryButton}" Click="BtnScanUwp_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridUwpApps" AutoGenerateColumns="False" IsReadOnly="True" Height="300"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="42" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="80"/>
                            <DataGridTextColumn Header="它是干什么的 (官方用途)" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="为什么卸载 (影响分析)" Binding="{Binding DebloatAdvice}" Width="2*"/>
                            <DataGridTextColumn Header="开源/轻量优质替代方案" Binding="{Binding OpenSourceAlternative}" Width="2*"/>
                            <DataGridTemplateColumn Header="安装状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 卸载" Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0"
                                                IsEnabled="{Binding IsInstalled}" Click="BtnUninstallSingleUwp_Click"
                                                Tag="{Binding PackagePrefix}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 浏览器置换板块：彻底卸载 Edge & 替换为纯净 Chrome -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🌐 浏览器大换血：彻底卸载 Edge 并替换为 Chrome" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (专业保留 WebView2 运行时，防第三方软件崩溃)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtBrowserStatus" Text="[正在检测浏览器状态...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBrowserStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 为什么系统设置里 Edge 无法卸载？以及专业卸载避坑要点：" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,0,4"/>
                            <TextBlock Text="1. 微软在非欧盟地区强行将 Edge 绑定为系统核心组件，常规设置面板将卸载按钮置灰禁用。" FontSize="11" Foreground="#78350F"/>
                            <TextBlock Text="2. 绝不能暴力删文件夹！很多小白脚本直接把包含 WebView2 的整个目录删掉，导致微信、钉钉、网易云等依赖 WebView2 的桌面软件直接白屏崩溃。本工具仅卸载 Edge 浏览器主体，严格保留 WebView2 运行库。" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                            <TextBlock Text="3. 防死灰复燃：卸载时自动向注册表写入 DoNotUpdateToEdgeWithChromium 策略，防止 Windows Update 下周偷偷重新安装 Edge！" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卸载 Edge -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🗑️ 彻底卸载 Microsoft Edge" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock Text="调用官方静默卸载器，移除浏览器主体、桌面和任务栏图标，并锁定注册表策略阻止自动重装。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="BtnUninstallEdge" Content="立即卸载 Edge 浏览器" Background="#EF4444" Click="BtnUninstallEdge_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 安装 Chrome & 设为默认 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🚀 替换为 Google Chrome 官方纯净版" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                <TextBlock Text="通过 winget 直接从 Google 官方服务器拉取原生安装包，静默完成安装并可一键设为默认。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnInstallChrome" Grid.Column="0" Content="winget 一键安装 Chrome" Background="#10B981" Margin="0,0,4,0" Click="BtnInstallChrome_Click"/>
                                    <Button Grid.Column="1" Content="设为默认浏览器" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnSetDefaultBrowser_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 微软 OneDrive 彻底卸载与去盘符绑定 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="☁️ 微软 OneDrive 深度卸载与导航栏图标清除" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock Text=" (解除桌面/文档强制同步，彻底抹除资源管理器幽灵蓝云图标)" FontSize="12" Foreground="#64748B" Margin="6,3,0,0"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtOneDriveStatus" Text="[检测中...]" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshOneDriveStatus_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 为什么新机用户大多想移除 OneDrive？以及卸载痛点解释：" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,0,4"/>
                            <TextBlock Text="1. 强制绑架路径：新机开机诱导开启云同步，将电脑【桌面】和【文档】路径强行篡改为 C:\Users\xxx\OneDrive\Desktop，导致许多开发工具/游戏因路径含空格或深层目录报错。" FontSize="11" Foreground="#78350F"/>
                            <TextBlock Text="2. 资源管理器幽灵图标：在常规设置中卸载 OneDrive 后，资源管理器左侧导航树仍然常驻一个无法右键删除的蓝云图标，严重影响强迫症体验！" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                            <TextBlock Text="3. 本工具专业处理：结束后台进程 -> 调用官方静默卸载器 -> 移除自启动项 -> 清除 CLSID 命名空间注册表，彻底从导航树抹去图标。" FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="彻底移除 OneDrive 云盘程序" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                            <TextBlock Text="执行系统原生卸载并完全清理残留注册表项与侧边栏常驻图标。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnUninstallOneDrive" Grid.Column="1" Content="🗑️ 一键彻底卸载 OneDrive 并清除侧边栏" Background="#EF4444" Click="BtnUninstallOneDrive_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- winget 极简包管理教学与常用指令 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="📦 极简主义必知：Windows 官方原生包管理器 winget 使用指南" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="告别百度搜索去各种‘软件下载站’下载全家桶流氓软件！Windows 10/11 官方自带 winget，一行命令直接从源站拉取纯净安装包静默安装。"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="🌟 一行命令全盘静默更新所有软件 (极客最爱):" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBox Text="winget upgrade --all --include-unknown" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 复制更新命令" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyWingetUpgrade_Click"/>
                    </Grid>

                    <TextBlock Text="常用纯净软件一键安装命令卡片 (点击一键复制)：" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,8,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <!-- VSCode -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visual Studio Code" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Microsoft.VisualStudioCode" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Microsoft.VisualStudioCode"/>
                                </Grid>
                            </Border>

                            <!-- Git -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Git 版本控制" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Git.Git" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Git.Git"/>
                                </Grid>
                            </Border>

                            <!-- Chrome -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Google Chrome 浏览器" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Google.Chrome" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Google.Chrome"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 右侧列 -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <!-- 7-Zip -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="7-Zip 开源极简解压" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install 7zip.7zip" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install 7zip.7zip"/>
                                </Grid>
                            </Border>

                            <!-- Node.js LTS -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Node.js LTS 运行环境" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install OpenJS.NodeJS.LTS" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install OpenJS.NodeJS.LTS"/>
                                </Grid>
                            </Border>

                            <!-- WeChat -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="微信 PC 官方纯净版" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="winget install Tencent.WeChat" FontFamily="Consolas" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopySnippet_Click" Tag="winget install Tencent.WeChat"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
