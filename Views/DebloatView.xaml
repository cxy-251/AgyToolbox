<UserControl x:Class="AgyToolbox.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="{DynamicResource BrushAlertBlueBg}" BorderBrush="{DynamicResource BrushAlertBlueBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🧹 步骤一：新机开荒与预装管理 (Debloat &amp; 应用精简)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAlertBlueText}" Margin="0,0,0,4"/>
                <TextBlock Text="系统初始化与预装组件管理：提供 Windows 预装 UWP 应用管理、品牌厂商预装附带软件排查、关闭系统后台静默推荐安装策略，以及浏览器和 OneDrive 的管理选项。推荐使用 Windows 原生包管理器 winget 维护应用。"
                           FontSize="12" Foreground="{DynamicResource BrushAlertBlueText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 4 个功能横向子标签 -->
        <TabControl Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 预装应用清理 (UWP + OEM) -->
            <TabItem Header="📦 预装应用清理">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 板块 1: 预装 UWP 应用管理 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📋 1. Windows 预装应用查看与按需卸载" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (官方用途说明、卸载影响评估与替代建议)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="⚡ 重新扫描预装状态" Style="{DynamicResource SecondaryButton}" Click="BtnScanUwp_Click"/>
                                </Grid>

                                <DataGrid x:Name="GridUwpApps" AutoGenerateColumns="False" IsReadOnly="True" Height="240"
                                          Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" RowHeight="38" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="140"/>
                                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="70"/>
                                        <DataGridTextColumn Header="官方用途说明" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="卸载影响分析" Binding="{Binding DebloatAdvice}" Width="2*"/>
                                        <DataGridTextColumn Header="开源/轻量替代建议" Binding="{Binding OpenSourceAlternative}" Width="2*"/>
                                        <DataGridTemplateColumn Header="安装状态" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="操作" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ActionButtonText}" Style="{DynamicResource SecondaryButton}" Height="24" Padding="6,0"
                                                            IsEnabled="{Binding CanUninstall}" Click="BtnUninstallSingleUwp_Click"
                                                            Tag="{Binding PackagePrefix}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 板块 2: OEM 品牌厂商预装软件 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 2. OEM 品牌厂商预装管理软件排查与建议" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (分析后台服务与开销，提供轻量替代)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🔄 扫描预装软件" Style="{DynamicResource SecondaryButton}" Click="BtnScanOem_Click"/>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 常见厂商预装软件特性与处理说明：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>
                                        <TextBlock Text="• 麦咖啡 (McAfee)：品牌机预装试用版包含多项实时监控服务。常规卸载后若有网络过滤残留，建议使用其官方 MCPR 工具清理。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 华硕奥创中心 (Armoury Crate)：集成了较多驱动守护进程。若仅需调节基础性能与背光，开源工具 G-Helper 是极佳的低开销替代。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="GridOemApps" AutoGenerateColumns="False" IsReadOnly="True" Height="160"
                                          Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" RowHeight="34" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="180"/>
                                        <DataGridTextColumn Header="所属品牌" Binding="{Binding Vendor}" Width="80"/>
                                        <DataGridTextColumn Header="软件特性与资源开销" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="维护建议与开源替代方案" Binding="{Binding DebloatAdvice}" Width="2*"/>
                                        <DataGridTemplateColumn Header="当前状态" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 板块 3: Windows 历史遗留可选功能 (FOD) 精简 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🧩 3. Windows 历史遗留可选功能 (FOD / Features On Demand) 精简" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (通过原生 DISM 机制卸载旧版 WMP、IE 模式、传真等冗余功能)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="⚡ 重新扫描可选功能" Style="{DynamicResource SecondaryButton}" Click="BtnScanFod_Click"/>
                                </Grid>

                                <DataGrid x:Name="GridFodFeatures" AutoGenerateColumns="False" IsReadOnly="True" Height="170"
                                          Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" RowHeight="34" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="可选功能名称" Binding="{Binding DisplayName}" Width="210"/>
                                        <DataGridTextColumn Header="官方用途说明" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="精简建议" Binding="{Binding DebloatAdvice}" Width="2*"/>
                                        <DataGridTemplateColumn Header="当前状态" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="操作" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️ 卸载" Style="{DynamicResource SecondaryButton}" Height="24" Padding="6,0"
                                                            IsEnabled="{Binding IsInstalled}" Click="BtnUninstallFod_Click"
                                                            Tag="{Binding CapabilityName}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 板块 4: 原生开发虚拟化与底层虚拟机组件剥离 (WSL / Hyper-V / 虚拟机平台 / 沙盒) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ 4. 原生开发虚拟化与底层组件剥离 (WSL / Hyper-V / 沙盒)" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (面向纯原生开发机，关闭无用虚拟化层以消除 CPU 调度损耗与后台常驻)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⚡ 一键关闭全部虚拟化组件" Background="#EF4444" Margin="0,0,6,0" Click="BtnDisableAllVirt_Click"/>
                                        <Button Content="🔄 刷新状态" Style="{DynamicResource SecondaryButton}" Click="BtnScanVirt_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushAlertBlueBg}" BorderBrush="{DynamicResource BrushAlertBlueBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 原生开发减负说明：若本机专注于 Windows 本地原生软件开发（C/C++、.NET、Rust、Go 等），无需运行 Linux 虚拟机容器或 Windows 沙盒。通过 DISM 关闭这些底层平台，可避免 Windows 运行在 Hypervisor 根分区之上，彻底移除后台虚拟磁盘与网络桥接驱动常驻。" FontSize="11" Foreground="{DynamicResource BrushAlertBlueText}" TextWrapping="Wrap"/>
                                </Border>

                                <DataGrid x:Name="GridVirtFeatures" AutoGenerateColumns="False" IsReadOnly="True" Height="170"
                                          Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" RowHeight="34" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BrushTableBorder}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="虚拟化组件名称" Binding="{Binding DisplayName}" Width="230"/>
                                        <DataGridTextColumn Header="底层功能与影响" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="原生剥离建议" Binding="{Binding DebloatAdvice}" Width="2*"/>
                                        <DataGridTemplateColumn Header="当前状态" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="操作" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="关闭" Style="{DynamicResource SecondaryButton}" Height="24" Padding="6,0"
                                                            IsEnabled="{Binding IsEnabled}" Click="BtnDisableSingleVirt_Click"
                                                            Tag="{Binding FeatureName}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 浏览器与云盘 -->
            <TabItem Header="🌐 浏览器与云盘">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 浏览器管理 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🌐 浏览器生态管理：Edge 卸载与 Chrome 部署" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (严格保留 WebView2 运行时，保障第三方桌面客户端正常运行)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBrowserStatus" Text="[检测浏览器状态...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshBrowserStatus_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushAlertYellowBg}" BorderBrush="{DynamicResource BrushAlertYellowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 技术说明：卸载操作仅移除 Edge 浏览器主体外壳，严格保留底层的 WebView2 运行时（确保基于 WebView2 的第三方应用正常工作），并配置策略防止后续版本更新自动重新部署。" FontSize="11" Foreground="{DynamicResource BrushAlertYellowText}" TextWrapping="Wrap"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 卸载 Edge -->
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="🗑️ 卸载 Microsoft Edge 浏览器主体" FontWeight="Bold" FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                            <TextBlock Text="调用官方静默卸载命令，移除应用外壳与快捷方式，并配置策略阻止自动重新安装。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Button x:Name="BtnUninstallEdge" Content="立即卸载 Edge 浏览器" Background="#EF4444" Click="BtnUninstallEdge_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 安装 Chrome & 设为默认 -->
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🚀 安装 Google Chrome 官方纯净版" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,4"/>
                                            <TextBlock Text="通过 winget 直接从 Google 官方源拉取安装包，执行静默安装。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnInstallChrome" Grid.Column="0" Content="winget 安装 Chrome" Background="#10B981" Margin="0,0,4,0" Click="BtnInstallChrome_Click"/>
                                                <Button Grid.Column="1" Content="设为默认浏览器" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnSetDefaultBrowser_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- OneDrive 管理 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="☁️ 微软 OneDrive 卸载与资源管理器导航栏清理" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (恢复本地文档/桌面目录结构，移除侧边栏图标)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtOneDriveStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Click="BtnRefreshOneDriveStatus_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="卸载 OneDrive 并清理资源管理器图标" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                                            <TextBlock Text="执行系统自带卸载程序，并清理注册表中资源管理器侧边栏的同步目录图标。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnUninstallOneDrive" Grid.Column="1" Content="🗑️ 卸载 OneDrive 并清理侧边栏" Background="#EF4444" Click="BtnUninstallOneDrive_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 商业推广、遥测精简与自启 -->
            <TabItem Header="🚀 商业推广、遥测与自启">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 板块 1: 商业推广与 UI 广告全面阻断 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🔒 1. Windows 商业推广与 UI 广告全面阻断" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (禁用静默推广下载、开始菜单建议、锁屏小贴士与小组件资讯流)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🛡️ 一键关闭全部广告" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Click="BtnDisableAllAds_Click"/>
                                        <Button Content="🔄 恢复默认" Style="{DynamicResource SecondaryButton}" Click="BtnRestoreAllAds_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 1.1 Content Delivery Manager 静默安装 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="后台静默自动下载安装推广应用 (SilentInstalledApps)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock x:Name="TxtSilentAppStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="阻止系统在联网后通过内容交付通道静默下载 Candy Crush 等第三方应用与推广套件。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnToggleSilentApps" Grid.Column="1" Content="切换状态" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" VerticalAlignment="Center" Click="BtnToggleSilentApps_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 1.2 开始菜单应用推荐 -->
                                        <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushCardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
