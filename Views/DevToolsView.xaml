<UserControl x:Class="AgyToolbox.Views.DevToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 第一部分：文件指纹与 Hash 比对 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔒 离线文件指纹计算与哈希防篡改比对" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="本地高速单次流式读取，一网打尽 MD5 / SHA1 / SHA256 / SHA512，自动绿色/红色高亮比对结果。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtHashFilePath" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Text="点击右侧选择文件，或直接拖拽文件到此处..." IsReadOnly="True" AllowDrop="True"
                                 PreviewDragOver="TxtHashFilePath_PreviewDragOver" Drop="TxtHashFilePath_Drop"/>
                        <Button Grid.Column="1" Content="📁 选择文件" Margin="10,0,0,0" Click="BtnSelectHashFile_Click"/>
                    </Grid>

                    <!-- 哈希展示网格 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- MD5 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MD5:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHashMd5" Grid.Row="0" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,2,6,2"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Click="BtnCopyMd5_Click"/>

                            <!-- SHA1 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA1:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBox x:Name="TxtHashSha1" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,4,6,2"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Margin="0,4,0,0" Click="BtnCopySha1_Click"/>

                            <!-- SHA256 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA256:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBox x:Name="TxtHashSha256" Grid.Row="2" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,4,6,2"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Margin="0,4,0,0" Click="BtnCopySha256_Click"/>

                            <!-- SHA512 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA512:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBox x:Name="TxtHashSha512" Grid.Row="3" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,4,6,0"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Margin="0,4,0,0" Click="BtnCopySha512_Click"/>
                        </Grid>
                    </Border>

                    <!-- 比对框 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="官方期望哈希比对：" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtExpectedHash" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                 TextChanged="TxtExpectedHash_TextChanged"/>
                    </Grid>
                    <TextBlock x:Name="TxtHashCompareResult" FontSize="12" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 第二部分：离线编解码与时间戳 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="🔤 纯本地快速编解码 &amp; 时间戳 / GUID 工具" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="数据完全在本地内存处理，无需联网，防止敏感 Token 或密钥泄露给第三方在线网站。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 输入框 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="输入源文本：" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtCodecInput" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6"/>
                        </StackPanel>

                        <!-- 编解码按钮 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="Base64 编码 ➔" Margin="0,0,0,4" Click="BtnBase64Encode_Click"/>
                            <Button Content="Base64 解码 ➔" Margin="0,0,0,4" Click="BtnBase64Decode_Click"/>
                            <Button Content="URL 编码 ➔" Margin="0,0,0,4" Click="BtnUrlEncode_Click"/>
                            <Button Content="URL 解码 ➔" Margin="0,0,0,0" Click="BtnUrlDecode_Click"/>
                        </StackPanel>

                        <!-- 输出框 -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="转换结果：" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <Button Content="📋 复制" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Click="BtnCopyCodecOutput_Click"/>
                            </Grid>
                            <TextBox x:Name="TxtCodecOutput" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" IsReadOnly="True" Background="White"/>
                        </StackPanel>
                    </Grid>

                    <!-- 时间戳与 GUID -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 时间戳转换 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="⏰ Unix 时间戳 ↔ 本地北京时间" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="TxtTimestampInput" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
                                    <Button Content="当前时间戳" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Click="BtnFillCurrentTs_Click"/>
                                </Grid>
                                <Button Content="转换时间 ➔" Click="BtnConvertTs_Click" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtTsResult" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="12" Padding="4"/>
                            </StackPanel>
                        </Border>

                        <!-- GUID 生成器 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🎲 随机 GUID / UUID 生成器" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkGuidUpper" Content="全大写" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="ChkGuidNoHyphen" Content="去除横线 (N格式)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="生成全新 GUID" Click="BtnGenGuid_Click"/>
                                </WrapPanel>
                                <Grid>
                                    <TextBox x:Name="TxtGuidResult" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="12" Padding="6,4"/>
                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Click="BtnCopyGuid_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
