<UserControl x:Class="AgyToolbox.Views.BuiltIn.SecurityAuthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="0,0,0,24">

            <!-- 模块概述 -->
            <Border Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🛡️ 权限控制、ACL 访问列表夺取与原生安全审计" FontSize="14" FontWeight="Bold" Foreground="#9D174D" Margin="0,0,0,4"/>
                    <TextBlock Text="解决系统残留文件提示「需要来自 TrustedInstaller 的权限」无法删除的困局。提供无需第三方工具的原生 SHA256 哈希校验 (CertUtil) 与特权令牌审计。"
                               FontSize="11" Foreground="#831843" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 工具 1: takeown 与 icacls 权限夺取与重置 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="1. 所有权夺取与 ACL 访问控制列表重置 (takeown + icacls)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#FCE7F3" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="彻底解决 TrustedInstaller 拦截" FontSize="10" Foreground="#BE185D" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="当删除或修改系统遗留目录（如 WindowsApps、旧系统残留 Windows.old）时，即使是本地管理员也会被拒绝访问。按顺序执行以下两条命令即可夺取完整控制权。"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 步骤一: 夺取所有权 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="步骤一：夺取物理所有权 (takeown)" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="将文件所有者从 TrustedInstaller 强行转让给当前本地 Administrators 组 (/A)，递归应用 (/R)。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="takeown /F &quot;C:\Target&quot; /R /A /D Y" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#F8FAFC" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="takeown /F &quot;C:\TargetDirectory&quot; /R /A /D Y" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 步骤二: 授予管理员完全控制 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="步骤二：授予完全控制权 (icacls)" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="授予 Administrators 组完全控制权限 (:F)，忽略错误继续执行 (/C)，递归处理子项 (/T)。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="icacls &quot;C:\Target&quot; /grant administrators:F /T /C" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#F8FAFC" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="icacls &quot;C:\TargetDirectory&quot; /grant administrators:F /T /C" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 2: certutil 原生哈希校验与编解码 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="2. 原生证书与文件哈希校验实用程序 (certutil.exe)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="免装第三方 Hash 工具" FontSize="10" Foreground="#15803D" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="下载安装包、固件或系统镜像后，无需下载 HashTab 等软件，Windows 自带的 certutil 可瞬间计算 SHA256 / MD5 / SHA1，且支持 Base64 文件编解码。"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 A: SHA256 校验 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🔒 极速计算 SHA256 哈希值" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="核对官方发布的校验码，防止安装包被供应链篡改或网络传输损坏。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="certutil -hashfile &quot;app.exe&quot; SHA256" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#F8FAFC" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="certutil -hashfile &quot;app.exe&quot; SHA256" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 B: Base64 编解码 -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📦 文件 Base64 快速编解码" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="纯命令行实现二进制文件与文本 Base64 互转，内网免工具传输小文件必备。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="certutil -encode file.bin out.txt" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#F8FAFC" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="certutil -encode input.bin output.txt" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 3: whoami 令牌特权与安全管理单元 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="3. 安全上下文审计 (whoami) 与系统安全管理控制台" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="审计当前运行终端持有的特权令牌，或打开组策略/用户/证书/恶意软件清除工具。"
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="本地安全策略" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnSecPol_Click"/>
                            <Button Content="用户和组" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnLusrMgr_Click"/>
                            <Button Content="证书管理" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnCertMgr_Click"/>
                            <Button Content="恶意软件删除" Click="BtnMrt_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="📋 whoami 核心特权与完整性级别审计：" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBlock Text="• whoami /priv：查看当前进程持有的特权。若包含 SeDebugPrivilege（调试程序）表示拥有读写其他进程内存的能力。" FontSize="10" Foreground="#475569" Margin="0,1"/>
                            <TextBlock Text="• whoami /groups：核实当前用户属于哪些本地组，以及 Mandatory Label（强制完整性级别：Medium 为普通用户，High 为提升管理员，System 为系统内核级）。" FontSize="10" Foreground="#475569" Margin="0,1"/>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="复制 whoami /priv 审计命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="8,2" Tag="whoami /priv" Click="BtnCopyCmd_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
