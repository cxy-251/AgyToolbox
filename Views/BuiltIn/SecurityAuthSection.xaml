<UserControl x:Class="AgyToolbox.Views.BuiltIn.SecurityAuthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="0,0,0,24">

            <!-- 模块概述 -->
            <Border Background="{DynamicResource BrushAlertPurpleBg}" BorderBrush="{DynamicResource BrushAlertPurpleBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🛡️ 权限控制、ACL 访问列表夺取与原生安全审计" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushAlertPurpleText}" Margin="0,0,0,4"/>
                    <TextBlock Text="解决系统残留文件提示「需要来自 TrustedInstaller 的权限」无法删除的困局。提供无需第三方工具的原生 SHA256 哈希校验 (CertUtil) 与特权令牌审计。"
                               FontSize="11" Foreground="{DynamicResource BrushAlertPurpleText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 工具 1: takeown 与 icacls 权限夺取与重置 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="1. 所有权夺取与 ACL 访问控制列表重置 (takeown + icacls)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="彻底解决 TrustedInstaller 拦截" FontSize="10" Foreground="{DynamicResource BrushAlertPurpleText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="当删除或修改系统遗留目录（如 WindowsApps、旧系统残留 Windows.old）时，即使是本地管理员也会被拒绝访问。按顺序执行以下两条命令即可夺取完整控制权。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 步骤一: 夺取所有权 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="步骤一：夺取物理所有权 (takeown)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="将文件所有者从 TrustedInstaller 强行转让给当前本地 Administrators 组 (/A)，递归应用 (/R)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="takeown /F &quot;C:\Target&quot; /R /A /D Y" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCardBg}" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="takeown /F &quot;C:\TargetDirectory&quot; /R /A /D Y" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 步骤二: 授予管理员完全控制 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="步骤二：授予完全控制权 (icacls)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="授予 Administrators 组完全控制权限 (:F)，忽略错误继续执行 (/C)，递归处理子项 (/T)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="icacls &quot;C:\Target&quot; /grant administrators:F /T /C" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCardBg}" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="icacls &quot;C:\TargetDirectory&quot; /grant administrators:F /T /C" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 2: certutil 原生哈希校验与编解码 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="2. 原生证书与文件哈希校验实用程序 (certutil.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertGreenBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="免装第三方 Hash 工具" FontSize="10" Foreground="{DynamicResource BrushAlertGreenText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="下载安装包、固件或系统镜像后，无需下载 HashTab 等软件，Windows 自带的 certutil 可瞬间计算 SHA256 / MD5 / SHA1，且支持 Base64 文件编解码。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 A: SHA256 校验 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🔒 极速计算 SHA256 哈希值" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="核对官方发布的校验码，防止安装包被供应链篡改或网络传输损坏。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="certutil -hashfile &quot;app.exe&quot; SHA256" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCardBg}" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="certutil -hashfile &quot;app.exe&quot; SHA256" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 B: Base64 编解码 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📦 文件 Base64 快速编解码" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="纯命令行实现二进制文件与文本 Base64 互转，内网免工具传输小文件必备。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="certutil -encode file.bin out.txt" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCardBg}" Margin="0,0,0,6"/>
                                <Button Content="复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="certutil -encode input.bin output.txt" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 3: whoami 令牌特权与安全管理单元 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="3. 安全上下文审计 (whoami) 与系统安全管理控制台" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="审计当前运行终端持有的特权令牌，或打开组策略/用户/证书/恶意软件清除工具。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="本地安全策略" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnSecPol_Click"/>
                            <Button Content="用户和组" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnLusrMgr_Click"/>
                            <Button Content="证书管理" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnCertMgr_Click"/>
                            <Button Content="刷新组策略" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnGpUpdate_Click"/>
                            <Button Content="恶意软件删除" Click="BtnMrt_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="📋 whoami 核心特权与组策略即时刷新：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• whoami /priv：查看当前进程持有的特权。若包含 SeDebugPrivilege（调试程序）表示拥有读写其他进程内存的能力。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• whoami /groups：核实当前用户属于哪些本地组，以及 Mandatory Label（强制完整性级别：Medium 为普通用户，High 为提升管理员，System 为系统内核级）。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• gpupdate /force：强制且立即刷新计算机与用户所有活动目录/本地组策略对象（无需注销或重启系统）。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="复制 whoami /priv" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="8,2" Tag="whoami /priv" Click="BtnCopyCmd_Click" Margin="0,0,6,0"/>
                                <Button Content="复制 gpupdate /force" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="8,2" Tag="gpupdate /force" Click="BtnCopyCmd_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 工具 4: 原生凭据管理器命令行控制 (cmdkey.exe) -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="4. 原生 Windows 凭据管理与自动化凭据注入 (cmdkey.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="凭据保险箱 CLI" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="审查与管理 Windows 凭据管理器中暂存的 Git、网络共享 (SMB)、远程桌面 (RDP) 及域认证凭据。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: cmdkey 列出与审计 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📋 凭据审计与枚举 (cmdkey /list)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="列出当前用户存储的所有凭据目标、用户名与类型。迅速定位过期失效的 Git 凭据或旧局域网共享账户。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="cmdkey /list" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="列出当前存储凭据" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="cmdkey /list" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="清除过期凭据 (/delete)" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="cmdkey /delete:target_name" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: cmdkey 注入与添加 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🔑 自动化注入凭据 (cmdkey /generic)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="通过命令行免交互为远程主机或 Git 仓库预埋登录凭据，极大简化 CI/CD 与多服务器运维脚本。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="cmdkey /generic:TERMSRV/192.168.1.100 /user:admin /pass:secret" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制 RDP 凭据预埋命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="cmdkey /generic:TERMSRV/192.168.1.100 /user:Administrator /pass:Password123" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 5: Win11 24H2+ 原生 sudo 提权控制 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="5. Win11 24H2+ 原生 sudo 提权控制 (sudo.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertPurpleBg}" BorderBrush="{DynamicResource BrushAlertPurpleBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="✨ 24H2 内联提权" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertPurpleText}"/>
                            </Border>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSudoStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnRefreshSudo_Click"/>
                            <Button Content="🟢 启用 (内联当前窗口)" Background="#10B981" Margin="0,0,6,0" Click="BtnEnableSudoNormal_Click"/>
                            <Button Content="🪟 启用 (独立弹窗)" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnEnableSudoWindow_Click"/>
                            <Button Content="🛑 禁用" Background="#EF4444" Click="BtnDisableSudo_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushAlertYellowBg}" BorderBrush="{DynamicResource BrushAlertYellowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="💡 原生 sudo 提权机制：不同于传统右键“以管理员身份运行”需重开窗口丢失工作路径，Win11 原生 sudo 支持在当前终端直接内联提权执行管理员指令，并支持 normal (内联) 与 forceNewWindow (独立弹窗) 运行模式。"
                                   FontSize="10" Foreground="{DynamicResource BrushAlertYellowText}" TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="直接提权启动系统关键服务 (示例):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="sudo net start wuauserv" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制提权启动命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="sudo net start wuauserv" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="命令行查看或配置 sudo 运行模式:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="sudo config --enable normal" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制配置模式命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="sudo config --enable normal" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 6: 原生 OpenSSH 密钥认证与 ssh-agent 凭据托管服务 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="6. 原生 OpenSSH 密钥认证与 ssh-agent 凭据托管服务" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="SSH 密钥保险箱" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSshAgentStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnEnableSshAgent" Content="开启 ssh-agent 自启" Background="#0284C7" Click="BtnEnableSshAgent_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Windows 10/11 内置 OpenSSH 客户端。配置 ssh-agent 服务开机自启后，只需解锁一次私钥口令，即可在所有终端窗口与 Git 推拉中免口令畅行。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="生成现代高安全 Ed25519 密钥 (替代传统 RSA):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制 Ed25519 密钥生成命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="将私钥托管至代理并测试连通性:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="ssh-add ~\.ssh\id_ed25519 &amp;&amp; ssh -T git@github.com" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制添加私钥与测试命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="ssh-add ~\.ssh\id_ed25519 &amp;&amp; ssh -T git@github.com" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 7: 原生后台服务 (sc.exe) 与计划任务 (schtasks.exe) 命令行管理 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBlock Text="7. 原生后台服务 (sc.exe) 与计划任务 (schtasks.exe) 命令行控制" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertYellowBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="免装 NSSM / 自动化调度" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertYellowText}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="系统服务与定时任务原生调度组合。无需依赖第三方工具，直接使用 Windows 原生二进制即可注册系统常驻守护进程与精确定时自动化任务："
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Border Background="{DynamicResource BrushAlertYellowBg}" BorderBrush="{DynamicResource BrushAlertYellowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="⚠️ sc.exe 经典避坑法则：binPath=、start=、DisplayName= 等参数的「等号与参数值之间必须有且仅有一个空格」！例如 binPath= &quot;C:\App.exe&quot;（若写成 binPath=&quot;...&quot; 将报错）。"
                                   FontSize="10" Foreground="{DynamicResource BrushAlertYellowText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="注册自启后台服务 (sc.exe create):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="sc.exe create MyBackend binPath= &quot;C:\App\backend.exe --service&quot; start= auto" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制创建服务命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="sc.exe create MyBackend binPath= &quot;C:\App\backend.exe --service&quot; start= auto" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="配置服务崩溃自动重启 (sc.exe failure):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="sc.exe failure MyBackend reset= 86400 actions= restart/60000/restart/60000/&quot;&quot;/60000" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制配置恢复机制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="sc.exe failure MyBackend reset= 86400 actions= restart/60000/restart/60000/&quot;&quot;/60000" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="创建每日凌晨 02:00 计划任务 (schtasks /create):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="schtasks /create /tn &quot;DailyTask&quot; /tr &quot;powershell.exe -File C:\Scripts\job.ps1&quot; /sc daily /st 02:00 /ru SYSTEM" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制创建计划任务命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="schtasks /create /tn &quot;DailyTask&quot; /tr &quot;powershell.exe -File C:\Scripts\job.ps1&quot; /sc daily /st 02:00 /ru SYSTEM" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="开机/登录自动触发任务 (/sc onlogon):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBox Text="schtasks /create /tn &quot;DevEnvInit&quot; /tr &quot;C:\Tools\init.bat&quot; /sc onlogon /rl HIGHEST" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="4" Margin="0,0,0,4"/>
                                <Button Content="复制开机自启任务命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="schtasks /create /tn &quot;DevEnvInit&quot; /tr &quot;C:\Tools\init.bat&quot; /sc onlogon /rl HIGHEST" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
