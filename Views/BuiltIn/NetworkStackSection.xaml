<UserControl x:Class="AgyToolbox.Views.BuiltIn.NetworkStackSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1500" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="0,0,0,24">

            <!-- 模块概述 -->
            <Border Background="{DynamicResource BrushAlertGreenBg}" BorderBrush="{DynamicResource BrushAlertGreenBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 网络栈探测、路由分流与协议层排障" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}" Margin="0,0,0,4"/>
                    <TextBlock Text="摆脱老旧第三方 Telnet。利用原生 Test-NetConnection 探测 TCP 端口与跃点，结合 MTU 分片验证、双网卡静态路由分流与防火墙策略审查。"
                               FontSize="11" Foreground="{DynamicResource BrushAlertGreenText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 工具 1: Test-NetConnection 原生端口测试 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="1. 原生端口与 TCP 三次握手探测 (Test-NetConnection)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border Background="{DynamicResource BrushAlertGreenBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="彻底取代 Telnet" FontSize="10" Foreground="{DynamicResource BrushAlertGreenText}" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Windows 原生自带强大的 TNC 命令。无需到控制面板开启不安全的 Telnet 客户端，即可精确实时测试远程服务器端口与解析。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="测试 api.github.com:443" VerticalAlignment="Center" Click="BtnTestNetConnection_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="📋 输出指标诊断手册：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• TcpTestSucceeded：若为 True 表示网络链路通畅且目标服务端口正常监听；若为 False 说明中间防火墙阻断、安全组未开或服务宕机。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• RoundTripTime：回环延迟（RTT 毫秒数），评估连通延迟基线。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="复制通用端口探测命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="8,2" Tag="Test-NetConnection -ComputerName 127.0.0.1 -Port 8080 -InformationLevel Detailed" Click="BtnCopyCmd_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 工具 2: ipconfig 与 netsh 协议栈重置 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="2. TCP/IP 协议栈、Winsock 重置与 WLAN 审计 (netsh &amp; ipconfig)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border Background="{DynamicResource BrushAlertYellowBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="网络急救组合拳" FontSize="10" Foreground="{DynamicResource BrushAlertYellowText}" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="处理“微信能发但网页打不开”、“代理软件卸载后全局断网”、“DHCP 租约失效”与“已存无线密码安全审计”。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新 DNS 缓存" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnFlushDns_Click"/>
                            <Button Content="重置 Winsock 目录" Click="BtnResetWinsock_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 A: Winsock -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🔌 Winsock 目录重置" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="清除恶意 LSP 套接字劫持。修复杀毒软件、网络加速器或代理残留导致的套接字异常。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="netsh winsock reset" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,6"/>
                                <Button Content="复制命令 (需重启生效)" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="netsh winsock reset" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 B: TCP/IP 重置 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="🛠️ TCP/IP 协议栈重构" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="将 IPv4/IPv6 协议栈重写并重置注册表表项，解决顽固的无有效 IP 分配故障。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="netsh int ip reset" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,6"/>
                                <Button Content="复制命令 (需重启)" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="netsh int ip reset" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 C: WLAN 审计 -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📶 WLAN Profile 导出审计" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="一键将本机连接过的所有 WiFi 配置以明文 XML 格式批量导出，方便设备迁移与密码备份。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="netsh wlan export profile key=clear" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,6"/>
                                <Button Content="复制导出命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="netsh wlan export profile key=clear folder=C:\" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 3: ping vs tracert vs pathping 链路探测 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="3. 链路层与逐跳排障 (ping vs tracert vs pathping)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="链路分层诊断" FontSize="10" Foreground="{DynamicResource BrushAlertPurpleText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="从 MTU 巨型帧不分片探测，到逐跳路由追踪及长程统计丢包，区分三者的耗时成本与诊断价值。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Border BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="1" CornerRadius="4">
                        <Grid Background="{DynamicResource BrushCardBg}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{DynamicResource BrushTableHeaderBg}" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="命令范例" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="技术机制与核心用途" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="执行成本与耗时" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="3" Text="操作" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="ping -f -l 1472 1.1.1.1" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="设置 DF (不分片) 标志发送 1472 字节载荷。若报「需要拆分数据包」，说明链路上 MTU 小于 1500，导致握手慢或断流。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="秒级完成。" FontSize="10" Foreground="#16A34A"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="ping -f -l 1472 1.1.1.1" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="tracert -d 8.8.8.8" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="追踪到达目标经历的所有路由跃点。加上 -d 可跳过逐跳反向 DNS 解析，将追踪耗时从 1 分钟缩短至 5 秒！" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="约 5~10 秒。" FontSize="10" Foreground="#16A34A"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="tracert -d 8.8.8.8" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,0">
                                <TextBlock Text="pathping 8.8.8.8" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Padding="8,6">
                                <TextBlock Text="先追踪路由路径，随后对沿途每个路由器发送数十个探测包并统计丢包率，精确定位到底是公司网关还是骨干运营商节点在丢包。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" Padding="8,6">
                                <TextBlock Text="耗时较长 (需 3~5 分钟)。" FontSize="10" Foreground="#D97706"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="3" Padding="6" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="pathping 8.8.8.8" Click="BtnCopyCmd_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 工具 4: 静态路由与双网卡分流 + 防火墙 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="4. 静态路由内外网分流 (route.exe) 与高级防火墙 (wf.msc)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="办公场景高频需求：同时连接公司有线内网与手机热点/WiFi 外网，避免内网 IP 冲突走错网关。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开高级安全防火墙" VerticalAlignment="Center" Click="BtnFirewall_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="🧭 双网卡静态路由分流标准化工程模板：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="1. 查阅跃点与网关：执行 route print 查看两张网卡的接口编号 (Interface List) 与当前默认路由跃点 (Metric)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="2. 写入永久路由 (-p)：假设公司内网为 10.0.0.0/8，内网网关为 10.12.1.1，执行以下指令将内网流量锁定走内网卡，其余全部走外网网关：" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBox Text="route add -p 10.0.0.0 mask 255.0.0.0 10.12.1.1 metric 10" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Content="复制内网路由命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="8,2" Tag="route add -p 10.0.0.0 mask 255.0.0.0 10.12.1.1 metric 10" Click="BtnCopyCmd_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 工具 5: 原生驱动级抓包 (pktmon) 与二层 ARP 审计 (arp -a) -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="5. 原生驱动级抓包诊断 (pktmon) 与二层 ARP 审计 (arp -a)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="零驱动原生抓包" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="无需安装任何第三方 Npcap 或 Wireshark 驱动，Windows 10/11 原生内置 pktmon 数据包监视器与二层 ARP 表排查命令。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: pktmon 抓包 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📡 原生数据包监视器 (pktmon.exe)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="微软原生网络栈诊断工具。支持实时控制台抓包或生成 ETL 日志并转换为 Wireshark 兼容的 PCAPNG 格式，完全避开第三方驱动蓝屏隐患。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="pktmon start --etw -m real-time" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="实时控制台监视" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="pktmon start --etw -m real-time" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="停止并转 pcapng" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="pktmon stop; pktmon pcapng pktmon.etl -o network_capture.pcapng" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: arp -a 缓存表与欺骗排查 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🔍 二层 MAC 映射与 ARP 防欺骗 (arp.exe)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="检查局域网内 IP 到 MAC 的映射关系。若发现局域网中不同 IP 对应相同 MAC 或网关 MAC 突变，可能遭遇 ARP 投毒攻击。支持一键清空动态缓存。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="arp -a" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="查看 ARP 缓存表" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="arp -a" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="清空动态 ARP 缓存" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="arp -d *" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 6: 本地端口占用与属主 PID 秒查 (netstat & Get-NetTCPConnection) -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="6. 本地端口占用与属主 PID 秒查 (netstat &amp; Get-NetTCPConnection)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="端口占用击杀闭环" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="开发与日常运维高频痛点：8080/3000/5000 端口提示已被占用。利用原生命令秒查监听状态与占用者 PID，配合 taskkill 即可实现手术刀级强杀。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: netstat 经典命令行 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📋 端口与 PID 快速过滤 (netstat -ano)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="经典高效组合。输出最后一列即为该监听套接字的属主进程 PID，随后配合 tasklist /fi &quot;PID eq &lt;PID&gt;&quot; 即可揪出具体软件。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="netstat -ano | findstr :8080" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="复制 8080 端口查 PID" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="netstat -ano | findstr :8080" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="列出全部 LISTENING" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="netstat -ano | findstr LISTENING" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: PowerShell Get-NetTCPConnection -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ PowerShell 对象化端口查询 (Get-NetTCPConnection)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="原生 PowerShell 现代接口。支持强类型过滤本地端口，直接联立 Get-Process 输出进程名称、路径与内存开销。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="Get-NetTCPConnection -LocalPort 8080 | Select-Object Local*, State, OwningProcess" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制端口与进程联合查询命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="Get-NetTCPConnection -LocalPort 8080 | Select-Object LocalAddress, LocalPort, State, OwningProcess, @{Name='ProcessName';Expression={(Get-Process -Id $_.OwningProcess).ProcessName}}" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 6: 局域网共享文件夹正向创建、赋权与排错 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="6. 局域网共享文件夹正向创建、赋权与访问排障" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertGreenBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="局域网协作必备" FontSize="10" Foreground="{DynamicResource BrushAlertGreenText}" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🌐 高级共享设置" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="0,0,6,0" Click="BtnOpenAdvancedSharing_Click"/>
                            <Button Content="📁 查看当前共享 (net share)" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="10" Click="BtnListNetShares_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="新手局域网互传文件指南。包含一键放行防火墙网络发现、通过原生 net share 快速创建公开读写目录，以及排查 Windows 10/11 经典的 0x80070035「找不到网络路径」错误。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 A: 开启网络发现与放行防火墙 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📶 放行网络发现与文件共享防火墙规则" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="若局域网搜不到此电脑，需向 Windows Defender 防火墙放行「文件和打印机共享」全套规则。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="netsh advfirewall firewall set rule group=&quot;文件和打印机共享&quot; new enable=Yes" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制防火墙放行命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="netsh advfirewall firewall set rule group=&quot;文件和打印机共享&quot; new enable=Yes" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 B: 原生命令一键建立共享目录 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ 原生 net share 创建局域网共享目录" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="将指定本地目录（如 C:\ShareFolder）发布为局域网共享名 ProjectShare，赋予所有人完整读写权限。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="net share ProjectShare=C:\ShareFolder /grant:everyone,full" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制创建共享命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="net share ProjectShare=C:\ShareFolder /grant:everyone,full" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具 7: 系统时间跑偏与 NTP 授时同步 (w32tm & 双系统 8 小时修复) -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="7. 系统时间跑偏排查 (w32tm) 与双系统 8 小时时差修复" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="授时与双系统时钟" FontSize="10" Foreground="{DynamicResource BrushAlertPurpleText}" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🕒 强制 NTP 网络同步" Background="#10B981" Padding="8,3" FontSize="10" Margin="0,0,6,0" Click="BtnResyncTime_Click"/>
                            <Button Content="⚡ 切换双系统 UTC 时钟" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="10" Click="BtnToggleRealTimeIsUniversal_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="排查系统时钟跑偏、主板 RTC 电池没电导致的 HTTPS 证书校验失败 (时钟不准确)。支持一键执行 w32tm 强制授时同步，以及一键开启 RealTimeIsUniversal 解决 Windows 与 Linux 双系统时钟反复打架。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 A: 查询时间同步状态与时钟源 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🔍 查询时间同步状态与偏差源 (w32tm /query)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="查看当前计算机使用的 NTP 授时服务器地址、上次同步时间戳及本地时钟源层级 (Stratum)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="w32tm /query /status" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制时钟状态查询命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="w32tm /query /status" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 B: 双系统 8 小时时差原理与注册表修复 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🐧 Windows + Linux 双系统时差 8 小时根治" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Linux 默认将主板硬件 RTC 视作 UTC，而 Windows 默认视作本地时间 (CST=UTC+8)。点击右上角【切换双系统 UTC 时钟】写入 RealTimeIsUniversal=1 即可彻底根治。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="reg add HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation /v RealTimeIsUniversal /t REG_DWORD /d 1 /f" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Button Content="复制 RealTimeIsUniversal 命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Tag="reg add &quot;HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation&quot; /v RealTimeIsUniversal /t REG_DWORD /d 1 /f" Click="BtnCopyCmd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
