                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="🔍 打开后能获取什么信息？" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,3"/>
                                        <TextBlock Text="• 常规项目：下载的程序文件、临时 Internet 文件、缩略图缓存、回收站。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                        <TextBlock Text="• 点击「清理系统文件」后：解锁「Windows 更新清理」、「以前的 Windows 安装 (Windows.old)」、「设备驱动程序软件包」。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="🎯 重点巡检指标与关键项" FontWeight="Bold" FontSize="11" Foreground="#DC2626" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Windows 更新清理：版本升级后此项通常占用 5GB~25GB+ 空间。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                        <TextBlock Text="• DirectX 着色器缓存：在显卡驱动更新后清理损坏的陈旧 Shader 缓存。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="💡 为什么要看这些信息？" FontWeight="Bold" FontSize="11" Foreground="#047857" Margin="0,0,0,3"/>
                                        <TextBlock Text="相比第三方清理工具经常误删系统关键依赖导致蓝屏，cleanmgr 是经过微软完整签名检验的最安全瘦身工具，在大版本升级后可瞬间收回数十 GB 宝贵空间。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 板块 3: 远程协助与步骤记录器 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="3. 原生故障协作与重现工具 (msra.exe / psr.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="远程技术支持与故障自动操作步骤重现。注意：在 Win11 新版本中微软已将 psr 标记为过时，推荐使用 Snipping Tool 录屏协作。"
