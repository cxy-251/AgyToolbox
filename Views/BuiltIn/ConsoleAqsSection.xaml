                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Win + Shift + S" FontSize="16" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="原生全屏与区域截图工具" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="支持矩形选区、任意多边形套索、单个活动窗口及全屏截图，截图即刻存入剪贴板并支持即时编辑标注涂鸦。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 快捷键 4: Win + . -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
