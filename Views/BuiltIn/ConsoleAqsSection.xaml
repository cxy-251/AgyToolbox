                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="gpedit.msc" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" · 本地组策略编辑器 (权威行为策略中枢)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="Windows 专业版与企业版中统一管理系统功能、阻止特定更新与锁定策略的最强原生工具。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="⚡ 启动控制台" Style="{DynamicResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center" Tag="gpedit.msc" Click="BtnLaunchCmd_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="🔍 打开后能获取什么信息？" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,3"/>
                                        <TextBlock Text="• 计算机配置 ➔ 管理模板 ➔ Windows 组件：Windows 更新、Defender 防病毒、BitLocker 加密。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                        <TextBlock Text="• 系统 ➔ 凭据分配：远程桌面凭据保护与 NTLM 认证控制。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="🎯 重点巡检指标与关键项" FontWeight="Bold" FontSize="11" Foreground="#DC2626" Margin="0,0,0,3"/>
                                        <TextBlock Text="• 配置自动更新：查看是否已配置「已禁用」或「自动下载并通知安装」。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                        <TextBlock Text="• 传递优化：查看是否已将下载模式设为 0 (仅 HTTP)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="💡 为什么要看这些信息？" FontWeight="Bold" FontSize="11" Foreground="#047857" Margin="0,0,0,3"/>
                                        <TextBlock Text="组策略具有高于普通注册表和设置面板的强制效力，配置后可避免随系统更新或普通账户操作被轻易篡改。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- MMC 卡片 8: cleanmgr.exe 磁盘清理实用程序 -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="cleanmgr.exe" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" · 磁盘清理实用程序 (官方系统底层深度瘦身)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="官方原生磁盘瘦身工具，专用于安全清理 Windows 更新残留、Windows.old 镜像与着色器缓存。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="⚡ 启动控制台" Style="{DynamicResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center" Tag="cleanmgr.exe" Click="BtnLaunchCmd_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource BrushWindowBg}" CornerRadius="6" Padding="10">
