                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Win + Ctrl + Shift + B" FontSize="15" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
