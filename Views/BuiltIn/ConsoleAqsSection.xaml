                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 快捷键 5: Ctrl + Shift + Esc -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ctrl + Shift + Esc" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="直接呼出任务管理器 (绕过安全桌面)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
