<UserControl x:Class="AgyToolbox.Views.BuiltIn.ConsoleAqsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="2200" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="0,0,0,24">

            <!-- 模块概述看板 -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🧰 原生管理控制台矩阵 (MMC) 与资源管理器高级检索语法 (AQS)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="收录 8 大系统底层核心管理单元（详细拆解窗口信息架构、关键指标与排障动机），并提供 12+ 组高频工程实战 AQS 结构化检索范例。零第三方工具依赖，完全依托 Windows 原生机制实现专业级系统巡检与定位。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块 1: AQS 高级查询语法全景解析与实战库 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="1. 资源管理器高级查询语法 (AQS - Advanced Query Syntax)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="原生秒级精准定位 · 免装搜索软件" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="Windows 资源管理器搜索框原生深度支持 AQS 结构化查询语言。直接利用现有系统索引或无索引强行穿透，支持按容量阶梯、精确时间区间、多扩展名聚合与布尔逻辑进行组合过滤。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- AQS 基础语法规则卡片 -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 AQS 语法通用结构与运算符解析：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• 标准语法格式：[属性名]:[运算符][取值]，例如 size:>100MB 或 datemodified:2024-01-01..2024-06-30。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 常用运算符：&gt; (大于)、&lt; (小于)、&gt;=、&lt;=、.. (双点闭区间)、~= (包含子串)、NOT / - (排除)、AND (且)、OR (或)。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 字符串规范：若取值包含空格或特殊字符，必须使用双引号包裹，例如 content:&quot;error connection reset&quot;。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 性能提示：使用 name: 限定仅检索文件名可实现毫秒级快速返回；仅在确有需要时使用 content: 进行全文检索。" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                        </StackPanel>
                    </Border>

                    <!-- AQS 真实高频工程实战范例列表 -->
                    <TextBlock Text="高频实战场景查询清单 (点击 📋 可直接复制指令粘贴至资源管理器搜索框)：" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,8"/>

                    <Border BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="1" CornerRadius="4">
                        <Grid Background="{DynamicResource BrushCardBg}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{DynamicResource BrushTableHeaderBg}" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="业务与工程场景" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="可执行 AQS 实战表达式" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="检索机理与应用价值说明" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="3" Text="操作" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>

                            <!-- 范例 1: 今日突发大文件排查 -->
                            <Border Grid.Row="1" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="🚨 磁盘暴涨排查" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="datemodified:today size:>200MB" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="锁定今天内产生且体积超过 200MB 的文件。瞬间揪出异常失控的录屏临时文件、崩溃转储或挂机下载包。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="datemodified:today size:>200MB" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 2: 本周源码文件 -->
                            <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="💻 开发进度追踪" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="kind:code (ext:cs OR ext:py OR ext:ts) datemodified:this week" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="跨多个工程目录聚合本周修改过的关键代码文件，便于准备代码审查 (Code Review) 或周报梳理。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="kind:code (ext:cs OR ext:py OR ext:ts) datemodified:this week" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 3: 排除 Word 临时镜像的办公文档 -->
                            <Border Grid.Row="3" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="📑 纯净文档筛选" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="kind:docs (ext:docx OR ext:xlsx OR ext:pdf) NOT name:~* datemodified:this month" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="筛选本月所有办公文档，同时使用 NOT name:~* 彻底剔除 Word/Excel 正在编辑时自动生成的 ~$ 隐藏临时占位文件。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="kind:docs (ext:docx OR ext:xlsx OR ext:pdf) NOT name:~* datemodified:this month" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 4: 穿透定位配置项与端口 -->
                            <Border Grid.Row="4" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="⚙️ 配置穿透检索" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="content:&quot;connectionString&quot; (ext:config OR ext:json OR ext:env)" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="在所有配置文件中执行全文内容搜索，快速定位数据库连接串、API 端点定义或端口声明所在的文件与行。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="content:&quot;connectionString&quot; (ext:config OR ext:json OR ext:env)" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 5: 崩溃转储文件定位 -->
                            <Border Grid.Row="5" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="💥 崩溃转储提取" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="(ext:dmp OR ext:mdmp OR name:MEMORY.DMP) datemodified:this month" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="无论软件将转储文件存储在 AppData、LocalLow 还是系统根目录，一键聚合全盘当月所有崩溃快照以便 WinDbg 分析。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="(ext:dmp OR ext:mdmp OR name:MEMORY.DMP) datemodified:this month" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 6: 巨型依赖锁定与日志 -->
                            <Border Grid.Row="6" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="📦 依赖与日志瘦身" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="(name:*lock* OR ext:log) size:>50MB" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="抓出体积异常庞大的包管理器依赖锁文件 (如数万行的 package-lock.json) 以及长期未轮转爆满的日志文件。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="(name:*lock* OR ext:log) size:>50MB" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 7: 4K 超高清大图像过滤 -->
                            <Border Grid.Row="7" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="🖼️ 4K 视觉资产过滤" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="7" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="kind:pics width:>=3840 height:>=2160" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="7" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="结合宽与高维度属性，直接从成千上万张图片中秒级抽离出符合 4K UHD 规格的设计图、渲染图与高质量素材。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="7" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="kind:pics width:>=3840 height:>=2160" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 8: 巨型视频媒体文件 -->
                            <Border Grid.Row="8" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="🎬 巨型视频归档" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="8" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="kind:video size:>1GB (ext:mp4 OR ext:mkv OR ext:mov)" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="8" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="集中检索单个体积大于 1GB 的超大视频文件，便于迅速转移至外置硬盘或 NAS 进行空间释放。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="8" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="kind:video size:>1GB (ext:mp4 OR ext:mkv OR ext:mov)" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 9: 私钥证书审计 -->
                            <Border Grid.Row="9" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="🔒 私钥证书审计" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                            </Border>
                            <Border Grid.Row="9" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="ext:pem OR ext:key OR ext:pfx OR name:id_rsa" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                            <Border Grid.Row="9" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="排查本地未加密存放的 SSL 证书、SSH 私钥及 PFX 代码签名密钥，避免意外泄露给公共项目。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="9" Grid.Column="3" Padding="6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="ext:pem OR ext:key OR ext:pfx OR name:id_rsa" Click="BtnCopyCmd_Click"/>
                            </Border>

                            <!-- 范例 10: 敏感明文 Key 泄漏审计 -->
                            <Border Grid.Row="10" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,0">
                                <TextBlock Text="🛡️ 敏感字符串审计" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                            </Border>
                            <Border Grid.Row="10" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,0">
                                <TextBlock Text="content:&quot;BEGIN RSA PRIVATE KEY&quot; OR content:&quot;api_secret&quot;" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="10" Grid.Column="2" Padding="8,6">
                                <TextBlock Text="在项目工作空间中执行安全排查，防止开发者在将源码推送至远程 GitHub/GitLab 仓库前意外硬编码了真实机密。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Grid.Row="10" Grid.Column="3" Padding="6" VerticalAlignment="Center">
                                <Button Content="复制" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="10" Tag="content:&quot;BEGIN RSA PRIVATE KEY&quot; OR content:&quot;api_secret&quot;" Click="BtnCopyCmd_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 板块 2: Windows 管理控制台 (MMC) 深度巡检全景手册 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="2. Windows 管理控制台核心管理单元 (MMC Snap-ins) 深度巡检手册" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="系统级黑匣子与底层运维矩阵" FontSize="10" Foreground="{DynamicResource BrushAlertPurpleText}" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="无需层层点击繁琐且功能简化的现代设置界面，系统工程师可通过 Win + R 运行框直接调用底层 MMC 管理单元。以下全面解析每个控制台能获取什么关键信息、重点指标是什么、以及为什么要看这些信息："
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- MMC 卡片 1: eventvwr.msc 事件查看器 -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="eventvwr.msc" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text=" · Windows 事件查看器 (系统级终极黑匣子)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="6,0,0,0"/>
                                    </WrapPanel>
