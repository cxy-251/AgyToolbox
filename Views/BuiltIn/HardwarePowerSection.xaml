                                <TextBlock Text="📐 多屏鼠标跨屏平滑穿梭与刷新率对齐" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="当双屏分辨率或物理高度不一致时，鼠标跨屏常因边缘不贴齐被卡住。进入显示设置拖动矩形框使其上下边缘精确平齐；若主屏 144Hz 副屏 60Hz 出现微卡顿，请在高级显示中确认副屏刷新率已锁至最高。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="打开 Windows 显示排列设置" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2" Click="BtnOpenDisplaySettings_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
