<UserControl x:Class="AgyToolbox.Views.BuiltIn.PerfTraceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="0,0,0,24">

            <!-- 模块概述 -->
            <Border Background="{DynamicResource BrushAlertPurpleBg}" BorderBrush="{DynamicResource BrushAlertPurpleBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🩺 性能追踪、资源瓶颈巡检与句柄死锁排查" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushAlertPurpleText}" Margin="0,0,0,4"/>
                    <TextBlock Text="超越基础任务管理器的初级图表。借助资源监视器 (关联句柄秒解文件占用)、性能监视器黄金计数器、系统关键事件 ID 审计与 Windows 性能记录器 (WPR) 实现深度排障。"
                               FontSize="11" Foreground="{DynamicResource BrushAlertPurpleText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 工具 1: resmon 资源监视器 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="1. 资源监视器 (resmon.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="句柄与硬件管线" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Windows 最实用的微观资源诊断工具。解决“文件被其他程序占用无法删除”与“内存莫名跑满却找不到大进程”两大高频痛点。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开资源监视器" VerticalAlignment="Center" Click="BtnResMon_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                <TextBlock Text="📂 CPU 标签页 ➔ 关联的句柄 (Associated Handles)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="在搜索框输入被锁定的文件夹名或文件名，下方即刻列出占用该句柄的进程与 PID。右键选择「结束进程」即可彻底解锁该文件！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                                <TextBlock Text="🧠 内存 标签页 ➔ 非分页缓冲池 (Nonpaged Pool)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="若非分页缓冲池超过 2GB~4GB，且在任务管理器里找不到高占用应用，必为驱动级内存泄漏 (如 Killer 网卡驱动泄漏)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,8,0">
                                <TextBlock Text="💾 磁盘 标签页 ➔ 响应时间 (Response Time)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="按响应时间倒序排列。凡是响应时间持续 > 50ms 的进程，必为引发整机卡死、无响应的 I/O 拥塞源头。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,6,0,0">
                                <TextBlock Text="🌐 网络 标签页 ➔ 侦听端口 (Listening Ports)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="精确查看本地开放的所有 TCP 侦听端口、关联的可执行文件与防火墙状态，排查未知后门与开发端口冲突。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 工具 2: perfmon 性能监视器 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="2. 性能监视器 (perfmon.msc) 四大基线指标" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border Background="{DynamicResource BrushAlertYellowBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="企业级基准" FontSize="10" Foreground="{DynamicResource BrushAlertYellowText}" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="微软官方推荐的四大系统健康基线计数器，为系统调优与扩容提供严谨客观的量化依据。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开性能监视器" VerticalAlignment="Center" Click="BtnPerfMon_Click"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
                        <Grid Background="{DynamicResource BrushCardBg}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource BrushTableHeaderBg}" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="核心计数器对象" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="健康基线阈值" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="超标工程诊断意义" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="Processor(_Total)\% Processor Time" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="长期均值 &lt; 80%" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1">
                                <TextBlock Text="持续 > 85% 表示存在 CPU 算力瓶颈或死循环线程，需检查高负载进程。" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="Memory\Available MBytes" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="&gt; 物理内存的 10%" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1">
                                <TextBlock Text="若可用内存持续低于 500MB，系统将剧烈进行磁盘分页交换 (Thrashing)，整机顿挫。" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="PhysicalDisk\Avg. Disk Queue Length" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,1">
                                <TextBlock Text="&lt; 2 * 主轴/通道数" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,0,1">
                                <TextBlock Text="队列长度过大意味着磁盘 I/O 读写能力已经饱和，请求大量排队等待。" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="0" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Memory\Pages/sec" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Padding="8,6" BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="0,0,1,0">
                                <TextBlock Text="正常工况 &lt; 20" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" Padding="8,6">
                                <TextBlock Text="硬错误页置换频次过高代表物理内存严重不足，急需加装 RAM 内存条。" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 工具 3: eventvwr 核心事件 ID 与 WPR 记录器 -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="3. 事件查看器关键 ID (eventvwr.msc) 与性能追踪记录 (WPR)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="发生诡异重启或掉电时，查阅内核关键日志，或录制完整的黑盒 ETL 追踪日志。"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开事件查看器" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnEventVwr_Click"/>
                            <Button Content="启动性能记录器 (WPR)" Click="BtnWpr_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="📋 事件查看器核心事件 ID 判决表 (Windows 日志 ➔ 系统)：" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• 事件 ID 41 (Kernel-Power)：系统在未首先完全关机的情况下重新启动。排查电源功率不足、意外断电或严重硬件死机。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 事件 ID 1001 (BugCheck)：计算机已经从检测错误后重新启动。记录了蓝屏停机代码与转储已存入 Minidump。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 事件 ID 7034 (Service Control Manager)：服务意外终止，通常伴随特定系统守护进程的崩溃日志。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                            <TextBlock Text="• 事件 ID 129 / 153 (Disk)：发出对设备的重置或磁盘 I/O 错误重试。SSD 固件异常或数据线接触不良的高频预警！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 工具 4: 轻量级原生进程树审查与强杀 (tasklist & taskkill) -->
            <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="4. 原生进程树审查与级联强杀 (tasklist &amp; taskkill)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="零开销命令行" FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="在图形化界面卡死、任务管理器拒绝响应或无法彻底结束子进程树时，利用 Windows 内置的 tasklist 与 taskkill 实现手术刀级控制。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: tasklist 进程高级筛选 -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📋 假死与依赖模块审查 (tasklist.exe)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="快速检索系统当前处于「未响应」假死状态的进程，或排查特定 DLL 模块被哪些程序加载锁定。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="tasklist /v /fi &quot;STATUS eq NOT RESPONDING&quot;" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="查询未响应进程" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="tasklist /v /fi &quot;STATUS eq NOT RESPONDING&quot;" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="排查模块加载" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="tasklist /m target.dll" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: taskkill 进程树终结 -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ 级联强杀子进程树 (taskkill.exe)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="任务管理器常常无法杀死僵死父进程派生出的多层孤儿进程。使用 /t 标志级联强杀整个进程树，彻底杜绝句柄残留。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="taskkill /f /pid 12345 /t" IsReadOnly="True" FontFamily="Consolas" FontSize="9" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="按 PID 级联强杀 (/t)" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="0,0,3,0" Tag="taskkill /f /pid &lt;PID&gt; /t" Click="BtnCopyCmd_Click"/>
                                    <Button Grid.Column="1" Content="按映像名批量终止" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="4,2" Margin="3,0,0,0" Tag="taskkill /f /im node.exe /t" Click="BtnCopyCmd_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
