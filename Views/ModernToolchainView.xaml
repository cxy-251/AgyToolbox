                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6"
                                                 Text="dotnet run&#x0d;&#x0a;dotnet build&#x0d;&#x0a;dotnet publish -c Release"/>
                                    </StackPanel>
                                </Border>

                                <!-- 全局诊断与工程工具安装 -->
                                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="安装两大约束级生产全局工具 (dotnet-ef / dotnet-trace):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="dotnet tool install -g dotnet-ef&#x0d;&#x0a;dotnet tool install -g dotnet-trace"/>
                                        </Grid>
                                        <TextBlock Text="• dotnet-ef：Entity Framework Core 官方命令行工具，用于执行数据库 Migration 迁移追踪、模型脚手架逆向与数据库结构更新。&#x0a;• dotnet-trace：微软跨平台官方运行时性能探针，无需重启线上进程即可按需实时采集 CPU 采样图谱与诊断调用栈。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="16"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6"
                                                 Text="dotnet tool install -g dotnet-ef&#x0d;&#x0a;dotnet tool install -g dotnet-trace"/>
