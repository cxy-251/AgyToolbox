                                                    Click="BtnCopySnippet_Click" Tag="fd -e ps1&#x0d;&#x0a;fd --hidden &quot;appsettings&quot;"/>
                                        </Grid>
                                        <TextBlock Text="说明：-e 快速过滤扩展名（如 ps1, json, sln）；默认跳过隐藏文件和 .git 目录，加上 --hidden 可透视隐藏配置文件。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6"
                                                 Text="fd -e ps1&#x0d;&#x0a;fd --hidden &quot;appsettings&quot;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. bat -->
                                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="bat 基础用法 (带语法高亮与行号查看源码):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="bat script.ps1"/>
                                        </Grid>
                                        <TextBlock Text="说明：自动识别上百种语言格式并高亮着色，显示行号并标记 Git 增删改状态，比传统 Windows type 拥有极其优秀的终端阅读体验。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6"
                                                 Text="bat script.ps1"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 管道组合实战 -->
                                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="多工具管道组合实战 (流式筛选并批量呈现):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制命令" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="# 跨平台 / Git Bash / WSL 场景 (xargs):&#x0d;&#x0a;fd -e ps1 | xargs bat&#x0d;&#x0a;&#x0d;&#x0a;# PowerShell 原生管道场景:&#x0d;&#x0a;fd -e ps1 | ForEach-Object { bat $_ }"/>
                                        </Grid>
                                        <TextBlock Text="说明：通过管道将 fd 搜出的文件流直接传递给 bat 批量打印预览。在 Git Bash 或 WSL 环境可直接管道串联 xargs bat，在 Windows 原生 PowerShell 中可直接通过 ForEach-Object 流式传递。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6"
                                                 Text="fd -e ps1 | xargs bat&#x0d;&#x0a;# 或在原生 PowerShell 中:&#x0d;&#x0a;fd -e ps1 | ForEach-Object { bat $_ }"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
