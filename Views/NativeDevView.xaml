                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="从「单文件盲写」跨越到「工程级严谨交付」：涵盖调试排错、参数守卫校验与安全演练、多文件组织、.NET 底层互操作及正则清洗全维度实战："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- 进阶 1: 调试与排错手段 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍 1. 告别盲写：PowerShell 断点与单步调试排错实战" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushAlertInfoBg}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="优先必修" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAlertInfoText}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="• 调试输出流 (Write-Debug)：在代码中埋入 Write-Debug &quot;变量状态: $val&quot;，平时将 $DebugPreference 设为 'SilentlyContinue'（完全不干扰正常输出），排错时改设为 'Continue' 即刻无损透传全部诊断日志。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 原生语句级追踪 (Set-PSDebug)：无需任何外部插件，在控制台输入 Set-PSDebug -Trace 1 即可开启单步跟踪（执行到哪行打印哪行）；-Trace 2 甚至会同时打印变量实时赋值！调试完毕输入 Set-PSDebug -Off 关闭。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                        <TextBlock Text="• VS Code 交互式断点：在 VS Code 中安装官方 PowerShell 扩展，F9 设行断点，按 F5 启动调试。支持 F10 单步跳过、F11 步入函数、变量面板实时监视；脚本中亦可直接写入 Wait-Debugger 暂停等待挂载！"
                                                   FontSize="10" Foreground="{DynamicResource BrushSuccess}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Grid>
                                            <TextBox Text="# 开启追踪调试命令示例：&#x0d;&#x0a;$DebugPreference = 'Continue'&#x0d;&#x0a;Set-PSDebug -Trace 2&#x0d;&#x0a;.\my_complex_script.ps1&#x0d;&#x0a;Set-PSDebug -Off" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="6"/>
                                            <Button Content="📋 复制调试追踪命令" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="4"
                                                    Click="BtnCopySnippet_Click" Tag="$DebugPreference = 'Continue'&#x0d;&#x0a;Set-PSDebug -Trace 2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 进阶 2: 参数校验与安全演练 (-WhatIf) -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🛡️ 2. 参数守卫与安全演练：让别人敢跑你的脚本 (-WhatIf &amp; Validate)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushAlertGreenBg}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="工程分水岭" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="• 安全演练机制 (SupportsShouldProcess)：头部声明 [CmdletBinding(SupportsShouldProcess = $true)]，在执行删除、覆盖等破坏性动作前用 if ($PSCmdlet.ShouldProcess($target, &quot;删除&quot;)) 包裹。调用方即可直接使用 -WhatIf 参数进行无害预演（仅打印操作计划不真实改动），或用 -Confirm 交互确认！"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 强类型参数守卫：[ValidateSet('Dev','Prod')] 枚举限定 | [ValidateRange(1,65535)] 数值区间约束 | [ValidateScript({Test-Path $_})] 自定义断言校验 | [ValidateNotNullOrEmpty()] 非空保证。非法传参在第一行即被拦截报错，杜绝意外行为！"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                        <Grid>
                                            <TextBox Text="[CmdletBinding(SupportsShouldProcess = $true)]&#x0d;&#x0a;param(&#x0d;&#x0a;    [ValidateSet('Debug', 'Release')]&#x0d;&#x0a;    [string]$Configuration = 'Release',&#x0d;&#x0a;&#x0d;&#x0a;    [ValidateRange(1, 30)]&#x0d;&#x0a;    [int]$RetainDays = 7,&#x0d;&#x0a;&#x0d;&#x0a;    [ValidateScript({ Test-Path $_ })]&#x0d;&#x0a;    [string]$TargetDir = '.\dist'&#x0d;&#x0a;)&#x0d;&#x0a;if ($PSCmdlet.ShouldProcess($TargetDir, &quot;物理清理所有过期归档&quot;)) {&#x0d;&#x0a;    Remove-Item &quot;$TargetDir\*&quot; -Recurse -Force&#x0d;&#x0a;}" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="6"/>
                                            <Button Content="📋 复制 -WhatIf 参数模板" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="4"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding(SupportsShouldProcess = $true)]&#x0d;&#x0a;param(&#x0d;&#x0a;    [ValidateSet('Debug', 'Release')]&#x0d;&#x0a;    [string]$Configuration = 'Release'&#x0d;&#x0a;)&#x0d;&#x0a;if ($PSCmdlet.ShouldProcess($Target, &quot;操作描述&quot;)) {&#x0d;&#x0a;    # 真实逻辑&#x0d;&#x0a;}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 进阶 3: 函数与多文件组织 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📂 3. 多文件组织与模块化工程：拒绝几百行「意面脚本」" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 路径锚定基石 ($PSScriptRoot)：这是编写多文件脚本最核心的内置变量（代表当前脚本所在的绝对目录，相当于 .bat 的 %~dp0）。引用同级辅助脚本时务必写 . &quot;$PSScriptRoot\helpers.ps1&quot;，杜绝相对路径因 cd 漂移失效。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 点源引入 (Dot-Sourcing)：使用 . &quot;$PSScriptRoot\common_utils.ps1&quot; 可以在当前作用域直接引入公共函数与配置，快速拆分超长脚本。&#x0a;• 模块封装 (.psm1)：将可复用公共函数沉淀为 MyTool.psm1，使用 Export-ModuleMember -Function Get-CustomLog 显式导出外部接口，并在主脚本中 Import-Module -Force &quot;$PSScriptRoot\MyTool.psm1&quot; 规范化加载。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                        <Grid>
                                            <TextBox Text="# 主脚本 main.ps1 多文件组织架构：&#x0d;&#x0a;$scriptDir = $PSScriptRoot&#x0d;&#x0a;. &quot;$scriptDir\lib\logger.ps1&quot;        # Dot-Sourcing 加载日志工具&#x0d;&#x0a;Import-Module -Force &quot;$scriptDir\modules\Deploy.psm1&quot; # 导入自定义模块&#x0d;&#x0a;Write-Log -Message &quot;工程化多文件模块加载完毕！&quot;" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="6"/>
                                            <Button Content="📋 复制多文件组织模板" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="4"
                                                    Click="BtnCopySnippet_Click" Tag="$scriptDir = $PSScriptRoot&#x0d;&#x0a;. &quot;$scriptDir\lib\logger.ps1&quot;&#x0d;&#x0a;Import-Module -Force &quot;$scriptDir\modules\Deploy.psm1&quot;"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 进阶 4: PowerShell 直接调用 .NET 与内嵌 C# -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⚡ 4. 标志性技能：PowerShell 直调 .NET 底层与 Add-Type 内嵌 C# 动态编译" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="精通标志" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAlertPurpleText}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="• 本质澄清：PowerShell 不是一个简单的字符串 Shell，而是直接跑在 .NET CLR 之上的外壳宿主！整个庞大的 .NET BCL 基类库均可免安装直接静态调用（如 [System.IO.Path]::Combine()、[System.IO.Compression.ZipFile]、[System.Environment]::MachineName）。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 动态编译 C# (Add-Type)：这是超越所有传统脚本语言的核心杀手锏。无需安装 Visual Studio 或 SDK，直接在脚本中使用 Add-Type 嵌入一段 C# 代码，PowerShell 会在内存中即时将其编译为原生程序集，不仅能完成极致算力运算，还能直接 P/Invoke 声明调用 Windows Win32 底层 API！"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                        <Grid>
                                            <TextBox Text="# 在 PowerShell 内部直接嵌入并动态编译 C# 源码 (调用 Win32 原生 API 弹窗)：&#x0d;&#x0a;Add-Type @&quot;&#x0d;&#x0a;using System;&#x0d;&#x0a;using System.Runtime.InteropServices;&#x0d;&#x0a;public class NativePinvoke {&#x0d;&#x0a;    [DllImport(&quot;user32.dll&quot;, CharSet = CharSet.Auto)]&#x0d;&#x0a;    public static extern int MessageBox(IntPtr hWnd, String text, String caption, uint type);&#x0d;&#x0a;}&#x0d;&#x0a;&quot;@&#x0d;&#x0a;&#x0d;&#x0a;# 像原生 .NET 类型一样直接调用编译出的 C# 类：&#x0d;&#x0a;[NativePinvoke]::MessageBox([IntPtr]::Zero, &quot;这是从 PowerShell 内动态编译跑起来的原生 C#！&quot;, &quot;动态 C# 编译演示&quot;, 0)" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="6" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                                            <Button Content="📋 复制 Add-Type 动态 C# 源码" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="4"
                                                    Click="BtnCopySnippet_Click" Tag="Add-Type @&quot;&#x0d;&#x0a;using System;&#x0d;&#x0a;using System.Runtime.InteropServices;&#x0d;&#x0a;public class NativePinvoke {&#x0d;&#x0a;    [DllImport(&quot;user32.dll&quot;, CharSet = CharSet.Auto)]&#x0d;&#x0a;    public static extern int MessageBox(IntPtr hWnd, String text, String caption, uint type);&#x0d;&#x0a;}&#x0d;&#x0a;&quot;@&#x0d;&#x0a;[NativePinvoke]::MessageBox([IntPtr]::Zero, &quot;动态 C# 编译成功！&quot;, &quot;提示&quot;, 0)"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 进阶 5: 正则表达式实战与日志异常清洗 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🎯 5. 正则表达式实战：从「能检索」升级为「对象级高精度提取」" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 操作符体系：-match 执行正则匹配，命中后自动把分组捕获存入数组 $Matches[1]、$Matches[2]；-replace 执行正则批量替换清洗。&#x0a;• 生产日志清洗实战：结合 [regex]::Matches($logText, '(?m)^ERROR\s+\[(?&lt;time&gt;[^\]]+)\]\s+(?&lt;msg&gt;.*)$')，利用对象管道将原本杂乱无章的纯文本日志秒级转换为包含时间戳、级别和异常信息的强类型对象集合！"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Grid>
                                            <TextBox Text="# 从日志文件中高精度提取异常堆栈与时间戳：&#x0d;&#x0a;$log = @&quot;&#x0d;&#x0a;[2026-09-17 12:00:01] INFO Application started&#x0d;&#x0a;[2026-09-17 12:01:23] ERROR DatabaseException: Connection timeout at line 42&#x0d;&#x0a;[2026-09-17 12:02:15] WARN Slow query detected&#x0d;&#x0a;&quot;@&#x0d;&#x0a;$pattern = '\[(?&lt;Timestamp&gt;[^\]]+)\]\s+ERROR\s+(?&lt;Exception&gt;\w+):\s+(?&lt;Message&gt;.*)'&#x0d;&#x0a;[regex]::Matches($log, $pattern) | ForEach-Object {&#x0d;&#x0a;    [PSCustomObject]@{&#x0d;&#x0a;        Time      = $_.Groups['Timestamp'].Value&#x0d;&#x0a;        Exception = $_.Groups['Exception'].Value&#x0d;&#x0a;        Detail    = $_.Groups['Message'].Value&#x0d;&#x0a;    }&#x0d;&#x0a;} | Format-Table" IsReadOnly="True" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" FontFamily="Consolas" FontSize="10" Padding="6" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                                            <Button Content="📋 复制正则对象化解析代码" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="4"
                                                    Click="BtnCopySnippet_Click" Tag="$pattern = '\[(?&lt;Timestamp&gt;[^\]]+)\]\s+ERROR\s+(?&lt;Exception&gt;\w+):\s+(?&lt;Message&gt;.*)'&#x0d;&#x0a;[regex]::Matches($log, $pattern) | ForEach-Object {&#x0d;&#x0a;    [PSCustomObject]@{&#x0d;&#x0a;        Time      = $_.Groups['Timestamp'].Value&#x0d;&#x0a;        Exception = $_.Groups['Exception'].Value&#x0d;&#x0a;        Detail    = $_.Groups['Message'].Value&#x0d;&#x0a;    }&#x0d;&#x0a;}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 实战完整脚本 backup_artifacts.ps1 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄 工业级范例脚本：backup_artifacts.ps1 (融合参数守卫、-WhatIf 预演支持、异常治理与归档)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 一键复制 backup_artifacts.ps1 源码" Background="#16A34A" FontSize="10" Padding="8,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding(SupportsShouldProcess = $true)]&#x0d;&#x0a;param(&#x0d;&#x0a;    [Parameter(Mandatory = $false)]&#x0d;&#x0a;    [ValidateScript({ Test-Path $_ })]&#x0d;&#x0a;    [string]$SourceFolder = &quot;.\dist&quot;,&#x0d;&#x0a;&#x0d;&#x0a;    [Parameter(Mandatory = $false)]&#x0d;&#x0a;    [string]$BackupRoot = &quot;C:\Backups&quot;,&#x0d;&#x0a;&#x0d;&#x0a;    [ValidateRange(1, 365)]&#x0d;&#x0a;    [int]$RetainDays = 7&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;$ErrorActionPreference = 'Stop'&#x0d;&#x0a;Write-Host &quot;=== 🚀 原生构建产物备份归档任务启动 ===&quot; -ForegroundColor Cyan&#x0d;&#x0a;&#x0d;&#x0a;try {&#x0d;&#x0a;    if (-not (Test-Path $BackupRoot)) {&#x0d;&#x0a;        if ($PSCmdlet.ShouldProcess($BackupRoot, &quot;创建备份目标根目录&quot;)) {&#x0d;&#x0a;            New-Item -ItemType Directory -Path $BackupRoot -Force | Out-Null&#x0d;&#x0a;        }&#x0d;&#x0a;    }&#x0d;&#x0a;&#x0d;&#x0a;    $timestamp = Get-Date -Format &quot;yyyyMMdd_HHmmss&quot;&#x0d;&#x0a;    $zipName = &quot;Artifacts_$timestamp.zip&quot;&#x0d;&#x0a;    $zipPath = Join-Path $BackupRoot $zipName&#x0d;&#x0a;&#x0d;&#x0a;    if ($PSCmdlet.ShouldProcess($zipPath, &quot;压缩归档目录 $SourceFolder&quot;)) {&#x0d;&#x0a;        Write-Host &quot;正在压缩打包: $SourceFolder -> $zipPath&quot; -ForegroundColor Yellow&#x0d;&#x0a;        Compress-Archive -Path &quot;$SourceFolder\*&quot; -DestinationPath $zipPath -CompressionLevel Optimal -Force&#x0d;&#x0a;        $archiveSizeMb = [math]::Round(((Get-Item $zipPath).Length / 1MB), 2)&#x0d;&#x0a;        Write-Host &quot;归档打包完成！包大小: $archiveSizeMb MB&quot; -ForegroundColor Green&#x0d;&#x0a;    }&#x0d;&#x0a;&#x0d;&#x0a;    # 清理过期旧备份&#x0d;&#x0a;    $cutoffDate = (Get-Date).AddDays(-$RetainDays)&#x0d;&#x0a;    Get-ChildItem -Path $BackupRoot -Filter &quot;Artifacts_*.zip&quot; -ErrorAction SilentlyContinue |&#x0d;&#x0a;        Where-Object { $_.LastWriteTime -lt $cutoffDate } |&#x0d;&#x0a;        ForEach-Object {&#x0d;&#x0a;            if ($PSCmdlet.ShouldProcess($_.FullName, &quot;删除超过 $RetainDays 天的历史过期备份&quot;)) {&#x0d;&#x0a;                Write-Host &quot;正在清除过期备份: $($_.Name)&quot; -ForegroundColor Gray&#x0d;&#x0a;                Remove-Item $_.FullName -Force&#x0d;&#x0a;            }&#x0d;&#x0a;        }&#x0d;&#x0a;    Write-Host &quot;=== ✅ 任务流程执行完毕 ===&quot; -ForegroundColor Green&#x0d;&#x0a;}&#x0d;&#x0a;catch {&#x0d;&#x0a;    Write-Error &quot;备份任务异常失败: $($_.Exception.Message)&quot;&#x0d;&#x0a;    exit 1&#x0d;&#x0a;}"/>
                                        </Grid>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="8" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                                 Text="[CmdletBinding(SupportsShouldProcess = $true)]&#x0d;&#x0a;param(&#x0d;&#x0a;    [Parameter(Mandatory = $false)]&#x0d;&#x0a;    [ValidateScript({ Test-Path $_ })]&#x0d;&#x0a;    [string]$SourceFolder = &quot;.\dist&quot;,&#x0d;&#x0a;&#x0d;&#x0a;    [Parameter(Mandatory = $false)]&#x0d;&#x0a;    [string]$BackupRoot = &quot;C:\Backups&quot;,&#x0d;&#x0a;&#x0d;&#x0a;    [ValidateRange(1, 365)]&#x0d;&#x0a;    [int]$RetainDays = 7&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;$ErrorActionPreference = 'Stop'&#x0d;&#x0a;Write-Host &quot;=== 🚀 原生构建产物备份归档任务启动 ===&quot; -ForegroundColor Cyan&#x0d;&#x0a;&#x0d;&#x0a;try {&#x0d;&#x0a;    if (-not (Test-Path $BackupRoot)) {&#x0d;&#x0a;        if ($PSCmdlet.ShouldProcess($BackupRoot, &quot;创建备份目标根目录&quot;)) {&#x0d;&#x0a;            New-Item -ItemType Directory -Path $BackupRoot -Force | Out-Null&#x0d;&#x0a;        }&#x0d;&#x0a;    }&#x0d;&#x0a;&#x0d;&#x0a;    $timestamp = Get-Date -Format &quot;yyyyMMdd_HHmmss&quot;&#x0d;&#x0a;    $zipName = &quot;Artifacts_$timestamp.zip&quot;&#x0d;&#x0a;    $zipPath = Join-Path $BackupRoot $zipName&#x0d;&#x0a;&#x0d;&#x0a;    if ($PSCmdlet.ShouldProcess($zipPath, &quot;压缩归档目录 $SourceFolder&quot;)) {&#x0d;&#x0a;        Write-Host &quot;正在压缩打包: $SourceFolder -> $zipPath&quot; -ForegroundColor Yellow&#x0d;&#x0a;        Compress-Archive -Path &quot;$SourceFolder\*&quot; -DestinationPath $zipPath -CompressionLevel Optimal -Force&#x0d;&#x0a;        $archiveSizeMb = [math]::Round(((Get-Item $zipPath).Length / 1MB), 2)&#x0d;&#x0a;        Write-Host &quot;归档打包完成！包大小: $archiveSizeMb MB&quot; -ForegroundColor Green&#x0d;&#x0a;    }&#x0d;&#x0a;&#x0d;&#x0a;    # 清理过期旧备份&#x0d;&#x0a;    $cutoffDate = (Get-Date).AddDays(-$RetainDays)&#x0d;&#x0a;    Get-ChildItem -Path $BackupRoot -Filter &quot;Artifacts_*.zip&quot; -ErrorAction SilentlyContinue |&#x0d;&#x0a;        Where-Object { $_.LastWriteTime -lt $cutoffDate } |&#x0d;&#x0a;        ForEach-Object {&#x0d;&#x0a;            if ($PSCmdlet.ShouldProcess($_.FullName, &quot;删除超过 $RetainDays 天的历史过期备份&quot;)) {&#x0d;&#x0a;                Write-Host &quot;正在清除过期备份: $($_.Name)&quot; -ForegroundColor Gray&#x0d;&#x0a;                Remove-Item $_.FullName -Force&#x0d;&#x0a;            }&#x0d;&#x0a;        }&#x0d;&#x0a;    Write-Host &quot;=== ✅ 任务流程执行完毕 ===&quot; -ForegroundColor Green&#x0d;&#x0a;}&#x0d;&#x0a;catch {&#x0d;&#x0a;    Write-Error &quot;备份任务异常失败: $($_.Exception.Message)&quot;&#x0d;&#x0a;    exit 1&#x0d;&#x0a;}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 衔接指引：如何自动化调度 -->
                                <Border Background="{DynamicResource BrushAlertBlueBg}" BorderBrush="{DynamicResource BrushAlertBlueBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🔗 进阶学习衔接：写完的脚本，如何让它在 Windows 后台全自动跑起来？" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushAlertBlueText}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 后台长驻守护：若需将脚本封装为系统后台守护服务（开机静默启动、崩溃自重启），详见【步骤三：自带工具排错指南】中的『7. sc.exe / schtasks 后台服务与计划任务』板块。&#x0a;• 周期定时调度：若需定时触发，直接在控制台注册计划任务（schtasks /create /tn &quot;MyAutoTask&quot; /sc daily /tr &quot;powershell.exe -ExecutionPolicy Bypass -File C:\path\backup.ps1&quot; /st 03:00）。保持脚本编写与系统调度的优雅解耦！"
                                                   FontSize="10" Foreground="{DynamicResource BrushAlertBlueText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 4: .reg 注册表文件手写全解 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="📜 板块 4: .reg 注册表文件手写全解 —— 纯文本配置声明的艺术" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <Border Background="{DynamicResource BrushAlertPurpleBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="高阶配置下发" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertPurpleText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="注册表是 Windows NT 体系的中央神经系统。掌握手写 .reg 文件，可在无需图形界面交互的情况下完成系统调优批量注入、软件便携化设置与全自动开荒配置："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- 安全预警看板 -->
                                <Border Background="{DynamicResource BrushAlertRedBg}" BorderBrush="{DynamicResource BrushAlertRedBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="🛑 核心安全警示：绝对不要双击来历不明的 .reg 文件！双击会静默或通过 UAC 弹窗将全部配置直接写入系统底层，无「撤回」按钮。收到陌生 .reg 时，务必先【右键 -&gt; 编辑 (记事本)】逐行审阅注册表主键路径与键值！"
                                               FontSize="10" Foreground="{DynamicResource BrushAlertRedText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <!-- 语法 4 大关键要素 (双栏排布) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="1. 头部声明规范与主键路径:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock Text="第一行必须精确书写：Windows Registry Editor Version 5.00，后跟一个空行。主键路径使用方括号括起，例如：[HKEY_CURRENT_USER\Software\MyApp]。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="2. 常见数据类型字面量写法:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2"/>
                                            <TextBlock Text="• 字符串 (REG_SZ): &quot;Key&quot;=&quot;Value&quot; (注意路径反斜杠必须写双反斜杠 \\ 转义!)&#x0a;• 32位整型 (REG_DWORD): &quot;Enabled&quot;=dword:00000001 (十六进制8位)&#x0a;• 默认项 (Default): @=&quot;MyDefaultValue&quot;" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="3. 核心删除机制 (减号符号 - 的妙用):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushAlertErrorText}" Margin="0,0,0,2"/>
                                            <TextBlock Text="• 删除整项 (Key): 在路径方括号最前端加减号：[-HKEY_CURRENT_USER\Software\MyApp]&#x0a;• 删除单个键值 (Value): 将键值设为减号：&quot;OldSetting&quot;=-&#x0a;新手最常犯的错误是用空字符串替换，那只会置空而不是从注册表物理移除！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="4. 导出与静默导入指令:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2"/>
                                            <TextBlock Text="导出: regedit.exe /e backup.reg &quot;HKEY_CURRENT_USER\Software\MyApp&quot;&#x0a;静默无弹窗导入: regedit.exe /s config.reg" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushSuccess}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 手写 .reg 范例模板 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄 标准规范范例：app_settings.reg (含字符串、DWORD、键值删除与整项清理)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 一键复制 .reg 完整模板" Background="#16A34A" FontSize="10" Padding="8,2"
                                                    Click="BtnCopySnippet_Click" Tag="Windows Registry Editor Version 5.00&#x0d;&#x0a;&#x0d;&#x0a;; 示例 1: 新增或修改配置项 (字符串、DWORD 与双反斜杠转义)&#x0d;&#x0a;[HKEY_CURRENT_USER\Software\AgyDemoTool]&#x0d;&#x0a;@=&quot;Agy Registry Configuration Demo&quot;&#x0d;&#x0a;&quot;AppVersion&quot;=&quot;1.0.0&quot;&#x0d;&#x0a;&quot;InstallDir&quot;=&quot;C:\\Program Files\\AgyTool&quot;&#x0d;&#x0a;&quot;EnableHardwareAcceleration&quot;=dword:00000001&#x0d;&#x0a;&quot;TelemetryLevel&quot;=dword:00000000&#x0d;&#x0a;&#x0d;&#x0a;; 示例 2: 删除已废弃的旧键值 (设置等于负号)&#x0d;&#x0a;&quot;ObsoleteLegacySetting&quot;=-&#x0d;&#x0a;&#x0d;&#x0a;; 示例 3: 物理删除整个废弃子项 (在括号开头加负号)&#x0d;&#x0a;[-HKEY_CURRENT_USER\Software\AgyDemoTool\DeprecatedCache]&#x0d;&#x0a;"/>
                                        </Grid>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="8" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                 Text="Windows Registry Editor Version 5.00&#x0d;&#x0a;&#x0d;&#x0a;; 示例 1: 新增或修改配置项 (字符串、DWORD 与双反斜杠转义)&#x0d;&#x0a;[HKEY_CURRENT_USER\Software\AgyDemoTool]&#x0d;&#x0a;@=&quot;Agy Registry Configuration Demo&quot;&#x0d;&#x0a;&quot;AppVersion&quot;=&quot;1.0.0&quot;&#x0d;&#x0a;&quot;InstallDir&quot;=&quot;C:\\Program Files\\AgyTool&quot;&#x0d;&#x0a;&quot;EnableHardwareAcceleration&quot;=dword:00000001&#x0d;&#x0a;&quot;TelemetryLevel&quot;=dword:00000000&#x0d;&#x0a;&#x0d;&#x0a;; 示例 2: 删除已废弃的旧键值 (设置等于负号)&#x0d;&#x0a;&quot;ObsoleteLegacySetting&quot;=-&#x0d;&#x0a;&#x0d;&#x0a;; 示例 3: 物理删除整个废弃子项 (在括号开头加负号)&#x0d;&#x0a;[-HKEY_CURRENT_USER\Software\AgyDemoTool\DeprecatedCache]"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 板块 5: 冷门但真实存在的 .hta -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="🌐 板块 5: 冷门但真实存在的 .hta (HTML Application 原生微型前端应用)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <Border Background="{DynamicResource BrushAlertYellowBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="免装 Electron" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertYellowText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="Windows 深度内置的 mshta.exe。无需安装 Node.js、Electron 或 WebView2，纯靠系统自带解释器就能渲染 HTML+CSS+JavaScript，且天然拥有与 Win32 进程同等的完全系统特权（无浏览器沙箱阻隔，可自由调用 shell 与剪贴板）："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄 极简免编译微型 GUI 范例：popup.hta (双击即可原生弹窗运行)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 一键复制 popup.hta 源码" Background="#16A34A" FontSize="10" Padding="8,2"
                                                    Click="BtnCopySnippet_Click" Tag="&lt;!DOCTYPE html&gt;&#x0d;&#x0a;&lt;html&gt;&#x0d;&#x0a;&lt;head&gt;&#x0d;&#x0a;  &lt;meta charset=&quot;UTF-8&quot;&gt;&#x0d;&#x0a;  &lt;title&gt;Windows 原生微型工具弹窗&lt;/title&gt;&#x0d;&#x0a;  &lt;HTA:APPLICATION ID=&quot;oHTA&quot; APPLICATIONNAME=&quot;MiniApp&quot; BORDER=&quot;thin&quot; SCROLL=&quot;no&quot; SINGLEINSTANCE=&quot;yes&quot; /&gt;&#x0d;&#x0a;  &lt;style&gt;&#x0d;&#x0a;    body { font-family: 'Segoe UI', sans-serif; background: #1e1e1e; color: #fff; padding: 16px; margin: 0; }&#x0d;&#x0a;    button { background: #0078d4; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; margin-right: 6px; }&#x0d;&#x0a;    .output { margin-top: 10px; padding: 8px; background: #2d2d2d; border-radius: 4px; font-family: Consolas; font-size: 11px; }&#x0d;&#x0a;  &lt;/style&gt;&#x0d;&#x0a;&lt;/head&gt;&#x0d;&#x0a;&lt;body&gt;&#x0d;&#x0a;  &lt;h3&gt;⚡ 免编译原生 HTA 微型控制台&lt;/h3&gt;&#x0d;&#x0a;  &lt;button onclick=&quot;runCmd('calc.exe')&quot;&gt;唤醒计算器&lt;/button&gt;&#x0d;&#x0a;  &lt;button onclick=&quot;runCmd('explorer.exe .')&quot;&gt;打开当前目录&lt;/button&gt;&#x0d;&#x0a;  &lt;div class=&quot;output&quot; id=&quot;log&quot;&gt;等待操作...&lt;/div&gt;&#x0d;&#x0a;  &lt;script&gt;&#x0d;&#x0a;    window.resizeTo(480, 260);&#x0d;&#x0a;    function runCmd(cmd) {&#x0d;&#x0a;      try {&#x0d;&#x0a;        var wsh = new ActiveXObject('WScript.Shell');&#x0d;&#x0a;        wsh.Run(cmd, 1, false);&#x0d;&#x0a;        document.getElementById('log').innerText = '成功调用: ' + cmd;&#x0d;&#x0a;      } catch(e) {&#x0d;&#x0a;        document.getElementById('log').innerText = '错误: ' + e.message;&#x0d;&#x0a;      }&#x0d;&#x0a;    }&#x0d;&#x0a;  &lt;/script&gt;&#x0d;&#x0a;&lt;/body&gt;&#x0d;&#x0a;&lt;/html&gt;"/>
                                        </Grid>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="8" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                 Text="&lt;!DOCTYPE html&gt;&#x0d;&#x0a;&lt;html&gt;&#x0d;&#x0a;&lt;head&gt;&#x0d;&#x0a;  &lt;meta charset=&quot;UTF-8&quot;&gt;&#x0d;&#x0a;  &lt;title&gt;Windows 原生微型工具弹窗&lt;/title&gt;&#x0d;&#x0a;  &lt;HTA:APPLICATION ID=&quot;oHTA&quot; APPLICATIONNAME=&quot;MiniApp&quot; BORDER=&quot;thin&quot; SCROLL=&quot;no&quot; SINGLEINSTANCE=&quot;yes&quot; /&gt;&#x0d;&#x0a;  &lt;style&gt;&#x0d;&#x0a;    body { font-family: 'Segoe UI', sans-serif; background: #1e1e1e; color: #fff; padding: 16px; margin: 0; }&#x0d;&#x0a;    button { background: #0078d4; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; margin-right: 6px; }&#x0d;&#x0a;    .output { margin-top: 10px; padding: 8px; background: #2d2d2d; border-radius: 4px; font-family: Consolas; font-size: 11px; }&#x0d;&#x0a;  &lt;/style&gt;&#x0d;&#x0a;&lt;/head&gt;&#x0d;&#x0a;&lt;body&gt;&#x0d;&#x0a;  &lt;h3&gt;⚡ 免编译原生 HTA 微型控制台&lt;/h3&gt;&#x0d;&#x0a;  &lt;button onclick=&quot;runCmd('calc.exe')&quot;&gt;唤醒计算器&lt;/button&gt;&#x0d;&#x0a;  &lt;button onclick=&quot;runCmd('explorer.exe .')&quot;&gt;打开当前目录&lt;/button&gt;&#x0d;&#x0a;  &lt;div class=&quot;output&quot; id=&quot;log&quot;&gt;等待操作...&lt;/div&gt;&#x0d;&#x0a;  &lt;script&gt;&#x0d;&#x0a;    window.resizeTo(480, 260);&#x0d;&#x0a;    function runCmd(cmd) {&#x0d;&#x0a;      try {&#x0d;&#x0a;        var wsh = new ActiveXObject('WScript.Shell');&#x0d;&#x0a;        wsh.Run(cmd, 1, false);&#x0d;&#x0a;        document.getElementById('log').innerText = '成功调用: ' + cmd;&#x0d;&#x0a;      } catch(e) {&#x0d;&#x0a;        document.getElementById('log').innerText = '错误: ' + e.message;&#x0d;&#x0a;      }&#x0d;&#x0a;    }&#x0d;&#x0a;  &lt;/script&gt;&#x0d;&#x0a;&lt;/body&gt;&#x0d;&#x0a;&lt;/html&gt;"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
