                                                 Text="Windows Registry Editor Version 5.00&#x0d;&#x0a;[HKEY_CLASSES_ROOT\.txt\ShellNew]&#x0d;&#x0a;&quot;NullFile&quot;=&quot;&quot;&#x0d;&#x0a;[-HKEY_CLASSES_ROOT\Directory\Background\shellex\ContextMenuHandlers\MaliciousAdWareHandler]"/>
