                        <!-- 板块 2: .bat 批处理从零写起 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="🔨 板块 2: .bat 批处理从零写起 —— 核心语法与高可用实战" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <Border Background="{DynamicResource BrushAlertGreenBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="经典批处理精要" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertGreenText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="虽然批处理语法古老，但在极客开箱、制作免依赖自解压安装包与双击启动器中依然不可替代。掌握以下 5 大核心机制即可写出稳健脚本："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- 语法 5 大关键卡片 (双栏排布) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
