                                                 Text="@echo off&#x0d;&#x0a;:: 提示：排查脚本执行时，可将上一行改为 @echo on 观察展开态&#x0d;&#x0a;setlocal EnableExtensions EnableDelayedExpansion&#x0d;&#x0a;title Windows 原生临时文件安全清理工具&#x0d;&#x0a;cd /d &quot;%~dp0&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [INFO] 正在初始化环境，工作根目录：%cd%&#x0d;&#x0a;set /a deleted_count=0&#x0d;&#x0a;set &quot;TARGET_DIR=%TEMP%&quot;&#x0d;&#x0a;&#x0d;&#x0a;if not exist &quot;!TARGET_DIR!&quot; (&#x0d;&#x0a;    echo [ERROR] 目标临时目录不存在: !TARGET_DIR!&#x0d;&#x0a;    exit /b 1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo [INFO] 正在扫描并清理临时垃圾文件...&#x0d;&#x0a;for /r &quot;!TARGET_DIR!&quot; %%i in (*.tmp *.log) do (&#x0d;&#x0a;    del /f /q &quot;%%i&quot; >nul 2>&amp;1&#x0d;&#x0a;    if not exist &quot;%%i&quot; (&#x0d;&#x0a;        set /a deleted_count+=1&#x0d;&#x0a;    )&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo [SUCCESS] 清理完成！共释放 !deleted_count! 个无用临时文件。&#x0d;&#x0a;endlocal&#x0d;&#x0a;exit /b 0"/>
