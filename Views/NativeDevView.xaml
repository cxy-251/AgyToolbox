                                            <TextBlock Text="上一条命令执行失败时 %ERRORLEVEL% 通常非 0。使用 if %ERRORLEVEL% neq 0 (goto :err) 拦截错误；脚本结束务必用 exit /b %CODE% 退出，切忌裸写 exit 导致宿主终端直接被关掉。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="4. for 循环与文本解析 (for /f):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2"/>
                                            <TextBlock Text="遍历文件: for %%f in (*.log) do del &quot;%%f&quot;&#x0a;遍历命令输出: for /f &quot;tokens=1,2&quot; %%a in ('tasklist') do echo %%a %%b" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
