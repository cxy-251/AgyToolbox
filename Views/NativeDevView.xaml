                                <TextBlock Text="虽然批处理语法古老，但在极客开箱、制作免依赖自解压安装包与双击启动器中依然不可替代。掌握以下 5 大核心机制即可写出稳健脚本："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- 语法 5 大关键卡片 (双栏排布) -->
