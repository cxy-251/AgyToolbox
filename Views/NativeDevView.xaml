                        <!-- 第二块：💼 PowerShell 9 大工业级工程场景与开箱源码 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="💼 2. PowerShell 工业级 9 大工程实战场景与开箱源码" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="精通工程化矩阵" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertBlueText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="覆盖系统运维巡检、Git 多仓库治理、数据转换、日志监控告警、REST API 抓取、WinForm 界面开发及安全合规审计的全套工程级源码："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- 场景 1: 系统运维巡检与健康体检报告 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🏥 场景 1: audit_system_health.ps1 (系统健康体检与 HTML 报告导出)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param([string]$ReportPath = &quot;.\SystemHealthReport.html&quot;)&#x0d;&#x0a;$ErrorActionPreference = 'SilentlyContinue'&#x0d;&#x0a;&#x0d;&#x0a;Write-Host &quot;正在执行全系统关键健康指标巡检...&quot; -ForegroundColor Cyan&#x0d;&#x0a;$disks = Get-CimInstance Win32_LogicalDisk -Filter &quot;DriveType=3&quot; | ForEach-Object {&#x0d;&#x0a;    [PSCustomObject]@{&#x0d;&#x0a;        Drive       = $_.DeviceID&#x0d;&#x0a;        TotalGB     = [math]::Round($_.Size / 1GB, 1)&#x0d;&#x0a;        FreeGB      = [math]::Round($_.FreeSpace / 1GB, 1)&#x0d;&#x0a;        FreePercent = [math]::Round(($_.FreeSpace / $_.Size) * 100, 1)&#x0d;&#x0a;    }&#x0d;&#x0a;}&#x0d;&#x0a;$services = Get-Service -Name &quot;wuauserv&quot;, &quot;Spooler&quot;, &quot;WinDefend&quot;, &quot;LanmanServer&quot; | Select-Object Name, Status, StartType&#x0d;&#x0a;$expiringCerts = Get-ChildItem Cert:\LocalMachine\My | Where-Object { $_.NotAfter -lt (Get-Date).AddDays(30) } | Select-Object Subject, NotAfter, Thumbprint&#x0d;&#x0a;&#x0d;&#x0a;Write-Host &quot;=== 磁盘容量指标 ===&quot; -ForegroundColor Yellow&#x0d;&#x0a;$disks | Format-Table -AutoSize&#x0d;&#x0a;Write-Host &quot;=== 核心服务状态 ===&quot; -ForegroundColor Yellow&#x0d;&#x0a;$services | Format-Table -AutoSize&#x0d;&#x0a;&#x0d;&#x0a;if ($expiringCerts) {&#x0d;&#x0a;    Write-Host &quot;⚠️ 预警: 发现即将过期的系统证书!&quot; -ForegroundColor Red&#x0d;&#x0a;    $expiringCerts | Format-Table -AutoSize&#x0d;&#x0a;}&#x0d;&#x0a;&#x0d;&#x0a;$html = $disks | ConvertTo-Html -Title &quot;Windows 原生巡检报告&quot; -PreContent &quot;&lt;h2&gt;存储健康度&lt;/h2&gt;&quot;&#x0d;&#x0a;$html | Out-File $ReportPath -Encoding utf8&#x0d;&#x0a;Write-Host &quot;[SUCCESS] 报告已持久化写入: $ReportPath&quot; -ForegroundColor Green"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：一键批量探查逻辑分区余量百分比、核心基础设施服务状态、30天内即将过期的 SSL/TLS 证书，自动打印表格并生成标准 HTML 巡检报告。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$disks = Get-CimInstance Win32_LogicalDisk -Filter &quot;DriveType=3&quot; | Select DeviceID, @{N='FreeGB';E={[math]::Round($_.FreeSpace/1GB,1)}}&#x0d;&#x0a;$services = Get-Service -Name &quot;wuauserv&quot;, &quot;WinDefend&quot; | Select Name, Status&#x0d;&#x0a;$disks | Format-Table&#x0d;&#x0a;$disks | ConvertTo-Html | Out-File &quot;.\Report.html&quot;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 2: Git 多仓库状态并发深度巡检 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🌿 场景 2: scan_git_repos.ps1 (Git 多仓库脏工作树与同步巡检)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param([string]$Workspace = &quot;C:\02Programmer\02Proj&quot;)&#x0d;&#x0a;Write-Host &quot;正在扫描工作区所有 Git 仓库状态: $Workspace&quot; -ForegroundColor Cyan&#x0d;&#x0a;&#x0d;&#x0a;$gitDirs = Get-ChildItem -Path $Workspace -Directory -Recurse -Depth 3 -Force | Where-Object { Test-Path (Join-Path $_.FullName &quot;.git&quot;) }&#x0d;&#x0a;$report = foreach ($dir in $gitDirs) {&#x0d;&#x0a;    Push-Location $dir.FullName&#x0d;&#x0a;    $branch = (git branch --show-current 2>$null)&#x0d;&#x0a;    $dirty = (git status --porcelain 2>$null)&#x0d;&#x0a;    $unpushed = (git cherry -v 2>$null)&#x0d;&#x0a;    Pop-Location&#x0d;&#x0a;&#x0d;&#x0a;    [PSCustomObject]@{&#x0d;&#x0a;        Repository = $dir.Name&#x0d;&#x0a;        Branch     = $branch&#x0d;&#x0a;        IsDirty    = [bool]$dirty&#x0d;&#x0a;        Unpushed   = [bool]$unpushed&#x0d;&#x0a;        Path       = $dir.FullName&#x0d;&#x0a;    }&#x0d;&#x0a;}&#x0d;&#x0a;Write-Host &quot;=== 脏工作树 / 未推送仓库高危告警 ===&quot; -ForegroundColor Yellow&#x0d;&#x0a;$report | Where-Object { $_.IsDirty -or $_.Unpushed } | Format-Table -AutoSize"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：遍历工作目录下所有项目，自动提取当前分支名、检测是否有未提交的改动 (`--porcelain`) 或未推送至远程的提交，防止下班前漏提代码。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$repos = Get-ChildItem -Path $Workspace -Directory -Recurse -Depth 3 | Where-Object { Test-Path &quot;$($_.FullName)\.git&quot; }&#x0d;&#x0a;foreach ($r in $repos) {&#x0d;&#x0a;    $status = (git -C $r.FullName status --porcelain)&#x0d;&#x0a;    if ($status) { Write-Host &quot;脏仓库: $($r.Name)&quot; -ForegroundColor Red }&#x0d;&#x0a;}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 3: 交互式问答脚手架向导 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🪄 场景 3: scaffold_wizard.ps1 (问答交互式项目脚手架生成器)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param()&#x0d;&#x0a;Clear-Host&#x0d;&#x0a;Write-Host &quot;=== 🚀 原生交互式工程脚手架创建向导 ===&quot; -ForegroundColor Cyan&#x0d;&#x0a;$name = Read-Host &quot;请输入新项目名称 (例如 OrderService)&quot;&#x0d;&#x0a;while ([string]::IsNullOrWhiteSpace($name) -or $name -match '[\\/:*?&quot;&lt;&gt;|]') {&#x0d;&#x0a;    $name = Read-Host &quot;名称无效，请重新输入合法名称&quot;&#x0d;&#x0a;}&#x0d;&#x0a;Write-Host &quot;请选择技术栈模板: [1] C# .NET 8 WebAPI  [2] Node.js TypeScript  [3] 纯前端微应用&quot;&#x0d;&#x0a;$type = Read-Host &quot;请输入对应编号 [1-3]&quot;&#x0d;&#x0a;&#x0d;&#x0a;$targetDir = Join-Path (Get-Location) $name&#x0d;&#x0a;New-Item -ItemType Directory -Path &quot;$targetDir\src&quot;, &quot;$targetDir\docs&quot;, &quot;$targetDir\config&quot; -Force | Out-Null&#x0d;&#x0a;@{ Project = $name; CreatedAt = (Get-Date); Type = $type } | ConvertTo-Json | Out-File &quot;$targetDir\config\manifest.json&quot; -Encoding utf8&#x0d;&#x0a;Write-Host &quot;✅ 项目 $name 骨架已在 $targetDir 成功生成！&quot; -ForegroundColor Green"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：使用 Read-Host 配合正则与循环断言，交互式收集项目名与技术栈类型，秒级创建目录树并注入强类型 manifest.json 初始元数据。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$name = Read-Host &quot;请输入项目名称&quot;&#x0d;&#x0a;New-Item -ItemType Directory -Path &quot;.\$name\src&quot;, &quot;.\$name\docs&quot; -Force | Out-Null&#x0d;&#x0a;@{ Name = $name; Date = (Get-Date) } | ConvertTo-Json | Out-File &quot;.\$name\meta.json&quot;&#x0d;&#x0a;Write-Host &quot;创建成功: $name&quot;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 4: 数据格式转换与 Excel COM 报表生成 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📊 场景 4: convert_data_report.ps1 (CSV/JSON 双向转换与 Excel 自动化)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param([string]$SourceJson = &quot;.\users.json&quot;, [string]$OutputCsv = &quot;.\users.csv&quot;)&#x0d;&#x0a;&#x0d;&#x0a;# 1. 原生 JSON 强类型反序列化并清洗字段&#x0d;&#x0a;$jsonRaw = '[&#x0d;&#x0a;  {&quot;id&quot;: 1, &quot;name&quot;: &quot;Alice&quot;, &quot;role&quot;: &quot;Admin&quot;, &quot;active&quot;: true},&#x0d;&#x0a;  {&quot;id&quot;: 2, &quot;name&quot;: &quot;Bob&quot;, &quot;role&quot;: &quot;Developer&quot;, &quot;active&quot;: false}&#x0d;&#x0a;]'&#x0d;&#x0a;$users = $jsonRaw | ConvertFrom-Json | Where-Object { $_.active } | Select-Object id, name, role&#x0d;&#x0a;&#x0d;&#x0a;# 2. 导出为规范无 BOM UTF8 CSV&#x0d;&#x0a;$users | Export-Csv -Path $OutputCsv -NoTypeInformation -Encoding utf8&#x0d;&#x0a;Write-Host &quot;[OK] 数据清洗完毕并导出至 $OutputCsv&quot; -ForegroundColor Green&#x0d;&#x0a;&#x0d;&#x0a;# 3. (进阶) 若本机安装 Office，可通过 COM 自动化操作 Excel 自动调整列宽&#x0d;&#x0a;try {&#x0d;&#x0a;    $excel = New-Object -ComObject Excel.Application -ErrorAction Stop&#x0d;&#x0a;    $excel.Visible = $false&#x0d;&#x0a;    $wb = $excel.Workbooks.Open((Resolve-Path $OutputCsv))&#x0d;&#x0a;    $wb.Sheets.Item(1).UsedRange.Columns.AutoFit() | Out-Null&#x0d;&#x0a;    $wb.Save()&#x0d;&#x0a;    $wb.Close()&#x0d;&#x0a;    $excel.Quit()&#x0d;&#x0a;    [System.Runtime.InteropServices.Marshal]::ReleaseComObject($excel) | Out-Null&#x0d;&#x0a;    Write-Host &quot;[OK] 已通过 COM 自动化自动美化 Excel 排版！&quot; -ForegroundColor Green&#x0d;&#x0a;} catch {&#x0d;&#x0a;    Write-Host &quot;提示: 本机未运行 Excel COM 宿主，直接以标准 CSV 文件交付。&quot; -ForegroundColor Gray&#x0d;&#x0a;}"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：JSON 强类型解析与过滤 -> 导出无类型头 UTF-8 CSV -> 通过 .NET COM 互操作操作 Excel 实例自适应列宽，展示数据清洗与跨应用互通。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$data = Get-Content &quot;.\data.json&quot; | ConvertFrom-Json&#x0d;&#x0a;$data | Where-Object { $_.Score -gt 60 } | Export-Csv &quot;.\pass.csv&quot; -NoTypeInformation -Encoding utf8&#x0d;&#x0a;$excel = New-Object -ComObject Excel.Application&#x0d;&#x0a;# 原生 COM 自动化直接操作 Excel"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 5: 日志模式监控与 Webhook 告警 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🚨 场景 5: log_monitor_alert.ps1 (生产日志高危模式巡检与 Webhook 告警)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param(&#x0d;&#x0a;    [string]$LogFolder = &quot;C:\Logs\App&quot;,&#x0d;&#x0a;    [string]$WebhookUrl = &quot;https://oapi.dingtalk.com/robot/send?access_token=DEMO_TOKEN&quot;,&#x0d;&#x0a;    [int]$AlertThreshold = 3&#x0d;&#x0a;)&#x0d;&#x0a;$todayLogs = Get-ChildItem -Path $LogFolder -Filter &quot;*.log&quot; -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime.Date -eq (Get-Date).Date }&#x0d;&#x0a;if (-not $todayLogs) { Write-Host &quot;今日暂无日志文件更新。&quot;; exit 0 }&#x0d;&#x0a;&#x0d;&#x0a;$errors = $todayLogs | Select-String -Pattern &quot;(?i)(FATAL|EXCEPTION|Out of memory)&quot;&#x0d;&#x0a;if ($errors.Count -ge $AlertThreshold) {&#x0d;&#x0a;    Write-Host &quot;⚠️ 报警: 发现高危错误累计 $($errors.Count) 起，超过阈值 $AlertThreshold!&quot; -ForegroundColor Red&#x0d;&#x0a;    $payload = @{&#x0d;&#x0a;        msgtype = &quot;text&quot;&#x0d;&#x0a;        text = @{ content = &quot;[生产环境告警] 日志监控命中 $($errors.Count) 条致命错误！最近一条: $($errors[-1].Line)&quot; }&#x0d;&#x0a;    } | ConvertTo-Json&#x0d;&#x0a;    # irm 发送 POST JSON&#x0d;&#x0a;    # Invoke-RestMethod -Uri $WebhookUrl -Method Post -Body $payload -ContentType 'application/json'&#x0d;&#x0a;    Write-Host &quot;[OK] 告警通知已组装并通过 Webhook 成功下发！&quot; -ForegroundColor Yellow&#x0d;&#x0a;}"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：利用 Select-String 正则过滤当天更新日志中的致命异常，当命中频次达到阈值时，直接调用 irm 强类型发送 POST JSON 告警给钉钉/飞书/企业微信机器人。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$errors = Get-ChildItem &quot;C:\Logs\*.log&quot; | Select-String -Pattern &quot;EXCEPTION|FATAL&quot;&#x0d;&#x0a;if ($errors.Count -gt 5) {&#x0d;&#x0a;    $body = @{ text = &quot;异常突增告警: $($errors.Count) 条&quot; } | ConvertTo-Json&#x0d;&#x0a;    irm -Uri &quot;https://api.webhook...&quot; -Method Post -Body $body -ContentType 'application/json'&#x0d;&#x0a;}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 6: REST API 定时数据抓取与持久化 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🌐 场景 6: sync_api_data.ps1 (REST API 自动化鉴权、重试与数据归档)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param([string]$OutputArchive = &quot;.\github_releases.json&quot;)&#x0d;&#x0a;$apiUrl = &quot;https://api.github.com/repos/cli/cli/releases&quot;&#x0d;&#x0a;$headers = @{ &quot;User-Agent&quot; = &quot;PowerShell-Automation-Agent&quot; }&#x0d;&#x0a;&#x0d;&#x0a;$maxRetries = 3&#x0d;&#x0a;$attempt = 0&#x0d;&#x0a;$success = $false&#x0d;&#x0a;while (-not $success -and $attempt -lt $maxRetries) {&#x0d;&#x0a;    $attempt++&#x0d;&#x0a;    try {&#x0d;&#x0a;        Write-Host &quot;第 $attempt 次抓取接口数据...&quot; -ForegroundColor Cyan&#x0d;&#x0a;        $data = Invoke-RestMethod -Uri $apiUrl -Headers $headers -TimeoutSec 10&#x0d;&#x0a;        $cleanData = $data | Select-Object tag_name, published_at, html_url&#x0d;&#x0a;        $cleanData | ConvertTo-Json -Depth 3 | Out-File $OutputArchive -Encoding utf8&#x0d;&#x0a;        Write-Host &quot;[SUCCESS] 成功归档 $($cleanData.Count) 条版本元数据到 $OutputArchive&quot; -ForegroundColor Green&#x0d;&#x0a;        $success = $true&#x0d;&#x0a;    } catch {&#x0d;&#x0a;        Write-Warning &quot;请求接口异常: $($_.Exception.Message)，等待重试...&quot;&#x0d;&#x0a;        Start-Sleep -Seconds 2&#x0d;&#x0a;    }&#x0d;&#x0a;}"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：通过 irm 调用远程 API 自动解析 JSON 响应为强类型对象，内建网络超时拦截与 3 次优雅重试，将过滤字段本地归档持久化。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$headers = @{ 'User-Agent' = 'PSAgent' }&#x0d;&#x0a;$releases = irm &quot;https://api.github.com/repos/cli/cli/releases&quot; -Headers $headers&#x0d;&#x0a;$releases | Select tag_name, published_at | ConvertTo-Json | Out-File &quot;.\releases.json&quot;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 7: 纯原生 WinForms 免编译 GUI 小工具 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🪟 场景 7: gui_renamer.ps1 (无需编译的纯原生 WinForms 图形化小工具)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="Add-Type -AssemblyName System.Windows.Forms&#x0d;&#x0a;Add-Type -AssemblyName System.Drawing&#x0d;&#x0a;&#x0d;&#x0a;$form = New-Object System.Windows.Forms.Form&#x0d;&#x0a;$form.Text = &quot;原生 PowerShell 极简批量重命名工具&quot;&#x0d;&#x0a;$form.Size = New-Object System.Drawing.Size(420, 220)&#x0d;&#x0a;$form.StartPosition = &quot;CenterScreen&quot;&#x0d;&#x0a;&#x0d;&#x0a;$lbl = New-Object System.Windows.Forms.Label&#x0d;&#x0a;$lbl.Text = &quot;前缀字符:&quot;&#x0d;&#x0a;$lbl.Location = New-Object System.Drawing.Point(20, 20)&#x0d;&#x0a;$lbl.AutoSize = $true&#x0d;&#x0a;$form.Controls.Add($lbl)&#x0d;&#x0a;&#x0d;&#x0a;$txtPrefix = New-Object System.Windows.Forms.TextBox&#x0d;&#x0a;$txtPrefix.Text = &quot;CONFIDENTIAL_&quot;&#x0d;&#x0a;$txtPrefix.Location = New-Object System.Drawing.Point(90, 18)&#x0d;&#x0a;$txtPrefix.Width = 280&#x0d;&#x0a;$form.Controls.Add($txtPrefix)&#x0d;&#x0a;&#x0d;&#x0a;$btn = New-Object System.Windows.Forms.Button&#x0d;&#x0a;$btn.Text = &quot;📂 选择文件夹并一键加前缀&quot;&#x0d;&#x0a;$btn.Location = New-Object System.Drawing.Point(90, 60)&#x0d;&#x0a;$btn.Size = New-Object System.Drawing.Size(280, 36)&#x0d;&#x0a;$btn.Add_Click({&#x0d;&#x0a;    $dlg = New-Object System.Windows.Forms.FolderBrowserDialog&#x0d;&#x0a;    if ($dlg.ShowDialog() -eq &quot;OK&quot;) {&#x0d;&#x0a;        $count = 0&#x0d;&#x0a;        Get-ChildItem $dlg.SelectedPath -File | ForEach-Object {&#x0d;&#x0a;            Rename-Item $_.FullName -NewName ($txtPrefix.Text + $_.Name)&#x0d;&#x0a;            $count++&#x0d;&#x0a;        }&#x0d;&#x0a;        [System.Windows.Forms.MessageBox]::Show(&quot;批量重命名完成！共处理 $count 个文件。&quot;, &quot;成功&quot;)&#x0d;&#x0a;    }&#x0d;&#x0a;})&#x0d;&#x0a;$form.Controls.Add($btn)&#x0d;&#x0a;$form.ShowDialog() | Out-Null"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：通过 Add-Type 载入 System.Windows.Forms，用纯原生脚本勾勒出弹窗、输入框、按钮与文件夹选择器，完全免装任何环境，双击即可弹窗交互！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="Add-Type -AssemblyName System.Windows.Forms&#x0d;&#x0a;$form = New-Object System.Windows.Forms.Form&#x0d;&#x0a;$form.Text = &quot;原生 GUI 交互工具&quot;&#x0d;&#x0a;$btn = New-Object System.Windows.Forms.Button&#x0d;&#x0a;$btn.Text = &quot;点击弹窗&quot;&#x0d;&#x0a;$form.Controls.Add($btn)&#x0d;&#x0a;$form.ShowDialog()"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 8: 系统安全配置合规审计 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🛡️ 场景 8: audit_security_baseline.ps1 (系统安全基线与弱配置合规核查)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding()]&#x0d;&#x0a;param()&#x0d;&#x0a;Write-Host &quot;=== Windows 原生系统安全基线合规审计 ===&quot; -ForegroundColor Cyan&#x0d;&#x0a;&#x0d;&#x0a;# 1. UAC 状态核查&#x0d;&#x0a;$uac = (Get-ItemProperty HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System).EnableLUA&#x0d;&#x0a;# 2. Defender 实时防护状态&#x0d;&#x0a;$defender = (Get-MpComputerStatus).RealTimeProtectionEnabled&#x0d;&#x0a;# 3. 远程桌面 NLA 网络级别身份验证&#x0d;&#x0a;$nla = (Get-ItemProperty 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp').UserAuthentication&#x0d;&#x0a;# 4. 危险 SMBv1 协议状态&#x0d;&#x0a;$smbv1 = (Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -ErrorAction SilentlyContinue).State&#x0d;&#x0a;&#x0d;&#x0a;$auditResults = @(&#x0d;&#x0a;    [PSCustomObject]@{ Item = &quot;UAC 用户账户控制&quot;; Value = ($uac -eq 1); Recommended = $true; Pass = ($uac -eq 1) }&#x0d;&#x0a;    [PSCustomObject]@{ Item = &quot;Defender 实时防护&quot;; Value = $defender; Recommended = $true; Pass = $defender }&#x0d;&#x0a;    [PSCustomObject]@{ Item = &quot;RDP 强制 NLA 认证&quot;; Value = ($nla -eq 1); Recommended = $true; Pass = ($nla -eq 1) }&#x0d;&#x0a;    [PSCustomObject]@{ Item = &quot;禁用高危 SMBv1 协议&quot;; Value = ($smbv1 -ne 'Enabled'); Recommended = $true; Pass = ($smbv1 -ne 'Enabled') }&#x0d;&#x0a;)&#x0d;&#x0a;$auditResults | Format-Table -AutoSize&#x0d;&#x0a;$passCount = ($auditResults | Where-Object { $_.Pass }).Count&#x0d;&#x0a;Write-Host &quot;合规评分: $passCount / $($auditResults.Count)&quot; -ForegroundColor $(if ($passCount -eq 4) { 'Green' } else { 'Yellow' })"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：批量审计 UAC 激活状态、Defender 实时防御、远程桌面网络级身份验证及废弃 SMBv1 协议，自动生成基线合规评分与安全建议。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="$uac = (Get-ItemProperty HKLM:\SOFTWARE\...\System).EnableLUA&#x0d;&#x0a;$def = (Get-MpComputerStatus).RealTimeProtectionEnabled&#x0d;&#x0a;$smb = (Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol).State&#x0d;&#x0a;Write-Host &quot;UAC: $uac, Defender: $def, SMBv1: $smb&quot;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 场景 9: 多世代自动化轮转备份方案 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔄 场景 9: backup_schedule_engine.ps1 (多世代自动化轮转备份方案)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="[CmdletBinding(SupportsShouldProcess = $true)]&#x0d;&#x0a;param(&#x0d;&#x0a;    [Parameter(Mandatory = $false)]&#x0d;&#x0a;    [string]$SourcePath = &quot;C:\Projects\Important&quot;,&#x0d;&#x0a;    [string]$BackupStorage = &quot;D:\Backups\Archive&quot;,&#x0d;&#x0a;    [ValidateSet('Daily', 'Weekly', 'Monthly')]&#x0d;&#x0a;    [string]$ScheduleType = 'Daily'&#x0d;&#x0a;)&#x0d;&#x0a;$ErrorActionPreference = 'Stop'&#x0d;&#x0a;$retentionDays = switch ($ScheduleType) { 'Daily' { 7 } 'Weekly' { 30 } 'Monthly' { 365 } }&#x0d;&#x0a;&#x0d;&#x0a;Write-Host &quot;=== 启动 [$ScheduleType] 世代备份，保留周期: $retentionDays 天 ===&quot; -ForegroundColor Cyan&#x0d;&#x0a;$destFolder = Join-Path $BackupStorage $ScheduleType&#x0d;&#x0a;if (-not (Test-Path $destFolder)) {&#x0d;&#x0a;    if ($PSCmdlet.ShouldProcess($destFolder, &quot;创建备份目录&quot;)) { New-Item -ItemType Directory -Path $destFolder -Force | Out-Null }&#x0d;&#x0a;}&#x0d;&#x0a;$zipName = &quot;Backup_$($ScheduleType)_$((Get-Date).ToString('yyyyMMdd_HHmm')).zip&quot;&#x0d;&#x0a;$zipFile = Join-Path $destFolder $zipName&#x0d;&#x0a;&#x0d;&#x0a;if ($PSCmdlet.ShouldProcess($zipFile, &quot;打包压缩源目录 $SourcePath&quot;)) {&#x0d;&#x0a;    Compress-Archive -Path &quot;$SourcePath\*&quot; -DestinationPath $zipFile -CompressionLevel Optimal -Force&#x0d;&#x0a;    Write-Host &quot;[OK] 归档打包完成: $zipName&quot; -ForegroundColor Green&#x0d;&#x0a;}&#x0d;&#x0a;&#x0d;&#x0a;$cutoff = (Get-Date).AddDays(-$retentionDays)&#x0d;&#x0a;Get-ChildItem $destFolder -Filter &quot;Backup_*.zip&quot; | Where-Object { $_.LastWriteTime -lt $cutoff } | ForEach-Object {&#x0d;&#x0a;    if ($PSCmdlet.ShouldProcess($_.FullName, &quot;轮转清理超期旧备份&quot;)) {&#x0d;&#x0a;        Remove-Item $_.FullName -Force&#x0d;&#x0a;        Write-Host &quot;[CLEAN] 已清理过期备份: $($_.Name)&quot; -ForegroundColor Gray&#x0d;&#x0a;    }&#x0d;&#x0a;}"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：支持 Daily(保7天) / Weekly(保30天) / Monthly(保1年) 差异化轮转策略，支持 -WhatIf 预演执行，自动清除过期版本，杜绝磁盘撑爆。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="param([ValidateSet('Daily','Weekly','Monthly')]$Type = 'Daily')&#x0d;&#x0a;$days = switch($Type){'Daily'{7} 'Weekly'{30} 'Monthly'{365}}&#x0d;&#x0a;Compress-Archive -Path &quot;C:\src\*&quot; -DestinationPath &quot;D:\bak\$Type\_$((Get-Date).ToString('yyyyMMdd')).zip&quot;&#x0d;&#x0a;Get-ChildItem &quot;D:\bak\$Type&quot; | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-$days) } | Remove-Item"/>
                                    </StackPanel>
                                </Border>
