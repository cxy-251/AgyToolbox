                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚔️ 3. CMD 纯字符流 vs PowerShell 强类型对象级指令对照矩阵" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
