<UserControl x:Class="AgyToolbox.Views.NativeDevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="💻 步骤四：原生开发环境与现代终端基建 (Native Dev &amp; Infrastructure)" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                <TextBlock Text="现代 Windows 内置了大量专业级硬核开发工具：无需安装臃肿的第三方软件，即可获得 WSL2 虚拟机、Windows Sandbox 纯净沙箱、ReFS 开发驱动器 (Dev Drive)、原生 sudo 提权、PktMon 内核抓包、死锁句柄检索与 API 调试等全套生产力工具。"
                           FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 5 个功能横向子标签 -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 虚拟化与驱动基建 (WSL2 / Sandbox / Dev Drive / Dev Home) -->
            <TabItem Header="🐧 虚拟化与驱动基建">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 第一排：WSL2 与 Windows Sandbox -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- WSL2 卡片 -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,7,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🐧 1. WSL2 (Linux 子系统)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtWslStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="在 Windows 上以原生轻量级虚拟机方式运行完整 Linux 内核环境，支持 Docker Desktop 原生后端与 GPU 加速计算开发。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <TextBlock Text="💡 存储建议：WSL 虚拟磁盘默认保存在系统 C 盘。若需迁移，可在部署后使用 wsl --export 和 wsl --import 转移至大容量数据盘。" FontSize="10" Foreground="#B45309" TextWrapping="Wrap"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="检测状态" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckWsl_Click"/>
                                        <Button Grid.Column="1" Content="安装 WSL2" Background="#0284C7" Margin="4,0,0,0" Click="BtnInstallWsl_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Windows Sandbox 沙箱卡片 -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="7,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📦 2. Windows Sandbox (原生沙箱)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSandboxStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="微软官方纯净轻量隔离运行环境。每次启动均为全新初始状态，测试完毕关闭窗口后自动彻底销毁所有数据，避免流氓软件污染宿主系统。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <TextBlock Text="💡 说明：仅限 Windows 专业版 / 企业版。启用后需重启系统一次，按 Win+S 搜 Windows Sandbox 即可随时启动。" FontSize="10" Foreground="#047857" TextWrapping="Wrap"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="检测状态" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckSandbox_Click"/>
                                        <Button Grid.Column="1" Content="启用原生沙箱" Background="#10B981" Margin="4,0,0,0" Click="BtnEnableSandbox_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 第二排：Dev Drive 与 Dev Home -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 3. Dev Drive (开发驱动器 / ReFS 文件系统) &amp; Dev Home" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="🔥 强烈推荐 / Win11 专属" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                                        </Border>
                                        <TextBlock Text=" (写时复制 CoW 专治 node_modules 膨胀与编译 I/O 瓶颈)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDevDriveStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnRefreshDevDrive_Click"/>
                                        <Button Content="⚙️ 创建 Dev Drive 分区" Background="#0284C7" Margin="0,0,6,0" Click="BtnOpenDisksSettings_Click"/>
                                        <Button Content="🏠 打开 Dev Home" Background="#10B981" Click="BtnLaunchDevHome_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 为什么现代开发者强烈推荐使用 Dev Drive？" FontWeight="Bold" FontSize="12" Foreground="#3730A3" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 底层基于 ReFS (复原文件系统) 格式，原生开启【写时复制 (Copy-on-Write / CoW)】与虚拟化性能优化。&#x0a;• 核心价值：专门用于存放 node_modules、Git 仓库代码、Cargo/Maven 依赖缓存与中间编译产物。实测在大型项目构建、npm install 和 Git checkout 操作中，磁盘 I/O 速度提升 20%~30%！&#x0a;• 安全模式：Dev Drive 采用性能模式防病毒扫描（避免传统杀毒软件对几十万个小文件逐个同步扫描卡死）。"
                                                   FontSize="11" Foreground="#4338CA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="fsutil 查询 Dev Drive 驱动器状态与防病毒模式:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="fsutil devdrv query" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="fsutil devdrv query"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="通过 winget 一键安装微软官方 Dev Home 仪表盘:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="winget install --id Microsoft.DevHome --source winget" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="winget install --id Microsoft.DevHome --source winget"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第三排：WSL 与沙箱进阶运维指令 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🛠️ 4. WSL 与沙箱常用运维命令速查" FontWeight="Bold" FontSize="13" Foreground="#0078D4" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="彻底关停 WSL 虚拟机释放内存占用:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="wsl --shutdown" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Padding="8,2" Margin="6,0,0,0" Click="BtnCopySnippet_Click" Tag="wsl --shutdown"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="查看已安装发行版及运行版本状态:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="wsl -l -v" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Padding="8,2" Margin="6,0,0,0" Click="BtnCopySnippet_Click" Tag="wsl -l -v"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="迁移导出发行版归档 (以 Ubuntu 为例):" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="wsl --export Ubuntu-22.04 D:\wsl_backup\ubuntu.tar" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                    <Button Grid.Column="2" Content="📋" Style="{DynamicResource SecondaryButton}" Padding="8,2" Margin="6,0,0,0" Click="BtnCopySnippet_Click" Tag="wsl --export Ubuntu-22.04 D:\wsl_backup\ubuntu.tar"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 权限特权与开发者模式 (Sudo / Developer Mode / SSH / icacls) -->
            <TabItem Header="🔑 权限特权与开发者模式">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 第一块：Win11 原生 Sudo -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ 1. Win11 24H2+ 原生 sudo 提权控制" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="✨ 24H2 新特性 / 内联提权" FontSize="10" FontWeight="Bold" Foreground="#4338CA"/>
                                        </Border>
                                        <TextBlock Text=" (告别右键'以管理员身份运行'，在当前终端内直接提权执行)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSudoStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔄 刷新" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnRefreshSudo_Click"/>
                                        <Button Content="🟢 启用 (内联当前窗口)" Background="#10B981" Margin="0,0,6,0" Click="BtnEnableSudoNormal_Click"/>
                                        <Button Content="🪟 启用 (独立弹窗)" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Click="BtnEnableSudoWindow_Click"/>
                                        <Button Content="🛑 禁用" Background="#EF4444" Click="BtnDisableSudo_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 原生 sudo 与传统 UAC 提权的区别：" FontWeight="Bold" FontSize="11" Foreground="#78350F" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 传统做法：必须右键终端快捷方式，选“以管理员身份运行”，打开一个崭新的空白工作目录窗口，极其繁琐。&#x0a;• 原生 sudo：在当前目录、当前 PowerShell 或 CMD 内直接执行 sudo &lt;命令&gt;，行为与 Linux sudo 保持一致。&#x0a;• 模式差异：normal 模式下 stdout/stdin 完全内联在当前终端；forceNewWindow 模式下安全弹出独立高权限窗口。"
                                                   FontSize="10" Foreground="#92400E" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="命令行直接提权启动服务或修改注册表:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="sudo net start wuauserv" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="sudo net start wuauserv"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="命令行查看或配置 sudo 运行模式:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="sudo config --enable normal" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="sudo config --enable normal"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第二块：开发者模式与符号链接权限 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🔗 2. Windows 开发者模式与免提权符号链接 (Developer Mode &amp; Symlink)" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (允许非管理员普通权限直接创建软链接，pnpm 与 npm link 必备)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDevModeStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnToggleDevMode" Content="开启开发者模式" Background="#0284C7" Margin="0,0,6,0" Click="BtnToggleDevMode_Click"/>
                                        <Button Content="打开设置页" Style="{DynamicResource SecondaryButton}" FontSize="11" Click="BtnOpenDevSettings_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 为什么现代开发者必须开启 Developer Mode？普通模式下 Windows 要求必须有管理员 UAC 特权才能创建软链接；开启开发者模式后，系统策略允许普通标准用户进程免提权直接创建软链接！pnpm（基于全局软链接索引结构）、npm/yarn link 本地多包联调、Python 虚拟环境及 Git core.symlinks 才能顺畅工作。"
                                               FontSize="11" Foreground="#4338CA" TextWrapping="Wrap"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="免提权创建目录软链接 (cmd 语法):" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="cmd /c mklink /D link_folder target_folder" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="cmd /c mklink /D link_folder target_folder"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="PowerShell 原生创建软链接语法:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="New-Item -ItemType SymbolicLink -Path .\link -Target .\target" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="New-Item -ItemType SymbolicLink -Path .\link -Target .\target"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第三块：icacls & takeown 权限手术刀 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="🪓 3. icacls &amp; takeown 权限手术刀 (排查 Access is denied 拒绝访问)" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="🛡️ 进阶 / 提权赋权" FontSize="10" FontWeight="Bold" Foreground="#B91C1C"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="开发过程中经常遇到 npm 缓存文件锁死、Git 仓库拒绝访问或无法删除目录，原生命令行工具 2 步彻底解决：" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- takeown 夺取所有权 -->
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="第 1 步：强制将目录所有权收归当前用户 (takeown)" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,2"/>
                                            <TextBlock Text="/r 递归所有子项，/d y 遇到提示自动选 yes，破除文件所属人锁定：" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="takeown /f &quot;C:\path\to\target&quot; /r /d y" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="takeown /f &quot;C:\path\to\target&quot; /r /d y"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- icacls 赋权或重置 -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="第 2 步：递归授予管理员完全控制权 (icacls)" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,2"/>
                                            <TextBlock Text=":F 代表 Full control 完全控制，/t 遍历树状子目录，/c 忽略错误继续：" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="icacls &quot;C:\path\to\target&quot; /grant Administrators:F /t /c" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="icacls &quot;C:\path\to\target&quot; /grant Administrators:F /t /c"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第四块：OpenSSH 认证与 Agent 自启 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🔑 4. OpenSSH 密钥认证与 ssh-agent 开机自启服务" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (解决终端操作与 Git push 每次都提示输入私钥口令)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSshAgentStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnEnableSshAgent" Content="开启 ssh-agent 自启" Background="#0284C7" Click="BtnEnableSshAgent_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="生成现代高安全 Ed25519 密钥 (替代 RSA):" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="将私钥添加至代理并测试 GitHub 连通性:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="ssh-add ~\.ssh\id_ed25519 &amp;&amp; ssh -T git@github.com" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="ssh-add ~\.ssh\id_ed25519 &amp;&amp; ssh -T git@github.com"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 原生网络与系统诊断 (pktmon / 路由 / resmon / 性能) -->
            <TabItem Header="🩺 原生网络与系统诊断">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 第一部分：PktMon 内核抓包监视器 (重磅) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🦈 1. PktMon 内核级数据包监视器 (免装 Wireshark 抓包)" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="⚡ 深度排障 / 内核级" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                        </Border>
                                        <TextBlock Text=" (Windows 内核自带抓包驱动，支持导出标准 .pcapng 格式)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="🚀 在管理员终端启动抓包" Background="#0284C7" Click="BtnStartPktMon_Click"/>
                                </Grid>

                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="💡 为什么不需要装第三方 Wireshark 驱动？Windows 10 1809+ / Win 11 内置了 pktmon.exe，深入操作系统网络协议栈内核驱动层。抓取完毕后可直接用 etl2pcap 转换为标准 pcapng 文件，用任何网络分析工具随时打开。"
                                               FontSize="11" Foreground="#065F46" TextWrapping="Wrap"/>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="步骤 1：添加端口过滤规则 (例如只抓 8080 端口，避免干扰):" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="pktmon filter add -p 8080" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="pktmon filter add -p 8080"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="步骤 2：启动完整捕获 (截断大小设为 0 保留完整载荷):" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="pktmon start --capture --pkt-size 0" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="pktmon start --capture --pkt-size 0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="步骤 3：停止抓包并重置过滤器:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="pktmon stop &amp;&amp; pktmon filter remove" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="pktmon stop &amp;&amp; pktmon filter remove"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="步骤 4：无损转为 Wireshark 兼容的标准 pcapng 格式:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBox Text="pktmon etl2pcap PktMon.etl --out trace.pcapng" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="pktmon etl2pcap PktMon.etl --out trace.pcapng"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第二部分：网络路由跳数与链路实时诊断 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🌐 2. 网络路由跳数追踪与链路诊断 (Route &amp; Trace)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,4"/>
                                <TextBlock Text="排查网络在哪个路由器节点中断、高延迟瓶颈、以及局域网物理设备发现：" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <!-- 控制区 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标主机 / IP：" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtRouteHost" Grid.Column="1" Text="1.1.1.1" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"/>

                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="⚡ tracert -d (极速跳数)" Margin="0,0,6,4" Click="BtnTracertFast_Click"/>
                                        <Button Content="📊 pathping (深度丢包)" Margin="0,0,6,4" Click="BtnPathping_Click"/>
                                        <Button Content="🗺️ route print (路由表)" Margin="0,0,6,4" Click="BtnRoutePrint_Click"/>
                                        <Button Content="🔎 arp -a (局域网设备)" Margin="0,0,6,4" Click="BtnArp_Click"/>
                                        <Button x:Name="BtnStopDiag" Content="⏹️ 停止" Background="#EF4444" Margin="0,0,6,4" Click="BtnStopDiag_Click" IsEnabled="False"/>
                                        <Button Content="🧹 清空" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,4" Click="BtnClearDiagLog_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <!-- 实时黑色控制台输出框 -->
                                <TextBox x:Name="TxtDiagConsole" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                         Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas, Courier New" FontSize="11"
                                         Padding="8" TextWrapping="Wrap"
                                         Text="[网络诊断控制台已就绪] 请输入目标主机（如 1.1.1.1、baidu.com、github.com），并点击上方诊断命令开始执行...&#x0a;"/>
                            </StackPanel>
                        </Border>

                        <!-- 第三部分：原生系统诊断矩阵 (resmon / perfmon / Test-NetConnection / eventvwr / wpr) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🩺 3. Windows 原生系统诊断、死锁句柄与性能剖析矩阵" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,4"/>
                                <TextBlock Text="操作系统内核内置诊断工具，快速排查文件死锁、IOPS 饱和、端口连通性、程序闪退与 ETW 跟踪：" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：死锁句柄与性能剖析 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                        <!-- 资源监视器 resmon -->
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🔒 资源监视器 (resmon) · 搜索死锁文件句柄" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                    <Button Grid.Column="1" Content="🚀 打开 resmon" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                            Click="BtnLaunchTool_Click" Tag="resmon.exe"/>
                                                </Grid>
                                                <TextBlock Text="【典型场景】编译报错 'locked by another process' 或删除文件夹提示被另一程序占用。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                <TextBlock Text="【排错步骤】启动 resmon -> 切换至【CPU】选项卡 -> 展开【关联的句柄】面板 -> 搜索文件名 -> 界面会立即列出占用进程名与 PID，右键可强制结束！" FontSize="10" Foreground="#0284C7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 性能监视器 perfmon -->
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="📊 性能监视器 (perfmon) · 深度瓶颈剖析" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                    <Button Grid.Column="1" Content="🚀 打开 perfmon" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                            Click="BtnLaunchTool_Click" Tag="perfmon.exe"/>
                                                </Grid>
                                                <TextBlock Text="【典型场景】磁盘 IOPS 饱和排查、内核硬件中断 (DPC/ISR)、多线程争抢瓶颈定位。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                <TextBlock Text="【排错步骤】添加自定义计数器（如 PhysicalDisk\% Disk Time、Avg. Disk Queue Length），实时监控硬件极限与系统吞吐。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- wpr 性能记录器 -->
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="📈 wpr.exe (Windows 性能记录器)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡ 进阶 / ETW 跟踪" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                                </Border>
                                            </StackPanel>
                                                <TextBlock Text="【典型场景】极度精确抓取 CPU 锁竞争 (Lock Contention)、线程挂起与内核调度瓶颈，配合 WPA 工具深度剖析。" FontSize="10" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <TextBox Text="wpr -start GeneralProfile &amp;&amp; echo 复现后执行: wpr -stop trace.etl" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                            Click="BtnCopySnippet_Click" Tag="wpr -start GeneralProfile"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 右侧：端口探测与崩溃排错 -->
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <!-- Test-NetConnection -->
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📡 Test-NetConnection · 原生 TCP 端口测试 (免 telnet)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                                                <TextBlock Text="【典型场景】测试数据库 3306/5432、Redis 6379 或 Web 443 端口在远程服务器是否开放：" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBox Text="Test-NetConnection github.com -Port 443" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4"/>
                                                    <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                            Click="BtnCopySnippet_Click" Tag="Test-NetConnection github.com -Port 443"/>
                                                </Grid>
                                                <TextBlock Text="简写命令：tnc 192.168.1.1 -p 8080 -TraceRoute (自动探测端口并跟踪路由)" FontSize="10" Foreground="#059669"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 事件查看器 eventvwr -->
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="💥 事件查看器 (eventvwr) · 程序闪退崩溃排查" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                    <Button Grid.Column="1" Content="🚀 打开 eventvwr" Style="{DynamicResource SecondaryButton}" Padding="8,2" FontSize="11"
                                                            Click="BtnLaunchTool_Click" Tag="eventvwr.msc"/>
                                                </Grid>
                                                <TextBlock Text="【典型场景】程序或后台服务静默闪退、没有任何弹窗报错，需要定位抛出异常的具体模块。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                <TextBlock Text="【排错步骤】打开 eventvwr -> 导航至【Windows 日志】->【应用程序】-> 筛选日志级别为【错误】-> 查看来源为 .NET Runtime 或 Application Error 的崩溃调用栈。" FontSize="10" Foreground="#7C3AED" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 原生 CLI、服务与 API 调试器 (certutil / fsutil / sc / irm) -->
            <TabItem Header="📜 原生 CLI、服务与 API 调试器">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 第一块：certutil 与 fsutil 原生利器 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🛡️ 1. 高频文件、哈希与加密实用工具 (certutil &amp; fsutil)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,4"/>
                                <TextBlock Text="无需安装 HashCalc、WinRAR 或其它测试生成工具，系统原生具备密码学与文件系统操作能力：" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- certutil 计算哈希 -->
