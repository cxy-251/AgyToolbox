<UserControl x:Class="AgyToolbox.Views.NativeDevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgyToolbox.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1600" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <StackPanel Margin="10">

            <!-- 模块说明看板 -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💻 步骤四：原生开发环境与现代终端基建 (Native Dev &amp; Infrastructure)" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock Text="Windows 现代版本提供了完善的原生开发与隔离运行环境支持。本模块协助配置 WSL2 (Windows Subsystem for Linux)、Windows Sandbox 原生沙箱隔离环境，以及开机自启的 OpenSSH Agent 认证服务，并提供原生命令行工具与网络诊断参考。"
                               FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 板块 1: WSL2 与原生沙箱基建 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🐧 1. 虚拟化与系统隔离：WSL2 与 Windows Sandbox 沙箱" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="轻量级 Linux 内核子系统与一次性纯净隔离测试环境：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- WSL2 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WSL2 (Linux 子系统)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWslStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="在 Windows 上以轻量虚拟化方式运行 Linux 内核环境，支持 Docker 后端与 GPU 加速计算。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="💡 存储建议：WSL 虚拟硬盘默认存储在系统盘。若需调整存储位置，可在部署后使用 wsl --export 和 wsl --import 迁移到数据分区。" FontSize="10" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="检测状态" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckWsl_Click"/>
                                    <Button Grid.Column="1" Content="安装 WSL2" Background="#0284C7" Margin="4,0,0,0" Click="BtnInstallWsl_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Windows Sandbox -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Windows Sandbox (原生沙箱)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSandboxStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="系统内置的轻量隔离运行环境。每次启动均为纯净初始状态，关闭后自动清除运行数据，适用于隔离测试未知软件包。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="💡 说明：启用后需重启系统一次，按 Win+S 搜 Windows Sandbox 即可运行。" FontSize="10" Foreground="#047857" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="检测状态" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckSandbox_Click"/>
                                    <Button Grid.Column="1" Content="启用原生沙箱" Background="#10B981" Margin="4,0,0,0" Click="BtnEnableSandbox_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 板块 2: 现代终端与 OpenSSH 免密基建 -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔑 2. OpenSSH 密钥认证与 ssh-agent 开机自启服务" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                    <TextBlock Text="系统内置 OpenSSH Client，通过配置开机自启的 ssh-agent，实现 Git 与终端 SSH 免重复输入私钥密码：" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="配置 Windows 原生 OpenSSH Agent 服务为自动启动" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock x:Name="TxtSshAgentStatus" Text="[检测中...]" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Windows 默认将 ssh-agent 服务设为禁用。将其配置为自动启动后，可通过 ssh-add 添加私钥，使后续 Git 操作与 SSH 连接自动完成凭据认证。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnEnableSshAgent" Grid.Column="1" Content="开启 ssh-agent 自启" Background="#0284C7" VerticalAlignment="Center" Click="BtnEnableSshAgent_Click"/>
                        </Grid>
                    </Border>

                    <!-- SSH 快速配置卡片 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="生成现代高安全 Ed25519 密钥 (推荐替代淘汰的 RSA):" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                <TextBox Text="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="11" Padding="4" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋" Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Click="BtnCopySnippet_Click" Tag="ssh-keygen -t ed25519 -C &quot;your_email@example.com&quot;"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 板块 3: 嵌入式原生 CLI 速查与网络链路诊断 (嵌入 RouteCliView) -->
            <views:RouteCliView />

        </StackPanel>
    </ScrollViewer>
</UserControl>
