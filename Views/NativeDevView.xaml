<UserControl x:Class="AgyToolbox.Views.NativeDevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模块说明看板 (保留在 TabControl 外层，始终可见) -->
        <Border Grid.Row="0" Background="{DynamicResource BrushAlertBlueBg}" BorderBrush="{DynamicResource BrushAlertBlueBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="💻 步骤四：原生开发环境与免编译脚本全家谱" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAlertBlueText}" Margin="0,0,0,4"/>
                <TextBlock Text="坚持「纯血原生、零第三方依赖」：深度解析 Windows Shell 族谱底层机制、CWD 地址栏秒开技巧与 ExecutionPolicy 环境治理，剖析 .bat / .ps1 变量与编码陷阱；提供 .bat / .ps1 / .reg / .hta 全套免编译原生脚本工程级实战与模板，全面构建纯粹扎实的 Windows 脚本开发能力。"
                           FontSize="12" Foreground="{DynamicResource BrushAlertBlueText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2 个聚焦子标签 (严格拆分：纯脚本与开发语言本身，所有命令调用工具均已归位步骤二/三) -->
        <TabControl Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                    ItemContainerStyle="{DynamicResource SubTabItemStyle}">

            <!-- Tab 1: 🐚 Shell 环境认知与脚本工程规范 -->
            <TabItem Header="🐚 Shell 环境认知与脚本工程规范">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- 第一块：Shell 家族族谱与原生真值表 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🌐 1. Windows Shell 家族族谱与原生真值表" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="{DynamicResource BrushAlertInfoBg}" BorderBrush="{DynamicResource BrushAlertInfoBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="💡 核心认知" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAlertInfoText}"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Text="Windows 体系下多种命令行工具与 Shell 宿主并存，以下为官方底层的代际脉络、原生属性与技术本质真值表："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- 4 大成员对照卡片矩阵 (2 列排布) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. CMD -->
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="⬛ cmd.exe (传统命令提示符)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="[✅ 系统原生]" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                            </Grid>
                                            <TextBlock Text="• 代际与基石：MS-DOS / Windows NT 诞生起原生内置，单线程纯字符流。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 依赖与性能：无任何 .NET 或外部 Runtime 依赖，启动毫秒级，极省内存。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 推荐定位：轻量秒级排障、简单环境测试、维护旧 .bat 批处理兼容。" FontSize="10" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Windows PowerShell 5.1 -->
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="🟦 powershell.exe (Windows PowerShell 5.1)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                <TextBlock Text="[✅ 系统原生]" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                            </Grid>
                                            <TextBlock Text="• 代际与基石：Win7 起系统预装，基于 .NET Framework 4.8 强类型对象管道。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 现状与特性：微软已正式在 5.1 封板（只出安全补丁），深度整合 WMI/注册表/服务。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 推荐定位：开箱即用的原生系统管理，无额外环境依赖的生产环境自动化。" FontSize="10" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 3. PowerShell 7+ (pwsh) -->
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="⚡ pwsh.exe (PowerShell 7+ 开源版)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                <TextBlock Text="[❌ 非系统原生]" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertErrorText}"/>
                                            </Grid>
                                            <TextBlock Text="• 代际与基石：基于现代跨平台 .NET 8/9 重写，支持 Win / Linux / macOS。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 优势与突破：启动与管道性能大幅飞跃，支持 ForEach-Object -Parallel 并发与现代语法。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 推荐定位：现代日常主力开发、跨平台 CI/CD 自动化（需 winget 自行安装）。" FontSize="10" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Windows Terminal (wt.exe) -->
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="🪟 Windows Terminal (wt.exe 终端宿主)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimary}"/>
                                                <TextBlock Text="[⚠️ 现代终端宿主]" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertWarningText}"/>
                                            </Grid>
                                            <TextBlock Text="• 本质澄清：它是终端宿主容器 (Host)，不是 Shell！负责托管运行 CMD、PS、WSL。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 优势与特性：DirectX GPU 硬件加速渲染、多标签、窗格分屏、富色彩与毛玻璃。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 状态：Win11 预装并设为默认终端；Win10 需从应用商店或 winget 获取。" FontSize="10" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 高效技巧：资源管理器地址栏直接启动终端 -->
                                <Border Background="{DynamicResource BrushAlertSuccessBg}" BorderBrush="{DynamicResource BrushAlertSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🚀 开发者高效技巧：资源管理器地址栏直接启动当前工作路径终端 (CWD Direct Launch)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAlertSuccessText}"/>
                                            <TextBlock Text="在 Windows 资源管理器任意文件夹中，按快捷键【Alt + D】或【Ctrl + L】聚焦地址栏，直接输入以下命令并回车，终端将秒级以当前文件夹作为工作路径启动，彻底免去手动输入漫长 cd 路径："
                                                       FontSize="10" Foreground="{DynamicResource BrushAlertSuccessText}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <WrapPanel>
                                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushAlertSuccessBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="cmd ➔ 快速秒开 CMD" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </Border>
                                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushAlertSuccessBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="powershell ➔ 秒开 Windows PowerShell" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushPrimary}"/>
                                                </Border>
                                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushAlertSuccessBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="wt ➔ 秒开多标签 Windows Terminal" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📂 打开程序目录实操 Alt+D" Background="#16A34A" Padding="10,6" VerticalAlignment="Center"
                                                Click="BtnOpenCwdTipExplorer_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 第二块：ExecutionPolicy 策略与环境治理 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 2. PowerShell 脚本执行策略 (ExecutionPolicy) 与环境治理" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="{DynamicResource BrushAlertWarningBg}" BorderBrush="{DynamicResource BrushAlertWarningBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ 避坑要点" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAlertWarningText}"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>

                                <!-- ExecutionPolicy 卡片 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔐 ExecutionPolicy（脚本执行策略）深度解析与一键配置" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TxtExecPolicyStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAlertWarningText}"/>
                                        </Grid>
                                        <TextBlock Text="• 权限认知误区：遇到【在此系统上禁止运行脚本】报错，绝非权限不够，而是触发了 Windows 默认的执行策略（安全护栏而非安全边界）。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 策略等级对比：Restricted (默认禁止运行所有脚本) | RemoteSigned (⭐最佳推荐：本地编写自由跑，网上下载需签名) | AllSigned (必须全签名) | Bypass (无视任何策略，仅供自动化临时传参)。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                        <TextBlock Text="• 为什么无需提权：使用 -Scope CurrentUser 仅修改当前用户配置，无需管理员身份即可生效，安全纯净无弹窗！"
                                                   FontSize="10" Foreground="{DynamicResource BrushSuccess}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔄 检测策略详情" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckExecPolicy_Click"/>
                                            <Button Grid.Column="1" Content="🛡️ 一键设为 RemoteSigned" Background="#0284C7" Margin="4,0,4,0" Click="BtnSetRemoteSigned_Click"/>
                                            <Button Grid.Column="2" Content="📋 复制单次免改策略调用命令" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                                    Click="BtnCopySnippet_Click" Tag="powershell.exe -ExecutionPolicy Bypass -File &quot;script.ps1&quot;"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 语法陷阱与编码陷阱 (左右双栏) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 语法陷阱 -->
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ 变量与退出码注意点 (.bat vs .ps1)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAlertErrorText}" Margin="0,0,0,4"/>
                                            <TextBlock Text="1. 变量提取机制：" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="• CMD 批处理：%VAR%（静态只读），循环内需 setlocal enabledelayedexpansion 并用 !VAR!。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• PowerShell：$env:VAR（读写系统环境变量），$var（内部脚本变量）。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="2. 退出码与错误中断：" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="• CMD：%ERRORLEVEL% 表示上一程序退出码 (0 为成功)。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• PowerShell：$LASTEXITCODE 表示外部程序退出码；$? 表示上一条 cmdlet 成功状态；遇错即停声明 $ErrorActionPreference = 'Stop'。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 编码陷阱 -->
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🔤 脚本编码规范（编码选择与乱码预防）" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAlertWarningText}" Margin="0,0,0,4"/>
                                            <TextBlock Text="1. CMD 批处理 (.bat) 编码法则：" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="• 中文 Windows CMD 默认代码页为 CP936 (GBK)。若保存为纯 UTF-8，中文注释极易导致语法解析截断！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 对策：保存为 ANSI / GBK 编码，或在首行声明 chcp 65001 >nul 强制切 UTF-8。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="2. PowerShell 5.1 (.ps1) 编码法则：" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="• PowerShell 5.1 默认编码要求带 BOM 的 UTF-8（UTF-8 with BOM）。保存为无 BOM 的纯 UTF-8 时，中文极易被吞乱码！" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 对策：在 VS Code 状态栏右下角切换为【UTF-8 with BOM】保存；PowerShell 7+ 则全面支持无 BOM 纯 UTF-8。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第三块：个人配置与现代演进 ($PROFILE) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 3. PowerShell $PROFILE 个人配置文件初始化" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="{DynamicResource BrushAlertSuccessBg}" BorderBrush="{DynamicResource BrushAlertSuccessBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ 效率工具" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAlertSuccessText}"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="📝 PowerShell $PROFILE 个人配置文件（规范化别名与函数配置）" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 作用机制：类似于 Linux 环境下的 ~/.bashrc 或 ~/.zshrc，每次启动 PowerShell 时自动载入执行。可配置常用高频别名 (如 gs -> git status)、终端网络代理快捷开关函数 (set-proxy / unset-proxy)、自定义端口查询函数等。"
                                                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📝 打开 PS 5.1 $PROFILE" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnOpenProfilePs5_Click"/>
                                            <Button Grid.Column="1" Content="📝 打开 pwsh 7 $PROFILE" Style="{DynamicResource SecondaryButton}" Margin="4,0,4,0" Click="BtnOpenProfilePwsh7_Click"/>
                                            <Button Grid.Column="2" Content="📋 复制推荐模板脚本" Background="#16A34A" Margin="4,0,0,0" Click="BtnCopyProfileTemplate_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 📝 原生免编译脚本开发全家谱 -->
            <TabItem Header="📝 原生免编译脚本开发全家谱">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- 板块 1: 认知地图——Windows 原生免编译全家谱总览表 -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <TextBlock Text="🗺️ 板块 1: 认知地图 —— Windows 原生免编译开发全家谱总览" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    <Border Background="{DynamicResource BrushAlertBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="底层执行引擎对照" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAlertBlueText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="Windows 体系无需安装任何编译工具链或外部 Runtime，靠内置解释器就能双击或命令行直接执行的一整套纯血文件格式："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- 全家谱表格矩阵 -->
                                <Border BorderBrush="{DynamicResource BrushTableBorder}" BorderThickness="1" CornerRadius="4">
                                    <Grid Background="{DynamicResource BrushCardBg}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
