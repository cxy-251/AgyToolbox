                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第四块：个人配置与现代演进 ($PROFILE / pwsh 7 / VBS 迁移) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 4. PowerShell $PROFILE 个人配置文件与现代演进" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ 效率神器" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>

                                <!-- 卡片 1: $PROFILE 个人别名与函数配置 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📝 PowerShell $PROFILE 个人配置文件（打造你的极速工作流）" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 作用机制：类似于 Linux 环境下的 ~/.bashrc 或 ~/.zshrc，每次启动 PowerShell 时自动载入执行。可配置常用高频别名 (如 gs -> git status)、终端网络代理一键开关函数 (set-proxy / unset-proxy)、自定义端口查询函数等。"
                                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📝 配置 PS 5.1 $PROFILE" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnOpenProfilePs5_Click"/>
                                            <Button Grid.Column="1" Content="📝 配置 pwsh 7 $PROFILE" Style="{DynamicResource SecondaryButton}" Margin="4,0,4,0" Click="BtnOpenProfilePwsh7_Click"/>
                                            <Button Grid.Column="2" Content="📋 复制推荐模板脚本" Background="#16A34A" Margin="4,0,0,0" Click="BtnCopyProfileTemplate_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2 与 卡片 3: pwsh 7 升级 与 VBS 迁移 (双栏排布) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- pwsh 7 升级 -->
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="⚡ 升级到 PowerShell 7+ (pwsh) 官方推荐命令" FontWeight="Bold" FontSize="12" Foreground="#7C3AED" Margin="0,0,0,4"/>
                                            <TextBlock Text="现代化开发建议将主力 Shell 升级至 pwsh 7：启动速度大幅提升，原生并发流水线，三元表达式等现代化语法，并与 Windows Terminal 深度集成："
                                                       FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <Grid>
                                                <TextBox Text="winget install --id Microsoft.PowerShell --source winget" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="winget install --id Microsoft.PowerShell --source winget"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- VBS 迁移 -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🔄 VBScript 静默启动迁移至现代 PowerShell" FontWeight="Bold" FontSize="12" Foreground="#B45309" Margin="0,0,0,4"/>
                                            <TextBlock Text="VBScript 即将被 Windows 彻底剥离，历史通过 WshShell.Run 静默运行程序的脚本，请全面迁移至 PowerShell 的 Start-Process："
                                                       FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <Grid>
                                                <TextBox Text="Start-Process -FilePath &quot;app.exe&quot; -ArgumentList &quot;--silent&quot; -WindowStyle Hidden" IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas" FontSize="10" Padding="4"/>
                                                <Button Content="📋" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="10"
                                                        Click="BtnCopySnippet_Click" Tag="Start-Process -FilePath &quot;app.exe&quot; -ArgumentList &quot;--silent&quot; -WindowStyle Hidden"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
