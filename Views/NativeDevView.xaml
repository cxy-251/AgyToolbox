                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🖥️ 案例 1: toolbox_dashboard.hta (原生运维工具箱集成控制面板)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整 HTA 源码" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="&lt;!DOCTYPE html&gt;&#x0d;&#x0a;&lt;html&gt;&#x0d;&#x0a;&lt;head&gt;&#x0d;&#x0a;  &lt;meta charset=&quot;UTF-8&quot;&gt;&#x0d;&#x0a;  &lt;title&gt;Windows 原生极简运维控制台&lt;/title&gt;&#x0d;&#x0a;  &lt;HTA:APPLICATION ID=&quot;oToolbox&quot; APPLICATIONNAME=&quot;AgyDashboard&quot; BORDER=&quot;thin&quot; SCROLL=&quot;no&quot; SINGLEINSTANCE=&quot;yes&quot; /&gt;&#x0d;&#x0a;  &lt;style&gt;&#x0d;&#x0a;    body { font-family: 'Segoe UI', sans-serif; background: #18181b; color: #f4f4f5; padding: 18px; margin: 0; }&#x0d;&#x0a;    h3 { margin: 0 0 10px 0; color: #38bdf8; font-size: 15px; }&#x0d;&#x0a;    .grid { display: flex; gap: 8px; margin-bottom: 12px; }&#x0d;&#x0a;    button { background: #2563eb; color: #fff; border: none; padding: 8px 14px; border-radius: 5px; cursor: pointer; font-size: 11px; }&#x0d;&#x0a;    button:hover { background: #1d4ed8; }&#x0d;&#x0a;    .danger { background: #dc2626; }&#x0d;&#x0a;    .danger:hover { background: #b91c1c; }&#x0d;&#x0a;    #console { background: #09090b; border: 1px solid #27272a; padding: 10px; border-radius: 5px; font-family: Consolas; font-size: 11px; height: 110px; overflow-y: auto; color: #a1a1aa; }&#x0d;&#x0a;  &lt;/style&gt;&#x0d;&#x0a;&lt;/head&gt;&#x0d;&#x0a;&lt;body&gt;&#x0d;&#x0a;  &lt;h3&gt;⚡ 原生免编译微型运维面板&lt;/h3&gt;&#x0d;&#x0a;  &lt;div class=&quot;grid&quot;&gt;&#x0d;&#x0a;    &lt;button onclick=&quot;execCmd('cmd.exe /c clean_temp.bat')&quot;&gt;🧹 清理临时文件&lt;/button&gt;&#x0d;&#x0a;    &lt;button onclick=&quot;execCmd('ipconfig /flushdns')&quot;&gt;🌐 刷新 DNS 缓存&lt;/button&gt;&#x0d;&#x0a;    &lt;button class=&quot;danger&quot; onclick=&quot;execCmd('taskkill /f /im node.exe')&quot;&gt;🛑 强杀失控 Node&lt;/button&gt;&#x0d;&#x0a;  &lt;/div&gt;&#x0d;&#x0a;  &lt;div id=&quot;console&quot;&gt;[系统就绪] 点击上方卡片触发后台命令调用...&lt;/div&gt;&#x0d;&#x0a;  &lt;script&gt;&#x0d;&#x0a;    window.resizeTo(500, 280);&#x0d;&#x0a;    function execCmd(cmd) {&#x0d;&#x0a;      try {&#x0d;&#x0a;        var wsh = new ActiveXObject('WScript.Shell');&#x0d;&#x0a;        wsh.Run(cmd, 0, false);&#x0d;&#x0a;        document.getElementById('console').innerHTML += '&lt;br&gt;&lt;span style=&quot;color:#4ade80&quot;&gt;[执行成功]&lt;/span&gt; ' + cmd;&#x0d;&#x0a;      } catch(e) {&#x0d;&#x0a;        document.getElementById('console').innerHTML += '&lt;br&gt;&lt;span style=&quot;color:#f87171&quot;&gt;[执行失败]&lt;/span&gt; ' + e.message;&#x0d;&#x0a;      }&#x0d;&#x0a;    }&#x0d;&#x0a;  &lt;/script&gt;&#x0d;&#x0a;&lt;/body&gt;&#x0d;&#x0a;&lt;/html&gt;"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：通过现代暗色 CSS 绘制控制台，点击卡片通过 WScript.Shell 静默拉起后台批处理或清理命令，并实时在前端文本框追加执行日志。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                 Text="&lt;HTA:APPLICATION ID=&quot;oApp&quot; APPLICATIONNAME=&quot;MiniTool&quot; /&gt;&#x0d;&#x0a;&lt;button onclick=&quot;exec('ipconfig /flushdns')&quot;&gt;刷新DNS&lt;/button&gt;&#x0d;&#x0a;&lt;script&gt;&#x0d;&#x0a;function exec(cmd) { (new ActiveXObject('WScript.Shell')).Run(cmd, 0, false); }&#x0d;&#x0a;&lt;/script&gt;"/>
                                    </StackPanel>
                                </Border>

                                <!-- 案例 2: 新机开荒交互式引导向导 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🧭 案例 2: setup_wizard.hta (新机开荒图形化安装配置引导向导)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整 HTA 源码" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="&lt;!DOCTYPE html&gt;&#x0d;&#x0a;&lt;html&gt;&#x0d;&#x0a;&lt;head&gt;&#x0d;&#x0a;  &lt;meta charset=&quot;UTF-8&quot;&gt;&#x0d;&#x0a;  &lt;title&gt;新电脑开荒一键安装引导&lt;/title&gt;&#x0d;&#x0a;  &lt;HTA:APPLICATION BORDER=&quot;dialog&quot; SCROLL=&quot;no&quot; /&gt;&#x0d;&#x0a;  &lt;style&gt;&#x0d;&#x0a;    body { font-family: 'Segoe UI', sans-serif; background: #0f172a; color: #e2e8f0; padding: 20px; }&#x0d;&#x0a;    .card { background: #1e293b; padding: 12px; border-radius: 6px; margin-bottom: 12px; font-size: 11px; }&#x0d;&#x0a;    label { display: block; margin-bottom: 6px; cursor: pointer; }&#x0d;&#x0a;    button { background: #10b981; color: #fff; border: none; padding: 10px; width: 100%; border-radius: 5px; cursor: pointer; font-weight: bold; }&#x0d;&#x0a;    button:hover { background: #059669; }&#x0d;&#x0a;  &lt;/style&gt;&#x0d;&#x0a;&lt;/head&gt;&#x0d;&#x0a;&lt;body&gt;&#x0d;&#x0a;  &lt;h3 style=&quot;margin-top:0;color:#38bdf8;&quot;&gt;🚀 Windows 开发者环境开箱向导&lt;/h3&gt;&#x0d;&#x0a;  &lt;div class=&quot;card&quot;&gt;&#x0d;&#x0a;    &lt;b&gt;请勾选需要一键安装与配置的模块:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x0d;&#x0a;    &lt;label&gt;&lt;input type=&quot;checkbox&quot; id=&quot;cGit&quot; checked&gt; Git 原生版本控制工具链&lt;/label&gt;&#x0d;&#x0a;    &lt;label&gt;&lt;input type=&quot;checkbox&quot; id=&quot;cNode&quot; checked&gt; Node.js 长期稳定版 (LTS)&lt;/label&gt;&#x0d;&#x0a;    &lt;label&gt;&lt;input type=&quot;checkbox&quot; id=&quot;cOpt&quot; checked&gt; 启用 NTFS 长路径与开发者模式&lt;/label&gt;&#x0d;&#x0a;  &lt;/div&gt;&#x0d;&#x0a;  &lt;button onclick=&quot;startDeploy()&quot;&gt;⚡ 开始一键自动化配置&lt;/button&gt;&#x0d;&#x0a;  &lt;script&gt;&#x0d;&#x0a;    window.resizeTo(460, 320);&#x0d;&#x0a;    function startDeploy() {&#x0d;&#x0a;      var git = document.getElementById('cGit').checked;&#x0d;&#x0a;      var node = document.getElementById('cNode').checked;&#x0d;&#x0a;      var opt = document.getElementById('cOpt').checked;&#x0d;&#x0a;      var args = (git ? ' -Git' : '') + (node ? ' -Node' : '') + (opt ? ' -Opt' : '');&#x0d;&#x0a;      var wsh = new ActiveXObject('WScript.Shell');&#x0d;&#x0a;      wsh.Run('powershell.exe -ExecutionPolicy Bypass -File .\\deploy.ps1' + args, 1, false);&#x0d;&#x0a;      window.close();&#x0d;&#x0a;    }&#x0d;&#x0a;  &lt;/script&gt;&#x0d;&#x0a;&lt;/body&gt;&#x0d;&#x0a;&lt;/html&gt;"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：通过复选框图形化勾选需要的技术栈（Git、Node、系统优化），点击后自动将选中的参数拼接传递给背后的 PowerShell 脚本执行，给小白用户提供媲美专业安装包的体验。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                                 Text="&lt;input type=&quot;checkbox&quot; id=&quot;c1&quot;&gt; 安装 Git&#x0d;&#x0a;&lt;button onclick=&quot;deploy()&quot;&gt;执行&lt;/button&gt;&#x0d;&#x0a;&lt;script&gt;&#x0d;&#x0a;function deploy() { (new ActiveXObject('WScript.Shell')).Run('powershell.exe -File deploy.ps1', 1, false); }&#x0d;&#x0a;&lt;/script&gt;"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 第二块：.vbs / .js / .wsf (WSH 历史定位与退场提醒) -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🛑 2. .vbs / .js / .wsf (Windows Script Host 历史定位与退场提醒)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushAlertErrorText}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushAlertErrorBg}" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="官方淘汰中" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAlertErrorText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Windows Script Host (wscript.exe / cscript.exe) 曾是 Windows 2000 / XP 时代的脚本基石，但在现代安全与系统演进中已被全面淘汰："
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border Background="{DynamicResource BrushAlertRedBg}" BorderBrush="{DynamicResource BrushAlertRedBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="• 历史辉煌与安全隐患：基于 COM 架构，虽能方便调用 ActiveXObject，但缺乏安全沙箱与现代类型约束，历史上成为 Office 宏病毒、勒索木马的高发媒介。&#x0a;• 微软官方退场路线图：Windows 11 24H2 起已正式将 VBScript 剥离为「按需可选功能 (Feature on Demand)」，并计划在未来主版本中彻底移除其运行解释器！&#x0a;• 现代化迁移指南：新项目严禁再使用 .vbs 或 .js(WSH) 编写；历史维护脚本建议尽快迁移重构为 PowerShell 脚本（调用 .NET API）或 .bat 批处理。"
                                                   FontSize="10" Foreground="{DynamicResource BrushAlertRedText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
