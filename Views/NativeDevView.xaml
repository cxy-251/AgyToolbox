                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🚀 案例 1: dev_launcher.bat (开发环境一键启动器)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="@echo off&#x0d;&#x0a;setlocal EnableExtensions&#x0d;&#x0a;title 项目本地开发环境一键编排启动&#x0d;&#x0a;cd /d &quot;%~dp0&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [1/4] 设置本地环境变量...&#x0d;&#x0a;set &quot;NODE_ENV=development&quot;&#x0d;&#x0a;set &quot;PORT=3000&quot;&#x0d;&#x0a;set &quot;API_BASE=http://localhost:8080&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [2/4] 检测并启动核心本地依赖服务...&#x0d;&#x0a;sc query &quot;Redis&quot; | findstr /i &quot;RUNNING&quot; >nul || net start &quot;Redis&quot; >nul 2>&amp;1&#x0d;&#x0a;&#x0d;&#x0a;echo [3/4] 独立窗口拉起后端与前端服务器...&#x0d;&#x0a;start &quot;Backend API&quot; cmd /c &quot;npm run dev:server&quot;&#x0d;&#x0a;start &quot;Frontend Web&quot; cmd /c &quot;npm run dev:client&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [4/4] 唤醒开发工具并打开浏览器看板...&#x0d;&#x0a;timeout /t 2 >nul&#x0d;&#x0a;start http://localhost:3000&#x0d;&#x0a;if exist &quot;%LOCALAPPDATA%\Programs\Microsoft VS Code\Code.exe&quot; (&#x0d;&#x0a;    start &quot;&quot; &quot;%LOCALAPPDATA%\Programs\Microsoft VS Code\Code.exe&quot; .&#x0d;&#x0a;)&#x0d;&#x0a;echo [SUCCESS] 全套开发环境已全部在后台并发拉起完毕！&#x0d;&#x0a;exit /b 0"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：设定项目环境变量、自动探测并拉起本地数据库/Redis 服务、独立窗口拉起前后端服务，并自动唤醒浏览器与 VS Code，一键顶替十几次手动点击。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                                 Text="@echo off&#x0d;&#x0a;setlocal EnableExtensions&#x0d;&#x0a;title 项目本地开发环境一键编排启动&#x0d;&#x0a;cd /d &quot;%~dp0&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [1/4] 设置本地环境变量...&#x0d;&#x0a;set &quot;NODE_ENV=development&quot;&#x0d;&#x0a;set &quot;PORT=3000&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo [2/4] 检测并启动核心本地依赖服务...&#x0d;&#x0a;sc query &quot;Redis&quot; | findstr /i &quot;RUNNING&quot; >nul || net start &quot;Redis&quot; >nul 2>&amp;1&#x0d;&#x0a;&#x0d;&#x0a;echo [3/4] 独立窗口拉起前后端服务并唤醒工具...&#x0d;&#x0a;start &quot;Backend&quot; cmd /c &quot;npm run dev:server&quot;&#x0d;&#x0a;start http://localhost:3000&#x0d;&#x0a;exit /b 0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 案例 2: 批量文件智能分类与按日期归档 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📂 案例 2: organize_files.bat (批量文件按类型与日期归档)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="@echo off&#x0d;&#x0a;setlocal EnableDelayedExpansion&#x0d;&#x0a;title 杂乱文件批量智能分类与归档工具&#x0d;&#x0a;cd /d &quot;%~dp0&quot;&#x0d;&#x0a;&#x0d;&#x0a;set &quot;TARGET_DIR=%~dp0Downloads&quot;&#x0d;&#x0a;if not exist &quot;!TARGET_DIR!&quot; set &quot;TARGET_DIR=%cd%&quot;&#x0d;&#x0a;&#x0d;&#x0a;set &quot;DATE_STR=%date:~0,4%-%date:~5,2%&quot;&#x0d;&#x0a;md &quot;!TARGET_DIR!\Docs_!DATE_STR!&quot; 2>nul&#x0d;&#x0a;md &quot;!TARGET_DIR!\Images_!DATE_STR!&quot; 2>nul&#x0d;&#x0a;md &quot;!TARGET_DIR!\Archives_!DATE_STR!&quot; 2>nul&#x0d;&#x0a;&#x0d;&#x0a;echo 正在分类归档文档文件 (*.pdf, *.docx, *.xlsx, *.md)...&#x0d;&#x0a;for %%e in (pdf docx xlsx md txt pptx) do (&#x0d;&#x0a;    move /y &quot;!TARGET_DIR!\*.%%e&quot; &quot;!TARGET_DIR!\Docs_!DATE_STR!\&quot; >nul 2>&amp;1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo 正在分类归档多媒体与图像 (*.png, *.jpg, *.svg)...&#x0d;&#x0a;for %%e in (png jpg jpeg gif svg webp) do (&#x0d;&#x0a;    move /y &quot;!TARGET_DIR!\*.%%e&quot; &quot;!TARGET_DIR!\Images_!DATE_STR!\&quot; >nul 2>&amp;1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo 正在分类归档压缩包与安装镜像 (*.zip, *.7z, *.tar)...&#x0d;&#x0a;for %%e in (zip 7z rar tar gz iso) do (&#x0d;&#x0a;    move /y &quot;!TARGET_DIR!\*.%%e&quot; &quot;!TARGET_DIR!\Archives_!DATE_STR!\&quot; >nul 2>&amp;1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo [SUCCESS] 批量整理完成！全部散乱文件已按类别归档到 !DATE_STR! 目录。&#x0d;&#x0a;exit /b 0"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：自动提取系统日期（如 2026-09），按扩展名模式批量将图片、文档、压缩包分流至不同分类子目录，实现无干扰自动整理。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                                 Text="@echo off&#x0d;&#x0a;setlocal EnableDelayedExpansion&#x0d;&#x0a;set &quot;DATE_STR=%date:~0,4%-%date:~5,2%&quot;&#x0d;&#x0a;md &quot;Docs_!DATE_STR!&quot; &quot;Images_!DATE_STR!&quot; 2>nul&#x0d;&#x0a;for %%e in (pdf docx xlsx md txt) do move /y &quot;*.%%e&quot; &quot;Docs_!DATE_STR!\&quot; >nul 2>&amp;1&#x0d;&#x0a;for %%e in (png jpg gif svg) do move /y &quot;*.%%e&quot; &quot;Images_!DATE_STR!\&quot; >nul 2>&amp;1&#x0d;&#x0a;echo 整理完成！"/>
                                    </StackPanel>
                                </Border>

                                <!-- 案例 3: 项目工程脚手架极速初始化 -->
                                <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🏗️ 案例 3: init_project.bat (项目脚手架与 Git 仓库初始化)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="@echo off&#x0d;&#x0a;setlocal EnableExtensions&#x0d;&#x0a;title 项目标准脚手架工程极速初始化&#x0d;&#x0a;&#x0d;&#x0a;set /p PROJ_NAME=&quot;请输入新项目工程名称 (如 MyApp): &quot;&#x0d;&#x0a;if &quot;%PROJ_NAME%&quot;==&quot;&quot; (&#x0d;&#x0a;    echo [ERROR] 项目名称不能为空！&#x0d;&#x0a;    exit /b 1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo 正在创建标准目录结构...&#x0d;&#x0a;md &quot;%PROJ_NAME%\src&quot; &quot;%PROJ_NAME%\bin&quot; &quot;%PROJ_NAME%\docs&quot; &quot;%PROJ_NAME%\tests&quot; &quot;%PROJ_NAME%\config&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo 正在生成标准 .gitignore 文件...&#x0d;&#x0a;(&#x0d;&#x0a;    echo # 编译与环境忽略清单&#x0d;&#x0a;    echo bin/&#x0d;&#x0a;    echo obj/&#x0d;&#x0a;    echo *.log&#x0d;&#x0a;    echo .vs/&#x0d;&#x0a;    echo node_modules/&#x0d;&#x0a;    echo .env.local&#x0d;&#x0a;) > &quot;%PROJ_NAME%\.gitignore&quot;&#x0d;&#x0a;&#x0d;&#x0a;echo 正在生成初始 README.md...&#x0d;&#x0a;(&#x0d;&#x0a;    echo # %PROJ_NAME%&#x0d;&#x0a;    echo.&#x0d;&#x0a;    echo 由 Windows 原生自动化批处理脚手架于 %date% 自动创建。&#x0d;&#x0a;) > &quot;%PROJ_NAME%\README.md&quot;&#x0d;&#x0a;&#x0d;&#x0a;where git >nul 2>&amp;1&#x0d;&#x0a;if %ERRORLEVEL% equ 0 (&#x0d;&#x0a;    cd &quot;%PROJ_NAME%&quot;&#x0d;&#x0a;    git init >nul&#x0d;&#x0a;    git add . >nul&#x0d;&#x0a;    git commit -m &quot;feat: initial commit from native scaffolding&quot; >nul&#x0d;&#x0a;    echo [SUCCESS] Git 仓库已就绪并完成首个初始化提交！&#x0d;&#x0a;)&#x0d;&#x0a;echo [SUCCESS] 项目 %PROJ_NAME% 创建完毕！&#x0d;&#x0a;exit /b 0"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：一键创建 src/bin/docs/tests 目录骨架，动态生成规范 .gitignore 与 README.md，自动触发 git init 首提提交。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                                 Text="@echo off&#x0d;&#x0a;set /p PROJ_NAME=&quot;请输入工程名称: &quot;&#x0d;&#x0a;md &quot;%PROJ_NAME%\src&quot; &quot;%PROJ_NAME%\bin&quot; &quot;%PROJ_NAME%\docs&quot;&#x0d;&#x0a;echo bin/ > &quot;%PROJ_NAME%\.gitignore&quot; &amp; echo *.log >> &quot;%PROJ_NAME%\.gitignore&quot;&#x0d;&#x0a;cd &quot;%PROJ_NAME%&quot; &amp; git init &amp; git add . &amp; git commit -m &quot;init&quot;"/>
                                    </StackPanel>
                                </Border>

