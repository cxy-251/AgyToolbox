                                <!-- ExecutionPolicy 卡片 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔐 ExecutionPolicy（脚本执行策略）深度解析与一键配置" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock x:Name="TxtExecPolicyStatus" Grid.Column="1" Text="[检测中...]" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                        </Grid>
                                        <TextBlock Text="• 权限认知误区：遇到【在此系统上禁止运行脚本】报错，绝非权限不够，而是触发了 Windows 默认的执行策略（安全护栏而非安全边界）。"
                                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 策略等级对比：Restricted (默认禁止运行所有脚本) | RemoteSigned (⭐最佳推荐：本地编写自由跑，网上下载需签名) | AllSigned (必须全签名) | Bypass (无视任何策略，仅供批处理自动化临时传参)。"
                                                   FontSize="10" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                        <TextBlock Text="• 为什么无需提权：使用 -Scope CurrentUser 仅修改当前用户配置，无需管理员身份即可生效，安全纯净无弹窗！"
                                                   FontSize="10" Foreground="#15803D" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔄 检测策略详情" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Click="BtnCheckExecPolicy_Click"/>
                                            <Button Grid.Column="1" Content="🛡️ 一键设为 RemoteSigned" Background="#0284C7" Margin="4,0,4,0" Click="BtnSetRemoteSigned_Click"/>
                                            <Button Grid.Column="2" Content="📋 复制单次免改策略调用命令" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0"
                                                    Click="BtnCopySnippet_Click" Tag="powershell.exe -ExecutionPolicy Bypass -File &quot;script.ps1&quot;"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 语法陷阱与编码陷阱 (左右双栏) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 语法陷阱 -->
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ 变量与退出码陷阱 (.bat vs .ps1)" FontWeight="Bold" FontSize="12" Foreground="#DC2626" Margin="0,0,0,4"/>
                                            
                                            <TextBlock Text="1. 变量提取机制：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                            <TextBlock Text="• CMD 批处理：%VAR%（静态只读），循环内需 setlocal enabledelayedexpansion 并用 !VAR!。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <TextBlock Text="• PowerShell：$env:VAR（读写系统环境变量），$var（内部脚本变量）。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            <TextBlock Text="2. 退出码与错误中断：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                            <TextBlock Text="• CMD：%ERRORLEVEL% 表示上一程序退出码 (0 为成功)。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <TextBlock Text="• PowerShell：$LASTEXITCODE 表示外部 .exe 退出码；$? 表示上一条 cmdlet 成功状态；遇错即停需首行声明 $ErrorActionPreference = 'Stop'。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 编码陷阱 -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🔤 脚本编码陷阱（中文乱码终结法则）" FontWeight="Bold" FontSize="12" Foreground="#D97706" Margin="0,0,0,4"/>
                                            
                                            <TextBlock Text="1. CMD 批处理 (.bat) 编码法则：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                            <TextBlock Text="• 中文 Windows CMD 默认代码页为 CP936 (GBK)。若保存为纯 UTF-8，中文注释极易导致语法解析截断！" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 对策：保存为 ANSI / GBK 编码，或在首行声明 chcp 65001 >nul 强制切 UTF-8。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            <TextBlock Text="2. PowerShell 5.1 (.ps1) 编码法则：" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                            <TextBlock Text="• PowerShell 5.1 默认编码要求带 BOM 的 UTF-8（UTF-8 with BOM）。保存为无 BOM 的纯 UTF-8 时，中文极易被吞乱码！" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 对策：在 VS Code 状态栏右下角切换为【UTF-8 with BOM】保存；PowerShell 7+ 则全面支持无 BOM 纯 UTF-8。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 第三块：CMD vs PowerShell 强类型对象级神级指令对照矩阵 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
