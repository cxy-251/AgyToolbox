                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📦 案例 4: local_deploy.bat (本地编译部署与旧版本备份)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Button Grid.Column="1" Content="📋 复制完整脚本" Style="{DynamicResource SecondaryButton}" FontSize="10" Padding="6,2"
                                                    Click="BtnCopySnippet_Click" Tag="@echo off&#x0d;&#x0a;setlocal EnableExtensions EnableDelayedExpansion&#x0d;&#x0a;title 本地编译产物部署与滚动备份&#x0d;&#x0a;cd /d &quot;%~dp0&quot;&#x0d;&#x0a;&#x0d;&#x0a;set &quot;APP_NAME=MyService&quot;&#x0d;&#x0a;set &quot;DEPLOY_DIR=C:\Apps\%APP_NAME%&quot;&#x0d;&#x0a;set &quot;BACKUP_ROOT=C:\Backups\%APP_NAME%&quot;&#x0d;&#x0a;set &quot;BUILD_DIST=%~dp0dist&quot;&#x0d;&#x0a;&#x0d;&#x0a;if not exist &quot;!BUILD_DIST!&quot; (&#x0d;&#x0a;    echo [ERROR] 构建产物目录 !BUILD_DIST! 不存在，请先执行打包编译！&#x0d;&#x0a;    exit /b 1&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo [1/4] 停止正在运行的目标进程...&#x0d;&#x0a;taskkill /f /im &quot;!APP_NAME!.exe&quot; >nul 2>&amp;1&#x0d;&#x0a;&#x0d;&#x0a;echo [2/4] 备份当前在线生产版本...&#x0d;&#x0a;set &quot;TIMESTAMP=%date:~0,4%%date:~5,2%%date:~8,2%_%time:~0,2%%time:~3,2%&quot;&#x0d;&#x0a;set &quot;TIMESTAMP=!TIMESTAMP: =0!&quot;&#x0d;&#x0a;if exist &quot;!DEPLOY_DIR!&quot; (&#x0d;&#x0a;    md &quot;!BACKUP_ROOT!\Backup_!TIMESTAMP!&quot; 2>nul&#x0d;&#x0a;    xcopy /e /i /y &quot;!DEPLOY_DIR!&quot; &quot;!BACKUP_ROOT!\Backup_!TIMESTAMP!\&quot; >nul&#x0d;&#x0a;)&#x0d;&#x0a;&#x0d;&#x0a;echo [3/4] 增量拷贝最新编译产物...&#x0d;&#x0a;md &quot;!DEPLOY_DIR!&quot; 2>nul&#x0d;&#x0a;xcopy /e /i /y &quot;!BUILD_DIST!&quot; &quot;!DEPLOY_DIR!\&quot; >nul&#x0d;&#x0a;&#x0d;&#x0a;echo [4/4] 重新拉起应用服务...&#x0d;&#x0a;start &quot;!APP_NAME!&quot; &quot;!DEPLOY_DIR!\!APP_NAME!.exe&quot;&#x0d;&#x0a;echo [SUCCESS] 部署完成！备份存档位于 !BACKUP_ROOT!\Backup_!TIMESTAMP!&#x0d;&#x0a;exit /b 0"/>
                                        </Grid>
                                        <TextBlock Text="场景价值：杀掉占用文件句柄的老进程、将旧版本带时间戳全量备份、覆盖最新构建产物并拉起服务，是经典轻量 CI/CD 落地典范。" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="{DynamicResource BrushCodeBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCodeBorder}" Padding="6" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                                 Text="@echo off&#x0d;&#x0a;taskkill /f /im &quot;MyService.exe&quot; 2>nul&#x0d;&#x0a;set &quot;TS=%date:~0,4%%date:~5,2%%date:~8,2%_%time:~0,2%%time:~3,2%&quot;&#x0d;&#x0a;xcopy /e /i /y &quot;C:\Apps\MyService&quot; &quot;C:\Backups\Backup_%TS%&quot; >nul&#x0d;&#x0a;xcopy /e /i /y &quot;dist&quot; &quot;C:\Apps\MyService\&quot; >nul&#x0d;&#x0a;start &quot;MyService&quot; &quot;C:\Apps\MyService\MyService.exe&quot;&#x0d;&#x0a;echo 部署完成！"/>
