<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 调色板初始默认资源 (浅色基准，运行时由 ThemeService 动态覆盖) ── -->
    <SolidColorBrush x:Key="BrushWindowBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushCardBgAlt" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushSidebarItemHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushSidebarItemSelected" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrushSidebarItemSelectedText" Color="#0284C7"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#94A3B8"/>

    <SolidColorBrush x:Key="BrushSubTabBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushSubTabSelectedBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSubTabHoverBg" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="BrushInputBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="BrushSecondaryBtnBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnHover" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnText" Color="#1E293B"/>

    <SolidColorBrush x:Key="BrushCodeBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushCodeBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushTableBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushTableHeaderBg" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="BrushPrimary" Color="#0078D4"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#16A34A"/>

    <!-- 语义警示与高亮背景 -->
    <SolidColorBrush x:Key="BrushAlertRedBg" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="BrushAlertRedBorder" Color="#FECACA"/>
    <SolidColorBrush x:Key="BrushAlertRedText" Color="#991B1B"/>

    <SolidColorBrush x:Key="BrushAlertBlueBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrushAlertBlueBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BrushAlertBlueText" Color="#1E40AF"/>

    <SolidColorBrush x:Key="BrushAlertYellowBg" Color="#FEFCE8"/>
    <SolidColorBrush x:Key="BrushAlertYellowBorder" Color="#FEF08A"/>
    <SolidColorBrush x:Key="BrushAlertYellowText" Color="#854D0E"/>

    <SolidColorBrush x:Key="BrushAlertGreenBg" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="BrushAlertGreenBorder" Color="#BBF7D0"/>
    <SolidColorBrush x:Key="BrushAlertGreenText" Color="#166534"/>

    <SolidColorBrush x:Key="BrushAlertPurpleBg" Color="#FAF5FF"/>
    <SolidColorBrush x:Key="BrushAlertPurpleBorder" Color="#E9D5FF"/>
    <SolidColorBrush x:Key="BrushAlertPurpleText" Color="#6B21A8"/>

    <!-- 语义警示别名与补全 (对齐旧版与不同子视图) -->
    <SolidColorBrush x:Key="BrushAlertInfoBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrushAlertInfoBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BrushAlertInfoText" Color="#1E40AF"/>

    <SolidColorBrush x:Key="BrushAlertWarningBg" Color="#FEFCE8"/>
    <SolidColorBrush x:Key="BrushAlertWarningBorder" Color="#FEF08A"/>
    <SolidColorBrush x:Key="BrushAlertWarningText" Color="#854D0E"/>

    <SolidColorBrush x:Key="BrushAlertSuccessBg" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="BrushAlertSuccessBorder" Color="#BBF7D0"/>
    <SolidColorBrush x:Key="BrushAlertSuccessText" Color="#166534"/>

    <SolidColorBrush x:Key="BrushAlertErrorBg" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="BrushAlertErrorBorder" Color="#FECACA"/>
    <SolidColorBrush x:Key="BrushAlertErrorText" Color="#991B1B"/>

    <!-- ── 现代化主按钮样式 ── -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#0078D4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#106EBE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 次要按钮样式 (响应动态主题) ── -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryBtnText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 通用横向子标签样式 (响应动态主题) ── -->
    <Style x:Key="SubTabItemStyle" TargetType="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="SubTabBorder" Background="{DynamicResource BrushSubTabBg}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter x:Name="SubContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SubTabBorder" Property="Background" Value="{DynamicResource BrushSubTabSelectedBg}"/>
                            <Setter Property="Foreground" Value="#0284C7"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SubTabBorder" Property="Background" Value="{DynamicResource BrushSubTabHoverBg}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SubTabBorder" Property="Background" Value="{DynamicResource BrushSubTabSelectedBg}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 全局默认控件暗黑/浅色自适应隐式样式 (彻底消灭白底黑字) ── -->
    <!-- 1. TextBlock: 默认主文本颜色 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <!-- 2. TextBox: 默认输入框背景、文字与边框 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushCodeBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCodeBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 3. CheckBox: 默认文字颜色 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 4. RadioButton: 默认文字颜色 -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 5. DataGrid 全套深浅色响应样式 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="RowBackground" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushTableHeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushSubTabHoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushSidebarItemSelected}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarItemSelectedText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushSidebarItemSelected}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarItemSelectedText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 6. ListBox 与 ListBoxItem -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- 7. ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>

    <!-- 8. TabControl 与 TabItem 默认隐式样式 -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource SubTabItemStyle}"/>

    <!-- 9. ToolTip 默认隐式样式 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- 10. ContextMenu 与 MenuItem 默认隐式样式 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>
</ResourceDictionary>
