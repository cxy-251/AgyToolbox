<Window x:Class="AgyToolbox.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AGY 全能便携工具箱" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI, Microsoft YaHei">

    <Window.Resources>
        <!-- 现代化扁平按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="AGY 全能便携工具箱" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" (Windows 原生 GUI / TUI 双模)" FontSize="12" Foreground="#94A3B8" Margin="10,4,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 核心选项卡内容 -->
        <TabControl Grid.Row="1" Margin="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">

            <!-- TAB 1: 局域网快传 (WebDrop) -->
            <TabItem Header="🚀 局域网快传 (WebDrop)">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 服务控制与状态栏 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtDropStatus" Text="● 服务未启动" FontSize="15" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text=" (手机与电脑连同 WiFi 即可互传文件)" FontSize="12" Foreground="#94A3B8" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtDropUrl" Text="点击启动服务即可生成手机扫码链接" FontSize="13" Foreground="#0284C7" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnToggleDrop" Content="启动快传服务" Width="120" Click="BtnToggleDrop_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenBrowser" Content="浏览器打开" Style="{StaticResource SecondaryButton}" Click="BtnOpenBrowser_Click" Margin="0,0,10,0" IsEnabled="False"/>
                                    <Button Content="接收文件夹" Style="{StaticResource SecondaryButton}" Click="BtnOpenReceived_Click" Margin="0,0,10,0"/>
                                    <Button Content="待共享文件夹" Style="{StaticResource SecondaryButton}" Click="BtnOpenShared_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 二维码扫码卡片 (启动后展示) -->
                        <Border x:Name="BorderQrCard" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" Padding="6" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <Image x:Name="ImgQrCode" Width="130" Height="130" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📱 手机扫码直达" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="使用微信、手机相机或手机浏览器【扫一扫】，即可在手机端直接传图/传文本/下载文件。"
                                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtQrTargetUrl" Text="-" FontSize="13" Foreground="#0284C7" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Content="📋 复制链接" Style="{StaticResource SecondaryButton}" Click="BtnCopyUrl_Click" Padding="10,5" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 动态接收日志 -->
                    <TextBlock Grid.Row="1" Text="实时收发动态记录：" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12">
                        <ListBox x:Name="ListDropLogs" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" FontFamily="Consolas, Courier New" FontSize="12"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 大文件极速猎手 (DiskHunter) -->
            <TabItem Header="🔍 大文件极速猎手 (DiskHunter)">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 路径选择与扫描按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="扫描目录:" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtScanPath" Grid.Column="1" VerticalAlignment="Center" Padding="8" FontSize="13" Margin="0,0,10,0"/>
                        <Button x:Name="BtnScanUserHome" Grid.Column="2" Content="用户主目录" Style="{StaticResource SecondaryButton}" Click="BtnScanUserHome_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnStartScan" Grid.Column="3" Content="⚡ 开始极速扫描" Click="BtnStartScan_Click" Width="140"/>
                    </Grid>

                    <!-- 扫描结果列表 -->
                    <DataGrid x:Name="GridDiskFiles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderBrush="#E2E8F0" RowHeight="28" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" SelectionMode="Single" MouseDoubleClick="GridDiskFiles_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="体积大小" Binding="{Binding SizeFormatted}" Width="100"/>
                            <DataGridTextColumn Header="修改时间" Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                            <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部提示与操作 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtScanStatus" Text="就绪" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,20,0"/>
                        <Button Content="在资源管理器中定位选中文件" Click="BtnLocateFile_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: 系统与网络诊断 (SysInfo) -->
            <TabItem Header="💻 系统与网络诊断 (SysInfo)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel Margin="10">
                        <!-- 刷新按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                            <Button Content="🔄 刷新状态与重新测速" Click="BtnRefreshSysInfo_Click"/>
                        </StackPanel>

                        <!-- 基础信息卡片 -->
                        <TextBlock Text="【基础信息】" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtMachineInfo" Text="计算机名: - | 操作系统: -" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtCpuUptime" Text="逻辑核心: - | 开机运行时长: -" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- 磁盘空间进度条列表 -->
                        <TextBlock Text="【磁盘空间占用】" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListDisks" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#0078D4"/>
                                                    <TextBlock Text="{Binding Label, StringFormat=' ({0})'}" Foreground="#64748B" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding UsedPercent, StringFormat='已用 {0:0.0}%'}" FontWeight="SemiBold"/>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                                <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" Foreground="#0078D4" Background="#E2E8F0" BorderThickness="0"/>
                                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B"
                                                           Text="{Binding UsedFormatted, StringFormat='已用: {0}'}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 活动网卡与网络延迟 -->
                        <TextBlock Text="【活动网络接口与公网延迟】" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <ItemsControl x:Name="ListNets" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,3" FontSize="13">
                                                <Run Text="🌐 网卡: " FontWeight="SemiBold"/>
                                                <Run Text="{Binding Name}"/>
                                                <Run Text=" | IPv4: " FontWeight="SemiBold"/>
                                                <Run Text="{Binding IPv4}" Foreground="#0078D4" FontWeight="Bold"/>
                                                <Run Text=" | 网关: "/>
                                                <Run Text="{Binding Gateway}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="#E2E8F0" Margin="0,6,0,10"/>
                                <ItemsControl x:Name="ListPings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,3" FontSize="13">
                                                <Run Text="⚡ 目标: "/>
                                                <Run Text="{Binding Target}" FontWeight="SemiBold"/>
                                                <Run Text=" -> "/>
                                                <Run Text="{Binding RoundtripMs, StringFormat='延迟: {0} ms'}" Foreground="#16A34A" FontWeight="Bold"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
