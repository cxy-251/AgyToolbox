                                                <TextBlock Text="• 大小:空 (0 KB 占位文件)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                                <TextBlock Text="• 大小:巨大 (>128 MB) / 大小:小 (10-100 KB)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                                <TextBlock Text="• 大小:100MB..500MB (区间匹配)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
