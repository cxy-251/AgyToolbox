<Window x:Class="AgyToolbox.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgyToolbox.Views"
        Title="AGY 全能便携工具箱" Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI, Microsoft YaHei">

    <Window.Resources>
        <!-- 现代化扁平按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 单行横向可滚动滑动的 TabControl 样式 -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 顶部单行横向滚动选项卡头部 -->
                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="6,6,6,0">
                                <ScrollViewer x:Name="TabHeaderScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel"
                                              Focusable="False">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </Border>
                            <!-- 主体内容区域 -->
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,0,8,8">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平现代化 TabItem 样式 -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="AGY 全能便携工具箱" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" (Windows 原生 GUI / TUI 双模)" FontSize="12" Foreground="#94A3B8" Margin="10,4,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 核心选项卡内容 (模块化 Views 分类) -->
        <TabControl Grid.Row="1" Margin="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">

            <!-- STEP 1: 🧹 步骤一：新机开荒与预装精简 (1. Debloat & Winget) -->
            <TabItem Header="🧹 1. 新机开荒与预装精简 (Debloat)">
                <views:DebloatView />
            </TabItem>

            <!-- STEP 2: ⚙️ 步骤二：系统优化与关更新 (2. Opt & Update) -->
            <TabItem Header="⚙️ 2. 系统优化与关更新 (Opt &amp; Update)">
                <views:SystemOptView />
            </TabItem>

            <!-- STEP 3: 📡 步骤三：跨设备局域网快传 (3. WebDrop) -->
            <TabItem Header="📡 3. 局域网快传 (WebDrop)">
                <views:WebDropView />
            </TabItem>

            <!-- STEP 4: 🔍 步骤四：大文件极速清理 (4. DiskHunter) -->
            <TabItem Header="🔍 4. 大文件极速猎手 (DiskHunter)">
                <views:DiskHunterView />
            </TabItem>

            <!-- STEP 5: 💻 步骤五：硬件体检与网卡透视 (5. SysInfo) -->
            <TabItem Header="💻 5. 硬件透视与体检 (SysInfo)">
                <views:SysInfoView />
            </TabItem>

            <!-- STEP 6: ⚡ 步骤六：系统内置隐藏神技 (6. WinTricks) -->
            <TabItem Header="⚡ 6. 搜索正则与绝活 (WinTricks)">
                <views:WinTricksView />
            </TabItem>

            <!-- STEP 7: 🌐 步骤七：DNS测速与镜像源 (7. Net & Mirrors) -->
            <TabItem Header="🌐 7. DNS 与国内镜像 (Net &amp; Mirrors)">
                <views:NetMirrorsView />
            </TabItem>

            <!-- STEP 8: 🛤️ 步骤八：路由跳与网络排查 (8. Route & CLI) -->
            <TabItem Header="🛤️ 8. 路由跳与网络诊断 (Route &amp; CLI)">
                <views:RouteCliView />
            </TabItem>

            <!-- STEP 9: 🛠️ 步骤九：开发者离线军刀 (9. DevTools) -->
            <TabItem Header="🛠️ 9. 开发者瑞士军刀 (DevTools)">
                <views:DevToolsView />
            </TabItem>

            <!-- STEP 10: 🚀 步骤十：极客快捷键一览 (10. CheatSheet) -->
            <TabItem Header="🚀 10. 隐藏神仙快捷键 (CheatSheet)">
                <views:CheatSheetView />
            </TabItem>

        </TabControl>
    </Grid>
</Window>
