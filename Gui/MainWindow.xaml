                                            <StackPanel>
                                                <TextBlock Text="📁 类型与扩展名筛选" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                <TextBlock Text="• 类型:文件夹 或 kind:folder" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                                <TextBlock Text="• 类型:图片 或 kind:pic (自动含 jpg/png/gif 等)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                                <TextBlock Text="• 类型:视频 或 kind:video / kind:music" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                                <TextBlock Text="• ext:.log 或 ext:.txt (精确按后缀匹配)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
