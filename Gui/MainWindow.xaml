            <!-- TAB 5: 🌐 DNS 解析与镜像源加速 (DNS & Mirrors) -->
            <TabItem Header="🌐 DNS 与镜像源 (Net &amp; Mirrors)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel Margin="10">

                        <!-- DNS 深度透视与一键测速 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ 公共 DNS 地址含义与一键实时延迟测速" FontSize="15" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text=" (帮你挑出当前网络最快的公共解析服务器)" FontSize="12" Foreground="#94A3B8" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <Button Content="⚡ 开始全网 DNS 实时测速" HorizontalAlignment="Right" Click="BtnTestDns_Click"/>
                                </Grid>

                                <DataGrid x:Name="GridDns" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="White" BorderBrush="#E2E8F0" RowHeight="32" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          MouseDoubleClick="GridDns_MouseDoubleClick"
                                          ToolTip="💡 点击任意列标题可升序/降序排序；双击任意行可直接复制该 DNS IP 到剪贴板">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DNS 提供商" Binding="{Binding Provider}" Width="140"/>
                                        <DataGridTextColumn Header="主服务器 IP" Binding="{Binding Ip}" Width="130"/>
                                        <DataGridTextColumn Header="往返延迟 (Ping)" Binding="{Binding LatencyDisplay}" Width="160"/>
                                        <DataGridTextColumn Header="权威定位与选型建议" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Steam/GitHub 改 DNS 原理解剖卡片 -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="💡 深度解密：为什么改 DNS 访问 Steam / GitHub 有时管用，有时不管用？" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                <TextBlock Text="很多教程说‘改 DNS 就能畅玩 Steam 社区 / 打开 GitHub’，这是不准确的。其底层分两个不同维度的封锁机制："
                                           FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="① 【为什么改 DNS 管用？针对 DNS 污染】" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBlock Text="国内部分运营商的本地 DNS（Local DNS）为了省流量或限制，故意将 github.com / steamcommunity.com 解析到了虚假 IP 或错误 IP。换用阿里 (223.5.5.5) 或 Google (8.8.8.8) 后拿到了真实的全球 Anycast IP，就能秒开。"
                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="② 【为什么有时改 DNS 依然卡死打不开？针对 SNI 握手阻断与 TCP 重置】" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBlock Text="HTTPS 访问在建立 TLS 连接时，客户端会发送一段明文的‘SNI (服务器名称指示)’。防火墙（GFW）检测到包含敏感域名时，直接向客户端和服务器两端发送伪造的 RST 报文断开连接。此时 DNS 解析再正确也没用，因为路在传输层被切断了！"
                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="👉 【正解解法】若仅为 DNS 污染，改公共 DNS 即可；若遭遇 SNI 阻断，需通过 Hosts 绑定可用 CDN 节点或使用反向代理工具（如 Watt Toolkit / Steam++）。"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 现代化开发镜像源速查 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="📦 常用开发镜像源现代标准配置 (告别 2022 年老旧配置)" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,12"/>

                                <!-- Conda 镜像 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="🐍 Anaconda / Miniconda 现代标准 .condarc" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="一键写入本地 .condarc" Style="{StaticResource SecondaryButton}" Click="BtnApplyCondarc_Click" Margin="0,0,8,0" Padding="8,4" FontSize="11"/>
                                                <Button Content="📋 复制配置文本" Style="{StaticResource SecondaryButton}" Click="BtnCopyCondarc_Click" Padding="8,4" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="【避坑警示】2022 年老教程里常用的 free 通道早已被清华/中科大下线归档，配了就会报 404；且旧配置用 http:// 明文传输易被劫持，必须全面升级为现代全 HTTPS 清华 TUNA 标准源。"
                                                   FontSize="12" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                        <TextBox Text="channels:&#x0a;  - https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main&#x0a;  - https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge&#x0a;show_channel_urls: true&#x0a;ssl_verify: true&#x0a;auto_activate_base: false"
                                                 IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas, Courier New" FontSize="11" Padding="6" BorderBrush="#E2E8F0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pip 镜像 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📦 Python Pip 现代一键换源命令 (清华 TUNA)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="【避坑警示】不要再去手动在 AppData 建立 pip.ini 了，官方支持一行命令永久配置全局源并信任域名。" FontSize="12" Foreground="#64748B" Margin="0,2,0,4"/>
                                            <TextBox x:Name="TxtPipCmd" Text="pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple"
                                                     IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas, Courier New" FontSize="12" Padding="6" BorderBrush="#E2E8F0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋 复制命令" Style="{StaticResource SecondaryButton}" Click="BtnCopyPip_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Npm 镜像 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🌐 Node.js Npm 最新官方国内镜像源" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="【严重避坑】2024 年 1 月淘宝旧域名 npm.taobao.org 证书已彻底过期废弃！使用老教程必定报错证书失效，请统一更新为 npmmirror 官方最新域名。" FontSize="12" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                            <TextBox x:Name="TxtNpmCmd" Text="npm config set registry https://registry.npmmirror.com"
                                                     IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas, Courier New" FontSize="12" Padding="6" BorderBrush="#E2E8F0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋 复制命令" Style="{StaticResource SecondaryButton}" Click="BtnCopyNpm_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- NuGet 镜像 -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔷 .NET NuGet 华为云加速镜像源" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="解决部分地区拉取 nuget.org 缓慢或超时的痛点，一行命令添加国内高速镜像源。" FontSize="12" Foreground="#64748B" Margin="0,2,0,4"/>
                                            <TextBox x:Name="TxtNugetCmd" Text="dotnet nuget add source https://repo.huaweicloud.com/repository/nuget/v3/index.json -n huaweicloud"
                                                     IsReadOnly="True" Background="#F8FAFC" FontFamily="Consolas, Courier New" FontSize="12" Padding="6" BorderBrush="#E2E8F0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋 复制命令" Style="{StaticResource SecondaryButton}" Click="BtnCopyNuget_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: 🧭 路由诊断、搜索语法与 CLI (Route & CLI) -->
            <TabItem Header="🧭 路由诊断、搜索语法与 CLI (Route &amp; CLI)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel Margin="10">

                        <!-- 第一部分：网络路由跳数与连通性实时诊断 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🌐 网络路由跳数追踪与链路诊断 (Route &amp; Trace)" FontSize="15" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                                <TextBlock Text="排查网络在哪个路由器节点中断、为什么高延迟、以及局域网物理设备发现。" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                                <!-- 控制区 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标主机 / IP：" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtRouteHost" Grid.Column="1" Text="1.1.1.1" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"/>
                                    
                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="⚡ tracert -d (极速路由跳数)" Margin="0,0,8,4" Click="BtnTracertFast_Click"/>
                                        <Button Content="📊 pathping (深度丢包诊断)" Margin="0,0,8,4" Click="BtnPathping_Click"/>
                                        <Button Content="🗺️ route print (本机路由表)" Margin="0,0,8,4" Click="BtnRoutePrint_Click"/>
                                        <Button Content="🔎 arp -a (局域网设备映射)" Margin="0,0,8,4" Click="BtnArp_Click"/>
                                        <Button x:Name="BtnStopDiag" Content="⏹️ 停止" Background="#EF4444" Margin="0,0,8,4" Click="BtnStopDiag_Click" IsEnabled="False"/>
                                        <Button Content="🧹 清空输出" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Click="BtnClearDiagLog_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <!-- 实时黑色控制台输出框 -->
                                <TextBox x:Name="TxtDiagConsole" Height="220" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                         Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas, Courier New" FontSize="12"
                                         Padding="10" TextWrapping="Wrap"
                                         Text="[网络诊断控制台已就绪] 请输入目标主机（如 1.1.1.1、baidu.com、github.com），并点击上方诊断命令开始执行...&#x0a;"/>

                                <!-- 路由原理解密卡片 -->
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 路由跳数（Hop）底层原理透视：" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,4"/>
                                        <TextBlock Text="• TTL 机制：tracert 发送 IP 报文，TTL 从 1 开始递增。第一台路由器将 TTL 减为 0 后抛弃报文并返回 ICMP 超时，源端由此获取该跳路由器的 IP；依次类推测出整条链路。" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 为什么加 -d 速度快 10 倍？默认 tracert 会对每个中间 IP 做反向 DNS 解析（查运营商域名），极其耗时。加 -d（不解析主机名）直接输出数字 IP，几秒跑完！" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="• 为什么中间会有【* * * 请求超时】？部分骨干网防火墙为了防扫描禁止回显 ICMP 超时包，只要最后一跳通，说明中间超时并不影响链路通信。" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 第二部分：Windows 搜索 AQS 高级语法与正则规律速查 -->
