<Window x:Class="AgyToolbox.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 新机开荒与原生开发工具箱 (GUI / TUI 双模)" Height="760" Width="1140" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" FontFamily="Segoe UI, Microsoft YaHei">

    <Window.Resources>
        <!-- 现代化扁平主按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PowerToys 风格侧边栏导航单选框样式 -->
        <Style x:Key="PowerToysNavItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧 PowerToys 风格导航轨 -->
            <ColumnDefinition Width="250"/>
            <!-- 右侧功能主展区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧 Sidebar -->
        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 侧边栏顶部品牌 -->
                <Border Grid.Row="0" Padding="18,16,18,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="开荒与原生开发" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="从出厂精简到现代原生工作流" FontSize="11" Foreground="#64748B" Margin="26,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 导航项列表 (5 个核心阶段) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,12,10,10">
                    <StackPanel>
                        <TextBlock Text="新手开荒递进流程" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,8"/>

                        <!-- 阶段一 -->
                        <RadioButton x:Name="NavDebloat" GroupName="MainFlow" IsChecked="True"
                                     Style="{StaticResource PowerToysNavItemStyle}" Click="Nav_Click">
                            <StackPanel>
                                <TextBlock Text="🧹 步骤一：开荒与预装精简" FontSize="13"/>
                                <TextBlock Text="UWP全家桶 / OEM毒瘤 / 关静默推广" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 阶段二 -->
                        <RadioButton x:Name="NavOpt" GroupName="MainFlow"
                                     Style="{StaticResource PowerToysNavItemStyle}" Click="Nav_Click">
                            <StackPanel>
                                <TextBlock Text="⚙️ 步骤二：系统优化与安全" FontSize="13"/>
                                <TextBlock Text="关更新 / BitLocker避坑 / 关休眠省32G" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 阶段三 -->
                        <RadioButton x:Name="NavBuiltIn" GroupName="MainFlow"
                                     Style="{StaticResource PowerToysNavItemStyle}" Click="Nav_Click">
                            <StackPanel>
                                <TextBlock Text="📖 步骤三：自带工具排错指南" FontSize="13"/>
                                <TextBlock Text="闪退蓝屏破案 / 协议栈复位 / WinSxS瘦身" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 阶段四 -->
                        <RadioButton x:Name="NavNativeDev" GroupName="MainFlow"
                                     Style="{StaticResource PowerToysNavItemStyle}" Click="Nav_Click">
                            <StackPanel>
                                <TextBlock Text="💻 步骤四：原生开发与终端基建" FontSize="13"/>
                                <TextBlock Text="WSL2 / 官方沙箱 / SSH-Agent / CLI" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Separator Margin="6,10,6,10" Background="#E2E8F0"/>
                        <TextBlock Text="独立便携套件" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,8"/>

                        <!-- 便携工具箱 -->
                        <RadioButton x:Name="NavToolbox" GroupName="MainFlow"
                                     Style="{StaticResource PowerToysNavItemStyle}" Click="Nav_Click">
                            <StackPanel>
                                <TextBlock Text="🧰 便携工具箱：内置独立套件" FontSize="13"/>
                                <TextBlock Text="局域网快传 / 猎手 / 硬件 / 军刀 / 镜像" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部元信息 -->
                <Border Grid.Row="2" Background="#F1F5F9" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="AgyToolbox · Windows 极客开荒体系" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Text="纯原生 C# / .NET 8 / 零第三方框架依赖" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧主体内容容器 -->
        <Border Grid.Column="1" Background="White">
            <ContentControl x:Name="MainContentHost" />
        </Border>
    </Grid>
</Window>
